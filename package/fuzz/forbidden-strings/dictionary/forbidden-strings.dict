# libFuzzer dictionary for forbidden-strings fuzz targets.
# Format: one entry per line as `name="value"` or just `"value"`.
# Only THREE escape sequences are accepted inside the quotes:
#   - `\\`     -> single backslash byte
#   - `\"`     -> double-quote byte
#   - `\xHH`   -> hex byte
# To emit a literal `\b` (regex word-boundary, two bytes 0x5C 0x62),
# write `"\\b"` -- libFuzzer's parser sees `\\` -> `\`, then `b`.
# The tokens here cover parser branches the bug class behind
# e49d8694 / e100659f / 9b41fca0 / 1463c59b exercised.

# Inline flags
"/"
"//i"
"(?i)"
"(?u)"
"(?iu)"
"(?-i)"
"(?i:"
"(?x:"
"(?u:"

# Groups (capturing / non-capturing / named / lookaround)
"("
")"
"(?:"
"(?="
"(?!"
"(?<="
"(?<!"
"(?P<"
"(?<name>"
"(?#"

# Character classes
"["
"]"
"[^"
"[_]"
"[A-Z]"
"[a-z]"
"[0-9]"

# Anchors and shorthands (regex `\X` sequences encoded as `\\X` for libFuzzer)
"\\b"
"\\B"
"\\s"
"\\S"
"\\w"
"\\W"
"\\d"
"\\D"
"\\A"
"\\z"
"^"
"$"

# Resharp algebra
"&"
"~("
"~["
"(A&B)|C"
"A&(B|C)"

# Wildcard underscore triad
"_"
"\\_"

# Quantifiers and metacharacters
"*"
"+"
"?"
"|"
"{0,50}"
"{1,3}"
"{0}"
"."

# Content fixtures (multi-byte / boundary-relevant)
"\xc2\xa0"
"\xe2\x80\x94"
"\xe2\x80\x9c"
"\xe2\x80\x9d"
"\xe2\x80\x98"
"\xe2\x80\x99"
"\xe2\x80\x83"
"\xe3\x80\x80"
"\x00"

# Common rule-source motifs from test corpus
"\xe2\x80\x94password"
"\xe2\x80\x94token"
"(?i)\xe2\x80\x94Password"
"(?:\xe2\x80\x94password|\xe2\x80\x94token)"
"(?<=foo)bar"
"foo(?=x)bar"
"required\\_(?x:foo bar)"
"pre_post"
"literalA(?i)keyword-suffix"
"cohere"
"CO_API_KEY"
"\xc3\xa9tudiant"
"caf\xc3\xa9secret"
