// Transient in-file find. Native code owns match positions and identity; this markup only edits the find text.
import { LineEdit, Palette } from "std-widgets.slint";

// Prototype find-buttons B: a 48px pointer button drawn with a vector glyph, because system fonts are isolated.
// It never takes keyboard focus, so a click leaves the caret in the find text.
// States use two channels each: idle has a faint boundary; hover adds a fill and full-ink boundary;
// press adds a heavier fill and a 2px boundary; disabled drops the boundary and dims the glyph.
component FindButton inherits Rectangle {
    in property <string> label;
    in property <string> glyph-commands;
    in property <bool> enabled: true;
    callback clicked;
    min-width: 48px;
    max-width: 48px;
    min-height: 48px;
    max-height: 48px;
    border-radius: 4px;
    background: !root.enabled ? transparent
        : (touch.pressed ? Palette.foreground.with-alpha(0.16) : (touch.has-hover ? Palette.foreground.with-alpha(0.08) : transparent));
    border-width: !root.enabled ? 0px : (touch.pressed ? 2px : 1px);
    border-color: Palette.foreground.with-alpha(touch.has-hover || touch.pressed ? 1 : 0.3);
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }

    Path {
        width: 16px;
        height: 16px;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: root.glyph-commands;
        stroke: Palette.foreground;
        stroke-width: 1.5px;
        opacity: root.enabled ? 1 : 0.38;
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

export component FindBar inherits Rectangle {
    in property <bool> open;
    in property <string> status;
    in property <string> status-detail;
    in property <bool> no-match;
    in property <string> error-message;
    in-out property <string> query;
    out property <bool> query-has-focus: input.has-focus;
    // The owner sets this height only while open, so a closed bar reserves no space.
    out property <length> bar-height: root.row-height + (root.error-message == "" ? 0px : error.preferred-height + 8px);
    callback edited(string);
    callback navigate(int);
    callback dismiss;
    callback shortcut(string, bool, bool, bool);
    // Previous and next act only while the find text has matches to move between.
    private property <bool> can-navigate: root.query != "" && !root.no-match && root.error-message == "";
    public function focus-query() {
        input.focus();
        input.select-all();
    }
    private property <length> row-height: 56px;
    background: Palette.background;
    clip: true;
    accessible-role: search;
    accessible-label: "Find in file";
    forward-focus: input;

    Rectangle {
        y: 0px;
        width: parent.width;
        height: 1px;
        background: Palette.foreground;
        opacity: 0.2;
    }

    // Capture match navigation before the single-line input consumes Return.
    FocusScope {
        width: parent.width;
        height: parent.height;
        // Only the find input is a focus stop; this scope observes its keys and must not hold focus itself.
        focus-on-tab-navigation: false;
        focus-on-click: false;
        capture-key-pressed(event) => {
            if event.text == Key.Return {
                root.navigate(event.modifiers.shift ? -1 : 1);
                return accept;
            }
            // Recent-file shortcuts keep working while the find text has focus; native code decodes the key.
            if event.modifiers.control {
                root.shortcut(event.text, event.modifiers.control, event.modifiers.shift, event.modifiers.alt);
            }
            reject
        }
        HorizontalLayout {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: root.row-height;
            padding: 4px;
            padding-left: 12px;
            padding-right: 12px;
            spacing: 12px;
            input := LineEdit {
                enabled: root.open;
                min-width: 48px;
                min-height: 48px;
                max-height: 48px;
                horizontal-stretch: 1;
                text <=> root.query;
                placeholder-text: "Find in file";
                accessible-label: "Find text";
                accessible-description: root.status-detail;
                edited(text) => { root.edited(text); }
            }
            Text {
                horizontal-stretch: 0;
                text: root.status;
                color: Palette.foreground;
                font-weight: root.no-match ? 600 : 400;
                vertical-alignment: center;
                horizontal-alignment: right;
                accessible-role: text;
                accessible-label: root.status-detail;
            }
            // Browser find bars put previous, next, and close after the match count, in this order.
            HorizontalLayout {
                horizontal-stretch: 0;
                spacing: 4px;
                FindButton {
                    label: "Previous match";
                    glyph-commands: "M 4 10 L 8 6 L 12 10";
                    enabled: root.can-navigate;
                    clicked => { root.navigate(-1); }
                }
                FindButton {
                    label: "Next match";
                    glyph-commands: "M 4 6 L 8 10 L 12 6";
                    enabled: root.can-navigate;
                    clicked => { root.navigate(1); }
                }
                FindButton {
                    label: "Close find";
                    glyph-commands: "M 4 4 L 12 12 M 12 4 L 4 12";
                    clicked => { root.dismiss(); }
                }
            }
        }
        error := Text {
            visible: root.error-message != "";
            x: 12px;
            y: root.row-height;
            width: parent.width - 24px;
            text: root.error-message;
            color: Palette.foreground;
            font-weight: 600;
            wrap: word-wrap;
        }
    }
}
