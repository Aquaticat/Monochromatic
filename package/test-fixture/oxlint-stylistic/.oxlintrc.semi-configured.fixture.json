{
  "$schema": "../../../node_modules/oxlint/configuration_schema.json",
  // Dedicated config proving stylistic/semi does not accept eslint.style-style options.
  "jsPlugins": [
    "../../oxlint-plugin/stylistic/dist/final/node/index.mjs"
  ],
  "ignorePatterns": [
    "**/dist",
    "**/node_modules"
  ],
  "rules": {
    "stylistic/semi": [
      "error",
      "always"
    ]
  }
}
