{
  "extends": "./tsconfig.types.json",
  "include": [
    "src/**/*.ts",
    "src/**/*.mjs",
    "src/**/*.astro",
    "src/**/*.mdx",
    "*.config.ts",
    ".astro/types.d.ts",
    "native/**/*.ts",
    "native/**/*.mjs"
  ],
  "compilerOptions": {
    "allowJs": true,
    "isolatedDeclarations": false,
    "composite": false,
    "incremental": true,
  },
}
