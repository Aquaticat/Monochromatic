// THROWAWAY, NONFUNCTIONAL DESIGN STUDY. None of these scenes implements a hotkey,
// a second operating-system window, a search index, keyboard navigation or playback.
// Independent questions: study-mode 1 = in-app placement (variant 1..3);
// study-mode 2 = global invocation relationship (variant 1..2);
// study-mode 3 = future-search surface relationship (variant 1..2).
// study-mode 4 shows no-results / unavailable-action stress states.
// Colors are measured wallpaper-role references, not an accepted desktop color map.

component ResultRow inherits Rectangle {
    in property <bool> dark;
    in property <bool> chosen: false;
    in property <bool> unavailable: false;
    in property <bool> stress: false;
    in property <string> label;
    in property <string> detail;
    in property <string> tail;
    height: root.stress ? 88px : 58px;
    background: root.chosen ? (root.dark ? #465174 : #afc0f4) : #00000000;
    border-radius: 6px;
    if root.chosen: Rectangle {
        x: 0px; y: 7px; width: 3px; height: parent.height - 14px;
        background: root.dark ? #bac5ee : #4e5e8b;
    }
    Text {
        x: 14px; y: 6px;
        width: parent.width - (root.stress ? 116px : 128px);
        height: root.stress ? 52px : 28px;
        text: root.label;
        color: root.unavailable ? (root.dark ? #a9aab5 : #5d5f68) : (root.dark ? #e4e5f0 : #30323b);
        font-size: root.stress ? 20px : 15px;
        font-weight: root.chosen ? 600 : 400;
        wrap: root.stress ? word-wrap : no-wrap;
        overflow: elide;
    }
    Text {
        x: 14px; y: root.stress ? 62px : 34px;
        width: parent.width - 128px;
        height: 20px;
        text: root.detail;
        color: root.chosen ? (root.dark ? #e4e5f0 : #30323b) : (root.dark ? #a9aab5 : #5d5f68);
        font-size: root.stress ? 14px : 12px;
        overflow: elide;
    }
    Text {
        x: parent.width - 108px; y: 16px;
        width: 96px; height: 24px;
        text: root.tail;
        color: root.chosen ? (root.dark ? #e4e5f0 : #30323b) : (root.dark ? #a9aab5 : #5d5f68);
        font-size: 12px;
        horizontal-alignment: right;
        overflow: elide;
    }
}

component PlayerBackdrop inherits Rectangle {
    in property <bool> dark;
    in property <bool> compact;
    background: root.dark ? #000000 : #ffffff;
    border-width: 1px;
    border-color: root.dark ? #464850 : #b0b1bc;
    clip: true;
    Rectangle {
        width: parent.width; height: 34px;
        background: root.dark ? #121318 : #f4f3fa;
        Text { x: 16px; y: 7px; text: "Music Player"; font-size: 14px; font-weight: 600; color: root.dark ? #e4e5f0 : #30323b; }
        Text { x: parent.width - 64px; y: 7px; text: "—  ×"; font-size: 14px; color: root.dark ? #a9aab5 : #5d5f68; }
    }
    Rectangle {
        y: 34px; width: parent.width; height: 58px;
        background: root.dark ? #000000 : #ffffff;
        border-width: 1px; border-color: root.dark ? #464850 : #b0b1bc;
        Text { x: 18px; y: 17px; text: "Camellia ▾"; font-size: 16px; font-weight: 600; color: root.dark ? #e4e5f0 : #30323b; }
        Rectangle {
            x: parent.width - 116px; y: 8px; width: 100px; height: 42px;
            border-radius: 20px;
            background: root.dark ? #303a54 : #e1e6f7;
            Text { x: 16px; y: 11px; text: "▣  Open"; font-size: 14px; color: root.dark ? #bac5ee : #4e5e8b; }
        }
    }
    Rectangle {
        y: 92px; width: root.compact ? parent.width : 330px;
        height: root.compact ? 150px : parent.height - 92px;
        background: root.dark ? #000000 : #ffffff;
        Text { x: 20px; y: 14px; text: "Another Xronixle"; font-size: 16px; font-weight: 600; color: root.dark ? #e4e5f0 : #30323b; }
        Text { x: 20px; y: 41px; text: "1 of 16 · −1.2 dBTP"; font-size: 12px; color: root.dark ? #a9aab5 : #5d5f68; }
        Rectangle { x: 20px; y: 78px; width: parent.width - 40px; height: 3px; background: root.dark ? #464850 : #b0b1bc; }
        Rectangle { x: 20px; y: 78px; width: (parent.width - 40px) * 0.24; height: 3px; background: root.dark ? #bac5ee : #4e5e8b; }
        Text { x: 20px; y: 98px; text: "◁       ▌▌       ▷"; font-size: 18px; color: root.dark ? #e4e5f0 : #30323b; }
    }
    Rectangle {
        x: root.compact ? 0px : 330px;
        y: root.compact ? 242px : 92px;
        width: root.compact ? parent.width : parent.width - 330px;
        height: root.compact ? parent.height - 242px : parent.height - 92px;
        background: root.dark ? #000000 : #ffffff;
        border-width: 1px; border-color: root.dark ? #464850 : #b0b1bc;
        Text { x: 16px; y: 18px; text: "Tracks in Camellia"; font-size: 13px; color: root.dark ? #a9aab5 : #5d5f68; }
        Rectangle {
            x: 12px; y: 54px; width: parent.width - 24px; height: 58px;
            background: root.dark ? #121318 : #f4f3fa;
            Text { x: 14px; y: 18px; text: "Another Xronixle"; font-size: 15px; font-weight: 600; color: root.dark ? #e4e5f0 : #30323b; }
        }
        Text { x: 26px; y: 130px; text: "Burning Aquamarine"; font-size: 15px; color: root.dark ? #e4e5f0 : #30323b; }
        Text { x: 26px; y: 186px; text: "Dokuhebi"; font-size: 15px; color: root.dark ? #e4e5f0 : #30323b; }
    }
}

component OtherApp inherits Rectangle {
    in property <bool> dark;
    background: root.dark ? #10151a : #f0f3f6;
    Text { x: 16px; y: 13px; text: "Notes · another app has focus"; font-size: 16px; font-weight: 600; color: root.dark ? #e4e5f0 : #30323b; }
    Rectangle { x: 16px; y: 58px; width: parent.width - 32px; height: 1px; background: root.dark ? #464850 : #b0b1bc; }
    Text { x: 24px; y: 85px; text: "Working notes"; font-size: 20px; font-weight: 600; color: root.dark ? #e4e5f0 : #30323b; }
    Text { x: 24px; y: 130px; text: "A thought about the next album…"; font-size: 14px; color: root.dark ? #a9aab5 : #5d5f68; }
    Text { x: 24px; y: 494px; text: "The previous app remains here when the quick surface closes."; font-size: 12px; color: root.dark ? #a9aab5 : #5d5f68; }
}

component CommandPanel inherits Rectangle {
    in property <bool> dark;
    in property <bool> stress: false;
    in property <int> kind: 1; // 1 action command, 2 dedicated search, 3 shared search mode, 4 empty, 5 unavailable
    in property <bool> detached: false;
    background: root.dark ? #1e1f26 : #e7e7f1;
    border-width: 1px; border-color: root.dark ? #464850 : #b0b1bc;
    border-radius: root.detached ? 16px : 8px;
    clip: true;
    if root.detached: Text {
        x: 16px; y: 9px; text: "Music Player · command bar";
        font-size: 12px; color: root.dark ? #a9aab5 : #5d5f68;
    }
    if root.kind == 3: Text {
        x: 18px; y: root.detached ? 33px : 9px;
        text: "←  SEARCH MODE     ·     Actions stay available as a separate mode";
        font-size: 12px; color: root.dark ? #a9aab5 : #5d5f68;
        overflow: elide; width: parent.width - 36px;
    }
    Rectangle {
        x: 12px; y: root.detached ? 36px : (root.kind == 3 ? 30px : 12px);
        width: parent.width - 24px; height: 56px;
        background: root.dark ? #121318 : #ffffff;
        border-width: 1px; border-color: root.dark ? #bac5ee : #4e5e8b;
        border-radius: 8px;
        Text {
            x: 16px; y: 14px; width: parent.width - 76px; height: 28px;
            text: root.kind == 4 ? ">  zzq│" : (root.kind == 5 ? ">  scan│" : (root.kind == 1 ? ">  open│" : "⌕  cam│"));
            font-size: root.stress ? 20px : 16px;
            color: root.dark ? #e4e5f0 : #30323b;
            overflow: elide;
        }
        Text { x: parent.width - 52px; y: 17px; text: "Esc"; font-size: 12px; color: root.dark ? #a9aab5 : #5d5f68; }
    }
    if root.kind == 1: Rectangle {
        x: 12px; y: root.detached ? 112px : 88px;
        width: parent.width - 24px; height: parent.height - 148px;
        Text { x: 10px; y: 0px; text: "ACTIONS MATCHING ‘OPEN’"; font-size: 12px; color: root.dark ? #a9aab5 : #5d5f68; }
        ResultRow { x: 0px; y: 23px; width: parent.width; dark: root.dark; chosen: true; stress: root.stress; label: "Open folder picker"; detail: "Shows the D31 folder selector"; tail: "Ctrl+O"; }
        ResultRow { x: 0px; y: root.stress ? 113px : 83px; width: parent.width; dark: root.dark; stress: root.stress; label: root.stress ? "Open system music library settings" : "Open settings"; detail: "Opens player settings"; tail: ""; }
        if !root.stress: ResultRow { x: 0px; y: 143px; width: parent.width; dark: root.dark; label: "Open system music library"; detail: "Navigates to the system library"; tail: ""; }
    }
    if root.kind == 2 || root.kind == 3: Rectangle {
        x: 12px; y: root.kind == 3 ? 106px : 88px;
        width: parent.width - 24px; height: parent.height - 146px;
        Text { x: 10px; y: 0px; text: "ILLUSTRATIVE MUSIC RESULTS FOR ‘CAM’"; font-size: 12px; color: root.dark ? #a9aab5 : #5d5f68; }
        ResultRow { x: 0px; y: 23px; width: parent.width; dark: root.dark; chosen: true; label: "Camellia"; detail: "Folder · opens this folder"; tail: "Folder"; }
        ResultRow { x: 0px; y: 83px; width: parent.width; dark: root.dark; label: "Another Xronixle"; detail: "Track · Camellia · reveals track"; tail: "Track"; }
    }
    if root.kind == 4: Rectangle {
        x: 24px; y: 110px; width: parent.width - 48px;
        Text { text: "No matching actions"; font-size: 17px; font-weight: 600; color: root.dark ? #e4e5f0 : #30323b; }
        Text { y: 35px; text: "Try a shorter action name."; font-size: 14px; color: root.dark ? #a9aab5 : #5d5f68; }
    }
    if root.kind == 5: Rectangle {
        x: 12px; y: 88px; width: parent.width - 24px;
        Text { x: 10px; text: "ACTIONS MATCHING ‘SCAN’"; font-size: 12px; color: root.dark ? #a9aab5 : #5d5f68; }
        ResultRow { y: 24px; width: parent.width; dark: root.dark; unavailable: true; label: "Scan system music library"; detail: "Unavailable while a scan is running"; tail: "Unavailable"; }
    }
    Text {
        x: 20px; y: parent.height - 32px;
        text: root.kind == 4 ? "Esc  Close" : (root.kind == 5 ? "Action unavailable · Esc  Close" : (root.kind == 1 ? "↑↓  Navigate    Enter  Open folder picker" : "↑↓  Navigate    Enter  Open folder"));
        color: root.dark ? #a9aab5 : #5d5f68;
        font-size: 12px;
        overflow: elide; width: parent.width - 36px;
    }
}

export component CommandStudy inherits Window {
    in property <int> study-mode: 1;
    in property <int> variant: 1;
    in property <bool> dark: true;
    in property <bool> compact: true;
    in property <bool> stress: false;
    title: "Music player command study · prototype";
    preferred-width: root.stress ? 360px : (root.compact ? 480px : 1100px);
    preferred-height: root.stress ? 640px : (root.compact ? 600px : 640px);
    background: root.dark ? #000000 : #ffffff;

    if root.study-mode == 2: OtherApp { width: parent.width; height: parent.height; dark: root.dark; }
    if root.study-mode != 2 || root.variant == 1: PlayerBackdrop {
        x: root.study-mode == 2 ? 24px : (root.compact || root.stress ? 0px : 50px);
        y: root.study-mode == 2 ? 66px : (root.compact || root.stress ? 0px : 20px);
        width: root.study-mode == 2 ? parent.width - 48px : (root.compact || root.stress ? parent.width : parent.width - 100px);
        height: root.study-mode == 2 ? parent.height - 100px : (root.compact || root.stress ? parent.height : parent.height - 40px);
        dark: root.dark;
        compact: root.compact || root.stress || root.study-mode == 2;
    }
    if (root.study-mode == 1 && root.variant == 2) || (root.study-mode == 3 && root.variant == 2) || (root.study-mode == 2 && root.variant == 1): Rectangle {
        x: 0px; y: root.study-mode == 2 ? 66px : 34px;
        width: parent.width; height: parent.height - self.y;
        background: root.dark ? #00000099 : #30323b66;
    }
    if root.study-mode == 1 && root.variant == 3: Rectangle {
        x: root.compact ? 0px : 50px;
        y: root.compact ? 92px : 112px;
        width: root.compact ? parent.width : parent.width - 100px;
        height: root.compact ? parent.height - 92px : parent.height - 132px;
        background: root.dark ? #000000 : #ffffff;
        Text { x: 20px; y: 17px; text: "COMMANDS"; font-size: 13px; color: root.dark ? #a9aab5 : #5d5f68; }
    }
    CommandPanel {
        kind: root.study-mode == 3 ? (root.variant == 1 ? 2 : 3) : (root.study-mode == 4 ? (root.variant == 1 ? 4 : 5) : 1);
        dark: root.dark;
        stress: root.stress;
        detached: root.study-mode == 2 && root.variant == 2;
        width: root.study-mode == 1 && root.variant == 3 ? (root.compact ? parent.width - 24px : 700px) :
            (root.study-mode == 1 && root.variant == 1 ? (root.stress ? parent.width : (root.compact ? parent.width : 640px)) : (root.compact ? 400px : 600px));
        height: root.stress ? 440px : (root.study-mode == 1 && root.variant == 3 ? 392px : 340px);
        x: root.study-mode == 1 && root.variant == 1 ? (root.compact || root.stress ? 0px : 62px) :
            (root.study-mode == 1 && root.variant == 3 ? (root.compact ? 12px : 68px) : (parent.width - self.width) / 2);
        y: root.study-mode == 1 && root.variant == 2 ? (root.compact ? 172px : 200px) :
            (root.study-mode == 2 ? (root.variant == 1 ? 158px : 126px) : (root.compact || root.stress ? 92px : 112px));
    }
}
