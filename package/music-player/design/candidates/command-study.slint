// THROWAWAY DESIGN STUDY. The snapshots compare command surface placement and its
// relationship to future search. This file is not a production desktop window.
// Two axes are independent: surface-mode (1 docked, 2 floating, 3 detached concept)
// and content-mode (1 actions, 2 explicit scopes, 3 mixed results).
// Palette values mirror measured wallpaper-role evidence, not an implemented Slint theme.

component ResultRow inherits Rectangle {
    in property <bool> dark;
    in property <bool> selected: false;
    in property <string> label;
    in property <string> detail;
    in property <string> tail;
    height: 52px;
    background: root.selected ? (root.dark ? #465174 : #afc0f4) : #00000000;
    border-radius: 6px;
    Text {
        x: 16px;
        y: 6px;
        width: parent.width - 116px;
        height: 24px;
        text: root.label;
        color: root.dark ? #e4e5f0 : #30323b;
        font-size: 15px;
        font-weight: root.selected ? 600 : 400;
        overflow: elide;
    }
    Text {
        x: 16px;
        y: 30px;
        width: parent.width - 116px;
        height: 18px;
        text: root.detail;
        color: root.dark ? #a9aab5 : #5d5f68;
        font-size: 12px;
        overflow: elide;
    }
    Text {
        x: parent.width - 102px;
        y: 13px;
        width: 86px;
        height: 24px;
        text: root.tail;
        color: root.dark ? #a9aab5 : #5d5f68;
        font-size: 12px;
        horizontal-alignment: right;
        overflow: elide;
    }
}

component PlayerBackdrop inherits Rectangle {
    in property <bool> dark;
    in property <bool> compact;
    background: root.dark ? #000000 : #ffffff;
    border-width: 1px;
    border-color: root.dark ? #464850 : #b0b1bc;
    clip: true;

    Rectangle {
        height: 34px;
        width: parent.width;
        background: root.dark ? #121318 : #f4f3fa;
        Text {
            x: 16px;
            y: 7px;
            text: "Music Player";
            color: root.dark ? #e4e5f0 : #30323b;
            font-size: 14px;
            font-weight: 600;
        }
        Text {
            x: parent.width - 64px;
            y: 7px;
            text: "—  ×";
            color: root.dark ? #a9aab5 : #5d5f68;
            font-size: 14px;
        }
    }
    Rectangle {
        x: 0px;
        y: 34px;
        width: parent.width;
        height: 58px;
        border-width: 1px;
        border-color: root.dark ? #464850 : #b0b1bc;
        background: root.dark ? #000000 : #ffffff;
        Text {
            x: 18px;
            y: 17px;
            text: "Camellia ▾";
            color: root.dark ? #e4e5f0 : #30323b;
            font-size: 16px;
            font-weight: 600;
        }
        Text {
            x: parent.width - 109px;
            y: 17px;
            text: "▣  Open";
            color: root.dark ? #bac5ee : #4e5e8b;
            font-size: 14px;
        }
    }
    Rectangle {
        x: root.compact ? 0px : 0px;
        y: 92px;
        width: root.compact ? parent.width : 330px;
        height: root.compact ? 150px : parent.height - 92px;
        background: root.dark ? #000000 : #ffffff;
        Text {
            x: 20px;
            y: 15px;
            text: "Another Xronixle";
            color: root.dark ? #e4e5f0 : #30323b;
            font-size: 16px;
            font-weight: 600;
        }
        Text {
            x: 20px;
            y: 43px;
            text: "1 of 16  ·  −1.2 dBTP";
            color: root.dark ? #a9aab5 : #5d5f68;
            font-size: 12px;
        }
        Rectangle {
            x: 20px;
            y: 78px;
            width: parent.width - 40px;
            height: 3px;
            background: root.dark ? #bac5ee : #4e5e8b;
        }
        Text {
            x: 20px;
            y: 98px;
            text: "◁       ▶       ▷";
            color: root.dark ? #e4e5f0 : #30323b;
            font-size: 18px;
        }
    }
    Rectangle {
        x: root.compact ? 0px : 330px;
        y: root.compact ? 242px : 92px;
        width: root.compact ? parent.width : parent.width - 330px;
        height: root.compact ? parent.height - 242px : parent.height - 92px;
        background: root.dark ? #000000 : #ffffff;
        border-width: 1px;
        border-color: root.dark ? #464850 : #b0b1bc;
        Text {
            x: 16px;
            y: 18px;
            text: "Tracks in Camellia";
            color: root.dark ? #a9aab5 : #5d5f68;
            font-size: 13px;
        }
        Rectangle {
            x: 12px;
            y: 54px;
            width: parent.width - 24px;
            height: 58px;
            background: root.dark ? #121318 : #f4f3fa;
            Text {
                x: 14px;
                y: 18px;
                text: "Another Xronixle";
                color: root.dark ? #e4e5f0 : #30323b;
                font-size: 15px;
                font-weight: 600;
            }
        }
        Text {
            x: 26px;
            y: 130px;
            text: "Burning Aquamarine";
            color: root.dark ? #e4e5f0 : #30323b;
            font-size: 15px;
        }
        Text {
            x: 26px;
            y: 186px;
            text: "Dokuhebi";
            color: root.dark ? #e4e5f0 : #30323b;
            font-size: 15px;
        }
    }
}

component CommandPanel inherits Rectangle {
    in property <bool> dark;
    in property <int> surface-mode;
    in property <int> content-mode;
    background: root.dark ? #1e1f26 : #e7e7f1;
    border-radius: root.surface-mode == 1 ? 8px : 16px;
    border-width: 1px;
    border-color: root.dark ? #464850 : #b0b1bc;
    clip: true;

    if root.surface-mode == 3: Text {
        x: 16px;
        y: 10px;
        text: "Music Player  ·  Command bar";
        color: root.dark ? #a9aab5 : #5d5f68;
        font-size: 12px;
    }
    Rectangle {
        x: 12px;
        y: root.surface-mode == 3 ? 36px : 12px;
        width: parent.width - 24px;
        height: 56px;
        background: root.dark ? #121318 : #ffffff;
        border-radius: 8px;
        border-width: 1px;
        border-color: root.dark ? #464850 : #b0b1bc;
        Text {
            x: 16px;
            y: 15px;
            text: root.content-mode == 1 ? ">  Run an action" : (root.content-mode == 2 ? "⌕  Find an action, folder or track" : "⌕  Search library and actions");
            color: root.dark ? #a9aab5 : #5d5f68;
            font-size: 15px;
            overflow: elide;
            width: parent.width - 86px;
        }
        Text {
            x: parent.width - 60px;
            y: 16px;
            text: "Esc";
            color: root.dark ? #a9aab5 : #5d5f68;
            font-size: 12px;
        }
    }
    if root.content-mode == 1: Rectangle {
        x: 12px;
        y: root.surface-mode == 3 ? 104px : 80px;
        width: parent.width - 24px;
        height: parent.height - 128px;
        Text { x: 8px; y: 0px; text: "ACTIONS"; font-size: 12px; color: root.dark ? #a9aab5 : #5d5f68; }
        ResultRow { x: 0px; y: 24px; width: parent.width; dark: root.dark; selected: true; label: "Pause playback"; detail: "Player"; tail: "Space"; }
        ResultRow { x: 0px; y: 78px; width: parent.width; dark: root.dark; label: "Shuffle Camellia"; detail: "Playback mode"; tail: ""; }
        ResultRow { x: 0px; y: 132px; width: parent.width; dark: root.dark; label: "Open folder picker"; detail: "Navigation"; tail: "Ctrl+O"; }
        ResultRow { x: 0px; y: 186px; width: parent.width; dark: root.dark; label: "Settings"; detail: "Preferences"; tail: ""; }
    }
    if root.content-mode == 2: Rectangle {
        x: 12px;
        y: root.surface-mode == 3 ? 104px : 80px;
        width: parent.width - 24px;
        height: parent.height - 128px;
        Rectangle {
            width: parent.width;
            height: 44px;
            background: root.dark ? #121318 : #ffffff;
            border-radius: 8px;
            Text { x: 12px; y: 12px; text: "Actions"; font-size: 14px; color: root.dark ? #a9aab5 : #5d5f68; }
            Text { x: parent.width / 3 + 12px; y: 12px; text: "Tracks"; font-size: 14px; font-weight: 600; color: root.dark ? #bac5ee : #4e5e8b; }
            Text { x: parent.width * 2 / 3 + 12px; y: 12px; text: "Folders"; font-size: 14px; color: root.dark ? #a9aab5 : #5d5f68; }
        }
        Text { x: 8px; y: 55px; text: "RECENT TRACKS"; font-size: 12px; color: root.dark ? #a9aab5 : #5d5f68; }
        ResultRow { x: 0px; y: 78px; width: parent.width; dark: root.dark; selected: true; label: "Another Xronixle"; detail: "Track 1 · Camellia"; tail: "4:35"; }
        ResultRow { x: 0px; y: 132px; width: parent.width; dark: root.dark; label: "Burning Aquamarine"; detail: "Track 2 · Camellia"; tail: "5:12"; }
        ResultRow { x: 0px; y: 186px; width: parent.width; dark: root.dark; label: "Dokuhebi"; detail: "Track 3 · Camellia"; tail: "4:01"; }
    }
    if root.content-mode == 3: Rectangle {
        x: 12px;
        y: root.surface-mode == 3 ? 104px : 80px;
        width: parent.width - 24px;
        height: parent.height - 128px;
        Text { x: 8px; y: 0px; text: "FOLDERS"; font-size: 12px; color: root.dark ? #a9aab5 : #5d5f68; }
        ResultRow { x: 0px; y: 20px; width: parent.width; dark: root.dark; selected: true; label: "Camellia"; detail: "Folder"; tail: "Open"; }
        Text { x: 8px; y: 78px; text: "TRACKS"; font-size: 12px; color: root.dark ? #a9aab5 : #5d5f68; }
        ResultRow { x: 0px; y: 98px; width: parent.width; dark: root.dark; label: "Another Xronixle"; detail: "Track · Camellia"; tail: "4:35"; }
        ResultRow { x: 0px; y: 152px; width: parent.width; dark: root.dark; label: "Burning Aquamarine"; detail: "Track · Camellia"; tail: "5:12"; }
        Text { x: 8px; y: 211px; text: "ACTIONS"; font-size: 12px; color: root.dark ? #a9aab5 : #5d5f68; }
        ResultRow { x: 0px; y: 231px; width: parent.width; dark: root.dark; label: "Shuffle Camellia"; detail: "Playback mode"; tail: ""; }
    }
    Text {
        x: 20px;
        y: parent.height - 30px;
        text: root.content-mode == 1 ? "↑↓  Navigate     Enter  Run action" : "↑↓  Navigate     Enter  Open result";
        color: root.dark ? #a9aab5 : #5d5f68;
        font-size: 12px;
    }
}

export component CommandStudy inherits Window {
    in property <int> surface-mode: 1;
    in property <int> content-mode: 1;
    in property <bool> dark: true;
    in property <bool> compact: true;
    title: "Music player command study · prototype";
    preferred-width: root.compact ? 480px : 1100px;
    preferred-height: root.compact ? 600px : 640px;
    background: root.dark ? #000000 : #ffffff;

    PlayerBackdrop {
        x: root.compact ? 0px : 50px;
        y: root.compact ? 0px : 20px;
        width: root.compact ? parent.width : parent.width - 100px;
        height: root.compact ? parent.height : parent.height - 40px;
        dark: root.dark;
        compact: root.compact;
    }
    if root.surface-mode != 3: Rectangle {
        x: 0px;
        y: 34px;
        width: parent.width;
        height: parent.height - 34px;
        background: root.dark ? #98000000 : #8c30323b;
    }
    CommandPanel {
        surface-mode: root.surface-mode;
        content-mode: root.content-mode;
        dark: root.dark;
        width: root.surface-mode == 1 ? (root.compact ? parent.width - 24px : 640px) : (root.compact ? parent.width - 40px : 600px);
        height: root.surface-mode == 1 ? 356px : (root.surface-mode == 3 ? 388px : 376px);
        x: root.surface-mode == 1 ? (root.compact ? 12px : 92px) : (parent.width - self.width) / 2;
        y: root.surface-mode == 1 ? 96px : (root.surface-mode == 3 ? 56px : 88px);
    }
}
