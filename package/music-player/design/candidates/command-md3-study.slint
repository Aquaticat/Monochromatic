// THROWAWAY, NONFUNCTIONAL BASELINE MD3 SEARCH STUDY.
// The previously rendered contained/Expressive version conflicted with A2.
// Baseline expanded docked: 28dp outer shape, 56dp header, divider, High container.
// Baseline expanded full-content: sharp outer shape, 72dp header, divider.
// Baseline list: square rows, 16dp start padding, minimum 48dp targets.
// The outlined keyboard-current row is a custom desktop focus cue, not selection.
// Desktop color-role and window-mode adaptations must be disclosed in the review.
import "command-fonts/Roboto-Regular.ttf";

component MaterialGlyph inherits Image {
    in property <image> glyph;
    in property <color> ink;
    source: root.glyph;
    colorize: root.ink;
    image-fit: contain;
    width: 24px;
    height: 24px;
    accessible-role: none;
}

component Md3Result inherits Rectangle {
    in property <bool> dark;
    in property <bool> active: false;
    in property <bool> unavailable: false;
    in property <bool> large: false;
    in property <image> glyph: @image-url("command-icons/folder.svg");
    in property <string> label;
    in property <string> supporting;
    in property <string> end-label;
    height: root.large ? 96px : 64px;
    background: root.active ? (root.dark ? #2e3038 : #d5d6e2) : #00000000;
    border-radius: root.active ? 4px : 0px;
    border-width: root.active ? 2px : 0px;
    border-color: root.dark ? #bac5ee : #4e5e8b;
    MaterialGlyph {
        x: 16px; y: root.large ? 20px : 20px;
        glyph: root.glyph;
        ink: root.active ? (root.dark ? #e4e5f0 : #30323b) : (root.dark ? #a9aab5 : #5d5f68);
    }
    Text {
        x: 56px; y: root.large ? 8px : 9px;
        width: parent.width - (root.large ? 150px : 154px);
        height: root.large ? 56px : 26px;
        text: root.label;
        font-size: root.large ? 20px : 16px;
        font-weight: 400;
        wrap: root.large ? word-wrap : no-wrap;
        overflow: root.large ? clip : elide;
        color: root.active ? (root.dark ? #e4e5f0 : #30323b) :
            (root.unavailable ? (root.dark ? #a9aab5 : #5d5f68) : (root.dark ? #e4e5f0 : #30323b));
    }
    Text {
        x: 56px; y: root.large ? 67px : 36px;
        width: parent.width - 154px;
        height: 22px;
        text: root.supporting;
        font-size: root.large ? 14px : 14px;
        overflow: elide;
        color: root.active ? (root.dark ? #e4e5f0 : #30323b) : (root.dark ? #a9aab5 : #5d5f68);
    }
    Text {
        x: parent.width - 90px; y: root.large ? 19px : 19px;
        width: 74px; height: 25px;
        text: root.end-label;
        font-size: 12px;
        horizontal-alignment: right;
        overflow: elide;
        color: root.active ? (root.dark ? #e4e5f0 : #30323b) : (root.dark ? #a9aab5 : #5d5f68);
    }
}

component Md3SearchSurface inherits Rectangle {
    in property <bool> dark;
    in property <bool> full-content: false;
    in property <bool> large: false;
    in property <int> state: 1; // 1 commands, 2 search, 3 no results, 4 unavailable
    in property <bool> shared-search: false;
    in property <bool> show-owner: false;
    background: root.dark ? #1e1f26 : #e7e7f1;
    border-radius: root.full-content ? 0px : 28px;
    clip: true;

    // Baseline divided Search: header and results share the High container, separated by 1px.
    Rectangle {
        x: 0px; y: 0px; width: parent.width;
        height: root.full-content ? 72px : 56px;
        background: root.dark ? #1e1f26 : #e7e7f1;
        MaterialGlyph { x: 28px; y: root.full-content ? 24px : 16px; glyph: @image-url("command-icons/back.svg"); ink: root.dark ? #e4e5f0 : #30323b; }
        Text {
            x: 80px; y: root.full-content ? 23px : 15px;
            width: parent.width - 160px; height: 27px;
            text: root.state == 3 ? "zzq" : (root.state == 4 ? "scan" : (root.state == 2 ? "cam" : "open"));
            font-size: root.large ? 20px : 16px;
            color: root.dark ? #e4e5f0 : #30323b;
        }
        MaterialGlyph { x: parent.width - 52px; y: root.full-content ? 24px : 16px; glyph: @image-url("command-icons/close.svg"); ink: root.dark ? #a9aab5 : #5d5f68; }
    }
    Rectangle {
        x: 0px; y: root.full-content ? 71px : 55px;
        width: parent.width; height: 1px;
        background: root.dark ? #73757f : #797a84;
    }
    if root.show-owner: Text {
        x: 20px; y: 63px; height: 20px;
        text: "Music Player · Commands";
        font-size: 14px; font-weight: 600;
        color: root.dark ? #e4e5f0 : #30323b;
    }
    if root.shared-search: Rectangle {
        x: 16px; y: root.full-content ? 80px : 64px;
        width: parent.width - 32px; height: 45px;
        Text { x: 8px; y: 10px; text: "Actions"; font-size: 14px; color: root.dark ? #a9aab5 : #5d5f68; }
        Text { x: 108px; y: 10px; text: "Search"; font-size: 14px; font-weight: 600; color: root.dark ? #bac5ee : #4e5e8b; }
        Rectangle { x: 102px; y: 42px; width: 60px; height: 2px; background: root.dark ? #bac5ee : #4e5e8b; }
    }
    Text {
        x: 20px;
        y: (root.full-content ? 88px : 72px) + (root.shared-search ? 47px : 0px) + (root.show-owner ? 24px : 0px);
        text: root.state == 2 ? "Search results" : (root.state == 3 ? "No matching actions" : "Actions");
        font-size: 14px;
        font-weight: 600;
        color: root.dark ? #e4e5f0 : #30323b;
    }
    if root.state == 1: Rectangle {
        x: 12px; y: (root.full-content ? 112px : 100px) + (root.show-owner ? 24px : 0px);
        width: parent.width - 24px; height: root.large ? 224px : 196px;
        Md3Result {
            x: 0px; y: 0px; width: parent.width; dark: root.dark; active: true; large: root.large;
            glyph: @image-url("command-icons/folder.svg"); label: "Open folder picker";
            supporting: "Shows the folder selector"; end-label: "Ctrl+O";
        }
        Md3Result {
            x: 0px; y: root.large ? 100px : 66px; width: parent.width; dark: root.dark; large: root.large;
            glyph: @image-url("command-icons/settings.svg");
            label: root.large ? "Open system library settings" : "Open settings";
            supporting: root.large ? "Opens library settings" : "Opens player settings"; end-label: "";
        }
        if !root.large: Md3Result {
            x: 0px; y: 132px; width: parent.width; dark: root.dark;
            glyph: @image-url("command-icons/music.svg"); label: "Open system music library";
            supporting: "Navigates to the system library"; end-label: "";
        }
    }
    if root.state == 2: Rectangle {
        x: 12px; y: (root.full-content ? 112px : 100px) + (root.shared-search ? 47px : 0px);
        width: parent.width - 24px; height: 136px;
        Md3Result {
            x: 0px; y: 0px; width: parent.width; dark: root.dark; active: true;
            glyph: @image-url("command-icons/folder.svg"); label: "Camellia";
            supporting: "Folder · opens this folder"; end-label: "Folder";
        }
        Md3Result {
            x: 0px; y: 66px; width: parent.width; dark: root.dark;
            glyph: @image-url("command-icons/music.svg"); label: "Another Xronixle";
            supporting: "Track · Camellia · reveals track"; end-label: "Track";
        }
    }
    if root.state == 3: Text {
        x: 24px; y: root.full-content ? 145px : 133px;
        text: "Try a shorter action name."; font-size: 14px;
        color: root.dark ? #a9aab5 : #5d5f68;
    }
    if root.state == 4: Md3Result {
        x: 12px; y: root.full-content ? 112px : 100px;
        width: parent.width - 24px; dark: root.dark; unavailable: true;
        glyph: @image-url("command-icons/music.svg"); label: "Scan system music library";
        supporting: "Unavailable while scanning"; end-label: "Unavailable";
    }
    Text {
        x: 20px; y: parent.height - 30px;
        width: parent.width - 40px; height: 20px;
        text: root.state == 4 ? "Unavailable · Esc closes" :
            (root.state == 3 ? "Esc closes" : (root.state == 2 ? "Enter opens the folder · Esc closes" : "Enter opens folder picker · Esc closes"));
        font-size: 12px; overflow: elide;
        color: root.dark ? #a9aab5 : #5d5f68;
    }
}

component PlayerBackdrop inherits Rectangle {
    in property <bool> dark;
    in property <bool> compact;
    background: root.dark ? #000000 : #ffffff;
    border-width: 1px; border-color: root.dark ? #464850 : #b0b1bc;
    clip: true;
    Rectangle {
        width: parent.width; height: 34px;
        background: root.dark ? #121318 : #f4f3fa;
        Text { x: 16px; y: 7px; text: "Music Player"; font-size: 14px; font-weight: 600; color: root.dark ? #e4e5f0 : #30323b; }
    }
    Rectangle {
        y: 34px; width: parent.width; height: 58px;
        background: root.dark ? #000000 : #ffffff;
        Text { x: 18px; y: 17px; text: "Camellia"; font-size: 18px; font-weight: 600; color: root.dark ? #e4e5f0 : #30323b; }
        Rectangle {
            x: parent.width - 125px; y: 5px; width: 112px; height: 48px;
            border-radius: 24px;
            background: root.dark ? #303a54 : #e1e6f7;
            MaterialGlyph { x: 16px; y: 12px; glyph: @image-url("command-icons/folder.svg"); ink: root.dark ? #bac5ee : #4e5e8b; }
            Text { x: 48px; y: 14px; text: "Open"; font-size: 14px; font-weight: 600; color: root.dark ? #bac5ee : #4e5e8b; }
        }
    }
    Rectangle { y: 92px; width: parent.width; height: 1px; background: root.dark ? #464850 : #b0b1bc; }
    Rectangle {
        y: 93px; width: root.compact ? parent.width : 330px;
        height: root.compact ? 180px : parent.height - 93px;
        background: root.dark ? #000000 : #ffffff;
        Text { x: 20px; y: 13px; text: "Another Xronixle"; font-size: 16px; font-weight: 600; color: root.dark ? #e4e5f0 : #30323b; }
        Text { x: 20px; y: 41px; text: "1 of 16 · −1.2 dBTP"; font-size: 14px; color: root.dark ? #a9aab5 : #5d5f68; }
        Rectangle { x: 20px; y: 80px; width: parent.width - 40px; height: 4px; border-radius: 2px; background: root.dark ? #353b4d : #dde2f9; }
        Rectangle { x: 20px; y: 80px; width: (parent.width - 40px) * 0.24; height: 4px; border-radius: 2px; background: root.dark ? #bac5ee : #4e5e8b; }
        Rectangle {
            x: (parent.width - 168px) / 2; y: 100px; width: 48px; height: 48px;
            border-radius: 24px; border-width: 1px;
            border-color: root.dark ? #73757f : #797a84;
            MaterialGlyph { x: 12px; y: 12px; glyph: @image-url("command-icons/skip_previous.svg"); ink: root.dark ? #e4e5f0 : #30323b; }
        }
        Rectangle {
            x: (parent.width - 168px) / 2 + 60px; y: 100px; width: 48px; height: 48px;
            border-radius: 24px; background: root.dark ? #bac5ee : #4e5e8b;
            MaterialGlyph { x: 12px; y: 12px; glyph: @image-url("command-icons/pause.svg"); ink: root.dark ? #30323b : #ffffff; }
        }
        Rectangle {
            x: (parent.width - 168px) / 2 + 120px; y: 100px; width: 48px; height: 48px;
            border-radius: 24px; border-width: 1px;
            border-color: root.dark ? #73757f : #797a84;
            MaterialGlyph { x: 12px; y: 12px; glyph: @image-url("command-icons/skip_next.svg"); ink: root.dark ? #e4e5f0 : #30323b; }
        }
    }
    Rectangle {
        x: root.compact ? 0px : 330px; y: root.compact ? 273px : 93px;
        width: root.compact ? parent.width : parent.width - 330px;
        height: root.compact ? parent.height - 273px : parent.height - 93px;
        background: root.dark ? #000000 : #ffffff;
        Text { x: 16px; y: 18px; text: "Tracks in Camellia"; font-size: 14px; color: root.dark ? #a9aab5 : #5d5f68; }
        Rectangle {
            x: 12px; y: 54px; width: parent.width - 24px; height: 64px;
            background: root.dark ? #121318 : #f4f3fa;
            Text { x: 16px; y: 20px; text: "Another Xronixle"; font-size: 16px; font-weight: 600; color: root.dark ? #e4e5f0 : #30323b; }
        }
        Text { x: 28px; y: 140px; text: "Burning Aquamarine"; font-size: 16px; color: root.dark ? #e4e5f0 : #30323b; }
        Text { x: 28px; y: 202px; text: "Dokuhebi"; font-size: 16px; color: root.dark ? #e4e5f0 : #30323b; }
    }
}

component OtherApp inherits Rectangle {
    in property <bool> dark;
    background: root.dark ? #10151a : #f0f3f6;
    Text { x: 16px; y: 13px; text: "Notes · previously active app"; font-size: 16px; font-weight: 600; color: root.dark ? #e4e5f0 : #30323b; }
    Rectangle { x: 16px; y: 58px; width: parent.width - 32px; height: 1px; background: root.dark ? #464850 : #b0b1bc; }
    Text { x: 24px; y: 85px; text: "Working notes"; font-size: 20px; font-weight: 600; color: root.dark ? #e4e5f0 : #30323b; }
    Text { x: 24px; y: 548px; text: "The previous app remains after a quick command."; font-size: 12px; color: root.dark ? #a9aab5 : #5d5f68; }
}

export component CommandMd3Study inherits Window {
    in property <int> study-mode: 1; // I 1, G 2, R 3, E 4
    in property <int> variant: 1;
    in property <bool> dark: true;
    in property <bool> compact: true;
    in property <bool> stress: false;
    title: "Music player MD3 command study · prototype";
    default-font-family: "Roboto";
    preferred-width: root.stress ? 360px : (root.compact ? 480px : 1100px);
    preferred-height: root.stress ? 640px : (root.compact ? 600px : 640px);
    background: root.dark ? #000000 : #ffffff;

    if root.study-mode == 2: OtherApp { width: parent.width; height: parent.height; dark: root.dark; }
    if root.study-mode != 2 || root.variant == 1: PlayerBackdrop {
        x: root.study-mode == 2 ? 24px : (root.compact || root.stress ? 0px : 50px);
        y: root.study-mode == 2 ? 66px : (root.compact || root.stress ? 0px : 20px);
        width: root.study-mode == 2 ? parent.width - 48px : (root.compact || root.stress ? parent.width : parent.width - 100px);
        height: root.study-mode == 2 ? parent.height - 100px : (root.compact || root.stress ? parent.height : parent.height - 40px);
        dark: root.dark;
        compact: root.compact || root.stress || root.study-mode == 2;
    }
    if (root.study-mode == 1 && root.variant < 3 && !root.stress) || (root.study-mode == 3 && root.variant == 2) || (root.study-mode == 2 && root.variant == 1): Rectangle {
        x: root.study-mode == 2 ? 24px : (root.compact || root.stress ? 0px : 50px);
        y: root.study-mode == 2 ? 66px : (root.compact || root.stress ? 34px : 54px);
        width: root.study-mode == 2 ? parent.width - 48px : (root.compact || root.stress ? parent.width : parent.width - 100px);
        height: root.study-mode == 2 ? parent.height - 100px : (root.compact || root.stress ? parent.height - 34px : parent.height - 74px);
        background: root.dark ? #00000099 : #30323b66;
    }
    if (root.study-mode == 1 && (root.variant == 3 || root.stress)) || (root.study-mode == 3 && root.variant == 1): Rectangle {
        x: root.compact || root.stress ? 0px : 50px;
        y: root.compact || root.stress ? 93px : 113px;
        width: root.compact || root.stress ? parent.width : parent.width - 100px;
        height: root.compact || root.stress ? parent.height - 93px : parent.height - 133px;
        background: root.dark ? #1e1f26 : #e7e7f1;
    }
    Md3SearchSurface {
        state: root.study-mode == 3 ? 2 : (root.study-mode == 4 ? (root.variant == 1 ? 3 : 4) : 1);
        shared-search: root.study-mode == 3 && root.variant == 2;
        show-owner: root.study-mode == 2 && root.variant == 2;
        full-content: (root.study-mode == 1 && (root.variant == 3 || root.stress)) || (root.study-mode == 3 && root.variant == 1);
        dark: root.dark;
        large: root.stress;
        width: root.stress ? parent.width :
            ((root.study-mode == 1 && root.variant == 3) || (root.study-mode == 3 && root.variant == 1) ? (root.compact ? parent.width : parent.width - 100px) :
            (root.study-mode == 1 && root.variant == 1 ? (root.compact ? parent.width - 24px : 640px) : (root.compact ? 400px : 640px)));
        height: root.stress ? parent.height - 93px :
            ((root.study-mode == 1 && root.variant == 3) || (root.study-mode == 3 && root.variant == 1) ? (root.compact ? parent.height - 93px : parent.height - 133px) : 374px);
        x: root.stress ? 0px : (root.study-mode == 1 && root.variant == 1 ? (root.compact ? 12px : 62px) :
            ((root.study-mode == 1 && root.variant == 3) || (root.study-mode == 3 && root.variant == 1) ? (root.compact ? 0px : 50px) : (parent.width - self.width) / 2));
        y: root.stress ? 93px : (root.study-mode == 1 && root.variant == 2 ? (root.compact ? 120px : 182px) :
            (root.study-mode == 2 ? (root.variant == 1 ? 158px : 126px) : (root.compact ? 93px : 113px)));
    }
}
