<?xml version='1.0' encoding='utf-8'?>
<manifest xmlns:android='http://schemas.android.com/apk/res/android'
  xmlns:tools='http://schemas.android.com/tools'>
  <application>
    <!-- This owned debug study cannot launch production entry points or services. -->
    <activity android:name='.MainActivity' android:enabled='false' />
    <service android:name='.PlaybackService' android:enabled='false' />
    <service android:name='.PeakSweepService' android:enabled='false' />
    <activity android:name='.FirstRunAccessActivity' android:exported='true' />
    <activity android:name='.LightFeedbackActivity' android:exported='true' />
    <activity android:name='.TrackMenuActivity' android:exported='true' />
    <!-- Do not restore or start inherited WorkManager jobs in the isolated host. -->
    <provider android:name='androidx.startup.InitializationProvider'
      android:authorities='${applicationId}.androidx-startup'>
      <meta-data android:name='androidx.work.WorkManagerInitializer' tools:node='remove' />
    </provider>
    <!-- Debug-only IME for validating the system keyboard inset when Gboard shows no keys. -->
    <service
      android:name='.FoldProbeInputMethod'
      android:exported='true'
      android:label='Fold debug keyboard probe'
      android:permission='android.permission.BIND_INPUT_METHOD'
    >
      <intent-filter>
        <action android:name='android.view.InputMethod' />
      </intent-filter>
      <meta-data android:name='android.view.im' android:resource='@xml/fold_probe_input_method' />
    </service>
    <!-- Debug-only tall system IME, a height stressor distinct from real Gboard evidence. -->
    <service
      android:name='.FoldBannerInputMethod'
      android:exported='true'
      android:label='Fold debug banner-height stress'
      android:permission='android.permission.BIND_INPUT_METHOD'
    >
      <intent-filter>
        <action android:name='android.view.InputMethod' />
      </intent-filter>
      <meta-data android:name='android.view.im' android:resource='@xml/fold_probe_input_method' />
    </service>
    <!-- Debug-only native IME whose height steps bracket the measured deck-fit boundary. -->
    <service
      android:name='.FoldHeightStepInputMethod'
      android:exported='true'
      android:label='Fold debug keyboard height steps'
      android:permission='android.permission.BIND_INPUT_METHOD'
    >
      <intent-filter>
        <action android:name='android.view.InputMethod' />
      </intent-filter>
      <meta-data android:name='android.view.im' android:resource='@xml/fold_probe_input_method' />
    </service>
    <!-- Actual production player renderer with synthetic tracks and a paused no-audio engine. -->
    <activity
      android:name='.FilenameBaselineActivity'
      android:exported='true'
    />
    <!-- Debug-only, non-functional Compose surface used for Pixel Fold screenshot capture. -->
    <activity
      android:name='.DesignCandidateActivity'
      android:exported='true'
      android:screenOrientation='portrait'
      android:theme='@android:style/Theme.Material.Light.NoActionBar'
    />
  </application>
</manifest>
