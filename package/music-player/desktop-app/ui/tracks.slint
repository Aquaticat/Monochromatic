// Track list pane for one folder's flat list (D5, D6, D42). Track rows and subfolder headers share one
// scrolling list, and the playing row can be scrolled into view as playback moves.
import { Theme } from "theme.slint";
import { StateLayer } from "state_layer.slint";
import { Focus, PlayerStop, FocusRing, KeyBadge, Keys } from "focus.slint";

// One entry of the flat list. A track row (kind 0) plays on tap; a subfolder header (kind 1) only labels the
// tracks below it, with its name in `title` and its count text in `supporting`.
export struct TrackListRow {
    // 0 for a playable track row, 1 for a subfolder header.
    kind: int,
    // File name without its extension for a track, or the subfolder name for a header.
    title: string,
    // Second line of a track, such as a duration and peak line, or empty for none. For a header, the count text such as "3 tracks".
    supporting: string,
    // Whether this track is the playing track. Ignored for headers.
    current: bool,
    // Library index that `play` and `open-menu` report back. Ignored for headers.
    index: int,
}

// Draws the rows of one folder's flat list. Rows are laid out with fixed heights so the pane can compute the
// scroll offset of any row without waiting for the layout pass.
export component TrackListPane inherits Rectangle {
    background: Theme.canvas;
    clip: true;

    // Entries to draw, in list order.
    in property <[TrackListRow]> rows: [];
    // Y offset from the top of the list of the row to bring to the top of the pane, or 0 for the top of the list. The pane
    // reads it only when scroll-tick changes, so a change of the playing track or of the rows never moves the list.
    in property <length> scroll-offset: 0px;
    // Counts scroll requests. Each change scrolls the pane to scroll-offset, so a repeated request scrolls again.
    in property <int> scroll-tick: 0;
    // Fires with the library index of a track row when the row is tapped without a long press.
    callback play(int);
    // Fires with the library index of a track row and the pointer position relative to this pane, on a right
    // click or a 500 ms long press. The position is what the caller uses to place the menu.
    callback open-menu(int, length, length);
    // Library index of the track row the keyboard ring is on; -1 for none. The Rust side moves it with the list keys.
    in property <int> ring-index: -1;
    // Changes each time the ring moves; the list then scrolls the row at `ring-offset` into view.
    in property <int> ring-tick: 0;
    // Distance from the top of the list to the top of the ringed row.
    in property <length> ring-offset: 0px;
    // Height of the ringed row.
    in property <length> ring-height: 48px;
    // Changes when the Menu key or Shift+F10 asks for the ringed row's menu; the list then reports `open-menu` for
    // the row `menu-index` at `menu-offset`, as a right click does.
    in property <int> menu-tick: 0;
    // Library index of the row whose menu the keyboard asked for.
    in property <int> menu-index: -1;
    // Distance from the top of the list to the top of that row.
    in property <length> menu-offset: 0px;
    // False for the copy of the list that sits in the layout the window is not showing. The window builds both layouts, and
    // a request for focus, for a menu or for the page size is meant for the layout that is on screen.
    in property <bool> active: true;
    // True when the list should take keyboard focus: when it is created and each time `focus-tick` changes.
    in property <bool> wants-focus: false;
    // Changes when the Rust side asks for focus (Alt+2).
    in property <int> focus-tick: 0;
    // Number of 48 px rows that fit the pane, for the page keys.
    callback page-rows(int);
    // Fired when the list gains keyboard focus, so the ring can start on a row.
    callback focused();

    // Height of a track row without a second line, which is the 48 px touch target.
    property <length> row-min-height: 48px;
    // Height of a track row with a second line.
    property <length> row-two-line-height: 72px;
    // Height of a subfolder header, which holds its 16 px top gap, name line and count line.
    property <length> header-height: 54px;
    // Horizontal inset of the row text from the pane edges, which keeps text clear of the current-row highlight.
    property <length> text-inset: 16px;
    // Hold time before a press opens the track menu.
    property <duration> long-press-time: 500ms;

    // Height of one entry from its kind and whether it has a second line.
    pure function height-of(row: TrackListRow) -> length {
        row.kind == 1 ? header-height : (row.supporting == "" ? row-min-height : row-two-line-height)
    }

    // Moves the list so the entry whose top is at the given offset sits at the top, clamped to the scrollable range.
    function reveal(top: length) {
        flick.content-y = max(min(0px, flick.height - flick.content-height), min(0px, -top));
    }

    // Scrolls just enough to bring a row inside the viewport; the list keys use it so the ringed row stays visible.
    function ensure-visible(top: length, height: length) {
        if (top < -flick.content-y) {
            flick.content-y = min(0px, -top);
        } else if (top + height > -flick.content-y + flick.height) {
            flick.content-y = max(flick.height - flick.content-height, flick.height - (top + height));
        }
    }

    changed ring-tick => {
        root.ensure-visible(root.ring-offset, root.ring-height);
    }
    changed menu-tick => {
        // The menu opens under the row's top, 32 px in from the left, kept inside the pane.
        if (root.active) {
            root.open-menu(root.menu-index, 32px, max(8px, min(root.height - 8px, root.menu-offset + flick.content-y + 40px)));
        }
    }
    changed focus-tick => {
        if (root.wants-focus && root.active) {
            list-stop.focus();
        }
    }
    changed height => {
        if (root.active) {
            root.page-rows(max(1, Math.floor(root.height / 48px)));
        }
    }

    // Scrolls to the requested offset each time the Rust side bumps scroll-tick, and is the only place the list scrolls.
    changed scroll-tick => {
        root.reveal(root.scroll-offset);
    }
    // Restores the last requested offset when the pane is created, such as when the folder picker closes and the pane
    // is drawn again, so the list shows the same position as before the pane went away.
    init => {
        root.reveal(root.scroll-offset);
    }
    // Takes keyboard focus when the list is created for a request (the folded layout creates it when the picker closes).
    // A pane that has just been created is not laid out yet, and focusing it then loses the keyboard focus altogether, so
    // the timer waits one frame.
    focus-timer := Timer {
        interval: 16ms;
        running: root.wants-focus && root.active;
        triggered => {
            self.running = false;
            list-stop.focus();
        }
    }

    // The list's keyboard stop. Up, Down, the page keys, Home, End, Enter and the row chords reach the Rust side through
    // the window's key scope; this element only holds focus and reports the zone.
    list-stop := PlayerStop {
        label: "track-list";
        zone: 2;
        activates: false;
        gained => {
            root.focused();
        }
    }

    flick := Flickable {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;

        VerticalLayout {
            width: root.width;

            for row[i] in root.rows: Rectangle {
                height: root.height-of(row);
                background: row.kind == 0 && row.current ? Theme.current-row : transparent;

                // Whole-row tap target and its hover and pressed layer. The layer sits above the row fill and below
                // the text rows, which take no pointer input, so the tap target covers the whole row.
                if row.kind == 0 : Rectangle {
                    width: parent.width;
                    height: parent.height;

                    StateLayer {
                        width: parent.width;
                        height: parent.height;
                        hovered: row-touch.has-hover;
                        pressed: row-touch.pressed;
                        focused: row.index == root.ring-index && list-stop.ring;
                        tint: Theme.on-surface;
                    }

                    // Tap, right click and long press for track rows. Headers have no touch area.
                    row-touch := TouchArea {
                        // Set when a right click or long press has opened the menu, so the release does not also play.
                        property <bool> suppress: false;
                        width: parent.width;
                        height: parent.height;
                        mouse-cursor: pointer;

                        // Milliseconds between the press and the menu request.
                        hold := Timer {
                            interval: root.long-press-time;
                            running: false;
                            triggered => {
                                self.stop();
                                row-touch.suppress = true;
                                root.open-menu(
                                    row.index,
                                    row-touch.absolute-position.x - root.absolute-position.x + row-touch.mouse-x,
                                    row-touch.absolute-position.y - root.absolute-position.y + row-touch.mouse-y,
                                );
                            }
                        }

                        pointer-event(event) => {
                            // A right button press opens the menu immediately.
                            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                                self.suppress = true;
                                root.open-menu(
                                    row.index,
                                    self.absolute-position.x - root.absolute-position.x + self.mouse-x,
                                    self.absolute-position.y - root.absolute-position.y + self.mouse-y,
                                );
                            }
                            // A left press starts the hold timer; releasing or losing the press (a drag scrolls the list) stops it.
                            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                                self.suppress = false;
                                hold.start();
                            }
                            if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                                hold.stop();
                            }
                        }

                        clicked => {
                            Focus.ring-visible = false;
                            list-stop.focus();
                            if (!self.suppress) {
                                root.play(row.index);
                            }
                        }
                    }
                }

                // Keyboard ring around the row under the ring, inside the row so the pane's clip never cuts it.
                FocusRing {
                    active: row.kind == 0 && row.index == root.ring-index && list-stop.ring;
                }

                // Track rows: title and optional second line, both inset by the row padding.
                if row.kind == 0 : VerticalLayout {
                    padding-left: root.text-inset;
                    padding-right: root.text-inset;
                    padding-top: 12px;
                    spacing: 2px;

                    Text {
                        text: row.title;
                        height: 24px;
                        font-size: Theme.body-large;
                        font-weight: row.current ? 700 : 400;
                        color: Theme.on-surface;
                        vertical-alignment: center;
                    }
                    if row.supporting != "" : Text {
                        text: row.supporting;
                        height: 16px;
                        font-size: Theme.body-small;
                        color: Theme.on-surface-variant;
                        vertical-alignment: center;
                    }
                }

                // Subfolder headers: primary name over a count line, with a 16 px gap above.
                if row.kind == 1 : VerticalLayout {
                    padding-left: root.text-inset;
                    padding-right: root.text-inset;
                    padding-top: 16px;
                    spacing: 2px;

                    Text {
                        text: row.title;
                        height: 20px;
                        font-size: Theme.label-large;
                        font-weight: 500;
                        color: Theme.primary;
                        vertical-alignment: center;
                    }
                    Text {
                        text: row.supporting;
                        height: 16px;
                        font-size: Theme.body-small;
                        color: Theme.on-surface-variant;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    // Key hint badge of the Alt+2 shortcut that focuses this list, over the top right corner. It takes no pointer input.
    KeyBadge {
        x: root.width - self.width - 4px;
        y: 4px;
        text: Keys.badges.track-list;
    }
}
