// Keyboard focus model shared by every page (D102, D106): the focus zone the Rust key classifier reads, the focus ring,
// the key hint badges and the shortcut texts the tooltips show.
//
// Every focusable element is a `FocusStop`. It reports its zone to the `Focus` global when it gains focus, so the
// classifier knows whether a key lands in a list, on a button or in a text field. The ring is drawn only while the
// keyboard is in use: a key press turns it on and a pointer press turns it off, like the browsers' focus-visible rule.
import { Theme } from "theme.slint";

// Zone numbers, shared with `FocusZone::from_int` in src/keymap.rs:
// 0 none or the window's key scope, 1 folder list, 2 track list, 3 seek bar, 4 mode group, 5 deck button,
// 6 any other button, 7 text field, 8 Settings list.
export global Focus {
    // True after a key press and false after a pointer press, so a click never leaves a ring behind.
    in-out property <bool> ring-visible: false;
    // Kind of element that holds keyboard focus now.
    in-out property <int> zone: 0;
    // Name of the element that holds keyboard focus now, for the log and the tests; empty for none.
    in-out property <string> label: "";
    // False while a page other than the player is shown. The player's controls then refuse focus, so Tab stays on the
    // page that is on top.
    in-out property <bool> player-active: true;
    // Fired after the zone or the name changed, so the Rust side can log the new focus.
    callback zone-changed(int);
    changed zone => {
        root.zone-changed(root.zone);
    }
    // A key press or a pointer press flips the ring; the log records it so a reader sees the ring turn on and off.
    changed ring-visible => {
        root.zone-changed(root.zone);
    }
    // Two buttons share a zone, so a move between them changes only the name; the log still needs the new focus.
    changed label => {
        root.zone-changed(root.zone);
    }
}

// A focusable element. It shows its ring through `ring` and reports its zone while it holds focus. Enter and Space
// activate it when `activates` is true, as a button does.
export component FocusStop inherits FocusScope {
    // Zone number this element reports (see the list above).
    in property <int> zone: 6;
    // Name of this element, reported to `Focus.label` while it holds focus.
    in property <string> label: "";
    // True for a button: Enter and Space fire `activated`.
    in property <bool> activates: true;
    // True while the ring should be drawn around the element: it has focus and the keyboard is in use.
    out property <bool> ring: root.has-focus && Focus.ring-visible;
    // Fired by Enter or Space on a button.
    callback activated();
    // Fired when the element gains or loses focus, so a list can place its ring.
    callback gained();
    callback lost();
    // Offers a key the element does not handle itself, such as an arrow on a slider; true when the element used it.
    callback extra-key(KeyEvent) -> bool;

    // A pointer press never moves focus here, so the element shows no ring after a click.
    focus-on-click: false;

    focus-gained => {
        Focus.zone = root.zone;
        Focus.label = root.label;
        root.gained();
    }
    focus-lost => {
        // Only the element that set the zone clears it, so the next element's own zone is never overwritten.
        if (Focus.zone == root.zone) {
            Focus.zone = 0;
        }
        if (Focus.label == root.label) {
            Focus.label = "";
        }
        root.lost();
    }
    key-pressed(event) => {
        if (root.activates && (event.text == Key.Return || event.text == " ")) {
            root.activated();
            return accept;
        }
        if (root.extra-key(event)) {
            return accept;
        }
        return reject;
    }
}

// A focusable element of the player page. It refuses focus while another page is shown over the player.
export component PlayerStop inherits FocusStop {
    enabled: Focus.player-active;
}

// The focus ring: a 2 px line in the primary role drawn inside its parent. Together with the 12 percent state layer
// of `StateLayer` it gives two visible channels, so focus never relies on color alone.
export component FocusRing inherits Rectangle {
    // True while the ring is drawn.
    in property <bool> active: false;
    // Corner radius of the element the ring surrounds, for every corner unless one is set on its own.
    in property <length> radius: 0px;
    // Radii of single corners, for elements such as the segments of a connected group.
    in property <length> radius-tl: root.radius;
    in property <length> radius-tr: root.radius;
    in property <length> radius-br: root.radius;
    in property <length> radius-bl: root.radius;

    visible: root.active;
    background: transparent;
    border-width: 2px;
    border-color: Theme.primary;
    border-top-left-radius: root.radius-tl;
    border-top-right-radius: root.radius-tr;
    border-bottom-right-radius: root.radius-br;
    border-bottom-left-radius: root.radius-bl;
}

// Badge texts of the controls that have a shortcut, written by the Rust side while the modifiers of a shortcut are held
// (D106). An empty text draws no badge.
export struct KeyBadges {
    search: string,
    settings: string,
    open-folder: string,
    folder-trigger: string,
    folder-list: string,
    track-list: string,
    previous: string,
    next: string,
    seek-back: string,
    seek-forward: string,
    mode-repeat: string,
    mode-in-order: string,
    mode-shuffle-folder: string,
    mode-shuffle-all: string,
    mode-cycle: string,
    deck-title: string,
    deck-folder: string,
    editor-reset: string,
}

// Shortcut texts of the controls, written once at startup from the binding table for the running platform. Tooltips and
// the Back and Reset controls show them.
export struct ShortcutTexts {
    search: string,
    settings: string,
    open-folder: string,
    folder-trigger: string,
    previous: string,
    play: string,
    next: string,
    seek-back: string,
    seek-forward: string,
    mode-repeat: string,
    mode-in-order: string,
    mode-shuffle-folder: string,
    mode-shuffle-all: string,
    mode-cycle: string,
    deck-title: string,
    deck-folder: string,
    back: string,
    editor-reset: string,
}

// Badges and shortcut texts, set from Rust.
export global Keys {
    in property <KeyBadges> badges;
    in property <ShortcutTexts> texts;
}

// A key hint badge: a small inverse chip with the key, drawn over the corner of its control. It takes no pointer input
// and sits on top of the content without moving it. The chip uses the on-surface role as its fill and the canvas role
// for the key, so it reads in both schemes and under every accent.
export component KeyBadge inherits Rectangle {
    // The key to show, such as F or Left. Empty draws nothing.
    in property <string> text;

    visible: root.text != "";
    height: 18px;
    width: max(18px, label.preferred-width + 10px);
    border-radius: 4px;
    background: Theme.on-surface;

    label := Text {
        text: root.text;
        color: Theme.canvas;
        font-size: 11px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}
