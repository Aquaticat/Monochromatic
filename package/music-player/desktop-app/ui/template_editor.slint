// Template editor page for one open template (D89, D91, D94, D96, D98). The host owns the template text, the
// preview rows, the mistake lines, the help and the field list. This page draws them and reports edits, caret
// moves, focus, field taps, Reset and Back. The whole body scrolls as one page, so the preview scrolls with it (D91).
import { Theme } from "theme.slint";
import { StateLayer } from "state_layer.slint";

// One insertable field row: its name, the call a tap inserts, and its value for the first preview track.
export struct EditorFieldRow {
    // Name of the field shown as the row headline, such as Title.
    label: string,
    // Call shown at the trailing edge and inserted by a tap, such as mi(title).
    insert: string,
    // Value for the first preview track; an empty value is drawn as No value yet.
    value: string,
}

// One preview row: a track title and the line the applied template yields for that track.
export struct EditorPreviewRow {
    // Title of the track as the row shows it.
    title: string,
    // Line the last applied template yields for the track; empty when the template yields nothing.
    supporting: string,
}

// Draws the Preview, Fields and Template page for one open template. Every list is in display order.
export component TemplateEditor inherits Rectangle {
    background: Theme.canvas;
    clip: true;

    // Heading of the page header, which names the open template, such as Track rows.
    in property <string> title;
    // Template text as typed, including text that does not apply. The field is kept in step with this value.
    in property <string> text;
    // Rows drawn under the Preview heading, one per preview track.
    in property <[EditorPreviewRow]> preview-rows: [];
    // One line per mistake of the open template. While any is present they replace the help under the field.
    in property <[string]> mistake-lines: [];
    // Signature of the call around the caret, such as tf(seconds, [format]). Shown only when has-help is true.
    in property <string> help-signature;
    // Sentence for the argument around the caret, shown under the signature.
    in property <string> help-description;
    // Whether the caret sits inside a call, so the help applies. Mistake lines take precedence over it.
    in property <bool> has-help: false;
    // Insertable fields listed under the Fields heading, one row each.
    in property <[EditorFieldRow]> fields: [];
    // Notes drawn under the preview, one paragraph each, in order.
    in property <[string]> notes: [];
    // Whether the Reset to default control is offered, which is when the text differs from the default.
    in property <bool> can-reset: false;

    // Fires after each edit and each caret or selection move. Arguments are the whole text, then the selection
    // start and end as UTF-8 byte offsets into that text. Slint 1.17 has no substring call, so the host converts
    // the offsets to the UTF-16 positions its state expects. Repeated reports with the same values are harmless.
    callback text-edited(string, int, int);
    // Fires with true when the template field gains keyboard focus and false when it loses focus.
    callback focus-changed(bool);
    // Fires with the index of a field row when the row is tapped, so the host inserts that field's call.
    callback insert-field(int);
    // Fires when the Reset to default control is tapped.
    callback reset();
    // Fires when the Back target in the header is tapped.
    callback back();

    // Glyph paths on a 24 by 24 grid, copied from TemplateEditorIcons.kt.
    // Back arrow shown in the header.
    property <string> back-path: "M20 11 H7.83 l5.59 -5.59 L12 4 l-8 8 8 8 l1.41 -1.41 L7.83 13 H20 v-2 Z";
    // Filled circle with an exclamation mark, shown beside each mistake line.
    property <string> error-path: "M12 2 C6.48 2 2 6.48 2 12 s4.48 10 10 10 s10 -4.48 10 -10 S17.52 2 12 2 Z "
        + "M13 17 h-2 v-2 h2 v2 Z M13 13 h-2 L11 7 h2 v6 Z";

    // Keeps the field in step with a text the host sets, such as a reset or an inserted field. Typed text
    // already matches the host's copy, so the comparison leaves the caret alone while the user types.
    changed text => {
        if (field-input.text != root.text) {
            field-input.text = root.text;
        }
    }

    // Sends the field's current text and both selection ends to the host, ordered so start is never past end.
    // The Android state reads the selection in that order.
    function report-selection() {
        root.text-edited(
            field-input.text,
            min(field-input.anchor-position-byte-offset, field-input.cursor-position-byte-offset),
            max(field-input.anchor-position-byte-offset, field-input.cursor-position-byte-offset),
        );
    }

    // Height of the area under the template field: the mistake lines when present, else the help, else nothing.
    property <length> supporting-height: root.mistake-lines.length > 0
        ? root.mistake-lines.length * 16px
        : (root.has-help ? 16px + help-description.preferred-height : 0px);

    // Header band with the Back target and the page title, as the Android destination header.
    Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: 72px;
        background: Theme.surface-high;

        // Circular hover and pressed layer, 40 px centered in the 48 px Back target.
        StateLayer {
            x: 20px;
            y: 16px;
            width: 40px;
            height: 40px;
            radius: 20px;
            tint: Theme.on-surface;
            hovered: back-touch.has-hover;
            pressed: back-touch.pressed;
        }
        Path {
            x: 28px;
            y: 24px;
            width: 24px;
            height: 24px;
            viewbox-width: 24;
            viewbox-height: 24;
            commands: root.back-path;
            fill: Theme.on-surface;
        }
        back-touch := TouchArea {
            x: 16px;
            y: 12px;
            width: 48px;
            height: 48px;
            mouse-cursor: pointer;
            clicked => { root.back(); }
        }
        Text {
            x: 72px;
            y: 0px;
            width: root.width - 72px - 16px;
            height: 72px;
            text: root.title;
            font-size: Theme.title-large;
            color: Theme.on-surface;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    // Divider under the header, one logical pixel in the outline role.
    Rectangle {
        x: 0px;
        y: 72px;
        width: root.width;
        height: 1px;
        background: Theme.outline;
    }

    // Body that scrolls below the header. Its content height is the stacked sections below.
    flick := Flickable {
        x: 0px;
        y: 73px;
        width: root.width;
        height: root.height - 73px;
        viewport-width: root.width;
        viewport-height: body.preferred-height;

        body := VerticalLayout {
            x: 0px;
            y: 0px;
            width: root.width;
            spacing: 0px;

            // Heading above the preview rows.
            Rectangle {
                height: 40px;
                Text {
                    x: 16px;
                    y: 16px;
                    width: parent.width - 32px;
                    height: 20px;
                    text: "Preview";
                    font-size: Theme.label-large;
                    font-weight: 500;
                    color: Theme.on-surface-variant;
                }
            }

            // One preview row: the title, and under it the applied line when the template yields one, then a divider.
            for row in root.preview-rows : Rectangle {
                height: 57px;
                title-text := Text {
                    x: 16px;
                    y: row.supporting == "" ? 16px : 8px;
                    width: parent.width - 32px;
                    height: 24px;
                    text: row.title;
                    font-size: Theme.body-large;
                    color: Theme.on-surface;
                    overflow: elide;
                }
                Text {
                    x: 16px;
                    y: 32px;
                    width: parent.width - 32px;
                    height: 16px;
                    visible: row.supporting != "";
                    text: row.supporting;
                    font-size: Theme.body-small;
                    color: Theme.on-surface-variant;
                    overflow: elide;
                }
                Rectangle {
                    x: 0px;
                    y: 56px;
                    width: parent.width;
                    height: 1px;
                    background: Theme.outline-variant;
                }
            }

            // Notes under the preview, each wrapped under the page inset with 8 px above it.
            for note in root.notes : Rectangle {
                height: 8px + note-text.preferred-height;
                note-text := Text {
                    x: 16px;
                    y: 8px;
                    width: parent.width - 32px;
                    text: note;
                    wrap: word-wrap;
                    font-size: Theme.body-small;
                    color: Theme.on-surface-variant;
                }
            }

            // Template field with its notched label, then the mistake lines or help under it.
            Rectangle {
                height: 8px + field-box.height + (root.supporting-height > 0px ? 4px + root.supporting-height : 0px);

                // Outline of the field, 4 px corners. The mistake state draws the error role at 2 px.
                field-box := Rectangle {
                    x: 16px;
                    y: 8px;
                    width: root.width - 32px;
                    height: max(56px, field-input.preferred-height + 16px);
                    border-radius: 4px;
                    border-width: root.mistake-lines.length > 0 || field-input.has-focus ? 2px : 1px;
                    border-color: root.mistake-lines.length > 0
                        ? Theme.error
                        : (field-input.has-focus ? Theme.primary : Theme.outline);
                }

                // Canvas-coloured patch that breaks the outline behind the label, as a floating label does.
                Rectangle {
                    x: field-box.x + 12px;
                    y: field-box.y - 8px;
                    width: template-label.preferred-width + 8px;
                    height: 16px;
                    background: Theme.canvas;
                    template-label := Text {
                        x: 4px;
                        y: 0px;
                        height: 16px;
                        text: "Template";
                        font-size: Theme.body-small;
                        vertical-alignment: center;
                        color: root.mistake-lines.length > 0
                            ? Theme.error
                            : (field-input.has-focus ? Theme.primary : Theme.on-surface-variant);
                    }
                }

                // The template text, monospace, which wraps onto more lines when it is long. Host text is copied
                // in here and the caret and selection are reported back to the host.
                field-input := TextInput {
                    x: field-box.x + 16px;
                    y: field-box.y + 8px;
                    width: field-box.width - 32px;
                    height: field-box.height - 16px;
                    font-family: "Noto Sans Mono";
                    font-size: Theme.body-large;
                    color: Theme.on-surface;
                    single-line: false;
                    wrap: word-wrap;
                    vertical-alignment: center;
                    init => {
                        self.text = root.text;
                    }
                    edited => {
                        root.report-selection();
                    }
                    changed cursor-position-byte-offset => {
                        root.report-selection();
                    }
                    changed anchor-position-byte-offset => {
                        root.report-selection();
                    }
                    changed has-focus => {
                        root.focus-changed(self.has-focus);
                    }
                }

                // Area under the field. Mistake lines use the error icon and text; help uses monospace signature and
                // the argument's sentence. The two never show together, and neither shows when both are empty.
                Rectangle {
                    x: 0px;
                    y: field-box.y + field-box.height + 4px;
                    width: root.width;
                    height: root.supporting-height;
                    clip: true;

                    for line[index] in root.mistake-lines : Rectangle {
                        x: 0px;
                        y: index * 16px;
                        width: parent.width;
                        height: 16px;
                        Path {
                            x: 32px;
                            y: 0px;
                            width: 16px;
                            height: 16px;
                            viewbox-width: 24;
                            viewbox-height: 24;
                            commands: root.error-path;
                            fill: Theme.error;
                        }
                        Text {
                            x: 52px;
                            y: 0px;
                            width: parent.width - 52px - 16px;
                            height: 16px;
                            text: line;
                            font-size: Theme.body-small;
                            color: Theme.error;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }

                    help-block := Rectangle {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        height: parent.height;
                        visible: root.has-help && root.mistake-lines.length == 0;
                        Text {
                            x: 32px;
                            y: 0px;
                            width: parent.width - 48px;
                            height: 16px;
                            text: root.help-signature;
                            font-family: "Noto Sans Mono";
                            font-size: Theme.body-small;
                            color: Theme.on-surface-variant;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        help-description := Text {
                            x: 32px;
                            y: 16px;
                            width: parent.width - 48px;
                            text: root.help-description;
                            wrap: word-wrap;
                            font-size: Theme.body-small;
                            color: Theme.on-surface-variant;
                        }
                    }
                }
            }

            // Heading above the insertable field rows.
            Rectangle {
                height: 40px;
                Text {
                    x: 16px;
                    y: 16px;
                    width: parent.width - 32px;
                    height: 20px;
                    text: "Fields";
                    font-size: Theme.label-large;
                    font-weight: 500;
                    color: Theme.on-surface-variant;
                }
            }

            // One field row: name and value on the left, the call to insert on the right. A tap inserts the call.
            for field[index] in root.fields : Rectangle {
                height: 65px;
                // Rectangular hover and pressed layer over the 64 px insert target, above the divider.
                StateLayer {
                    width: parent.width;
                    height: 64px;
                    tint: Theme.on-surface;
                    hovered: field-touch.has-hover;
                    pressed: field-touch.pressed;
                }
                headline := Text {
                    x: 16px;
                    y: 10px;
                    width: parent.width - 32px - insert-text.preferred-width - 16px;
                    height: 24px;
                    text: field.label;
                    font-size: Theme.body-large;
                    color: Theme.on-surface;
                    overflow: elide;
                }
                Text {
                    x: 16px;
                    y: 34px;
                    width: parent.width - 32px - insert-text.preferred-width - 16px;
                    height: 20px;
                    text: field.value == "" ? "No value yet" : field.value;
                    font-size: Theme.body-medium;
                    color: Theme.on-surface-variant;
                    overflow: elide;
                }
                insert-text := Text {
                    x: parent.width - 16px - self.preferred-width;
                    y: 0px;
                    height: 64px;
                    text: field.insert;
                    font-family: "Noto Sans Mono";
                    font-size: Theme.label-large;
                    color: Theme.on-surface-variant;
                    vertical-alignment: center;
                }
                Rectangle {
                    x: 0px;
                    y: 64px;
                    width: parent.width;
                    height: 1px;
                    background: Theme.outline-variant;
                }
                field-touch := TouchArea {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: 64px;
                    mouse-cursor: pointer;
                    clicked => { root.insert-field(index); }
                }
            }

            // Reset to default, offered only when the open template differs from its default.
            if root.can-reset : Rectangle {
                height: 72px;
                // Pill-shaped hover and pressed layer over the text button, matching its 48 px target.
                StateLayer {
                    x: 4px;
                    y: 8px;
                    width: reset-text.preferred-width + 24px;
                    height: 48px;
                    radius: 24px;
                    tint: Theme.on-surface;
                    hovered: reset-touch.has-hover;
                    pressed: reset-touch.pressed;
                }
                reset-text := Text {
                    x: 16px;
                    y: 8px;
                    height: 48px;
                    text: "Reset to default";
                    font-size: Theme.label-large;
                    font-weight: 500;
                    color: Theme.primary;
                    vertical-alignment: center;
                }
                reset-touch := TouchArea {
                    x: 4px;
                    y: 8px;
                    width: reset-text.preferred-width + 24px;
                    height: 48px;
                    mouse-cursor: pointer;
                    clicked => { root.reset(); }
                }
            }

            // Space after the last section so the page can scroll past it.
            Rectangle {
                height: 16px;
            }
        }
    }
}
