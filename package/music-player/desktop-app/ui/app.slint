// The player window: a seek bar on top, a volume slider, and one combined
// control row (left to right: Settings and Open buttons, a three-state shuffle radio group
// (Off / Within page / All), the transport buttons prev / play-pause / next, and
// a "repeat track" checkbox; the checkbox is the native std-widgets CheckBox and
// the shuffle radio is a custom control styled to echo Fluent's radio, since Slint
// ships no standalone RadioButton), then the scrolling queue area. A width
// breakpoint switches its shape:
// when the window has room the page-tab bar and selected-page track list sit side
// by side as two INDEPENDENT scroll containers (each with its own Flickable and
// scrollbar, so a long list never scrolls the tab bar away and vice versa); when
// it does not, they collapse into the old vertical tab-then-list order under one
// shared Flickable and scrollbar. No hidden page picker or click-triggered layout
// jump is introduced. The queue is paginated on two axes (decided per track in Rust): a
// track in a subfolder gets a page per top-level folder under the loaded root
// (one level only; the tab is that folder); a track at the loaded root gets a
// first-letter page (A-Z, plus a `#` catch-all). The list shows only the selected
// page's tracks, each row showing its path relative to the loaded root (so deeper
// nesting stays visible). The shuffle mode also chooses what playback loops over
// (Off/Within page stay inside the current page; All spans the whole queue); that
// logic lives in Rust. The currently playing (and selected) track is the
// highlighted row, so no separate now-playing title is drawn; a single click
// selects a row (loading it paused), and a click on the already-highlighted row
// toggles play/pause. The window title mirrors the playing track and reverts to
// "Music Player" when paused. All state comes IN from Rust via properties; all
// user actions go OUT to Rust via callbacks. No playback logic (including the
// pagination grouping) lives here.
//
// Numeric time values (position/duration) are kept as `float` seconds for the
// slider, while their human-readable "m:ss" forms arrive as separate string
// properties formatted in Rust (Slint's number formatting is awkward).

import { Button, CheckBox, Slider, HorizontalBox, VerticalBox, Palette } from "std-widgets.slint";

// One shared text size for every hand-drawn Text in this file, kept equal to the
// Fluent std-widgets' body text so custom Text never sits a notch below the Button
// and Slider labels. The std-widgets expose no font-size property, so matching them
// means matching their size expression: FluentFontSettings.body.font-size is
// 14 * 0.0769rem (i-slint-compiler/widgets/fluent/styling.slint). rem tracks the
// window default-font-size, so this still scales with the OS/user font setting.
//
// The multiple is stored unitless (14 * 0.0769) and each use site writes
// `Typography.body-rem * 1rem`, because rem cannot be resolved inside a `global`
// (the window default-font-size is unknown there; slint-viewer --check rejects a
// rem-typed global length). The 1rem is applied at the element, where the window
// context exists. Full rationale: doc/troubleshooting/slint-widget-font-size-rem.md.
global Typography {
    out property <float> body-rem: 14 * 0.0769;
}

// One row on the selected page: the display path (relative to the loaded root)
// plus its index into the full queue. The index survives filtering, so clicking a
// filtered row still maps back to the right track. Rust fills these from the
// pagination module.
struct PageItem {
    name: string,
    index: int,
}

// A radio button drawn like a plain HTML <input type="radio">: a small ring that
// shows a filled centre dot when selected, with a label to its right. The whole
// row is clickable. The root is a Rectangle wrapping a HorizontalLayout (which
// gives the component its content-derived size) plus a TouchArea overlay that
// captures the click. Used for the three-state shuffle control.
component RadioButton inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    in property <bool> large-target: false;
    callback clicked();
    horizontal-stretch: 0;
    height: root.large-target ? 48px : 20px;
    preferred-height: root.height;

    HorizontalLayout {
        spacing: 8px;
        alignment: start;
        // The ring, centred vertically against the label. Styled to echo Fluent's
        // own radio (widgets/fluent/radiogroup.slint): a 20px circle with a 1px
        // stroke that, when selected, becomes an accent "donut", a 6px accent ring
        // around a centre painted the window's background. Fluent's internal colours
        // are not on the public Palette, so they map onto it here:
        // control-strong-stroke -> foreground.with-alpha(0.6) (60% ink, matching
        // Fluent's #FFFFFF99 / #00000099; plain Palette.border is only ~8% alpha in
        // dark mode, which on the pure-black window background reads at ~1.1:1 and
        // fails contrast), then control-alt-secondary -> control-background and
        // state-secondary -> the window background. Keeps the radio consistent with
        // the native CheckBox beside it.
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 20px;
                height: self.width;
                border-radius: self.width / 2;
                border-width: 1px;
                border-color: ta.has-hover ? Palette.accent-background : Palette.foreground.with-alpha(0.6);
                background: root.selected ? transparent : Palette.control-background;
                animate border-color, background { duration: 150ms; }
                Rectangle {
                    width: parent.width;
                    height: self.width;
                    border-radius: self.width / 2;
                    border-width: root.selected ? 6px : 0px;
                    border-color: root.selected ? Palette.accent-background : transparent;
                    background: root.selected
                        ? (Palette.color-scheme == ColorScheme.dark ? #000000 : Palette.background)
                        : transparent;
                    animate border-width { duration: 150ms; }
                }
            }
        }
        Text {
            text: root.text;
            font-size: Typography.body-rem * 1rem;
            vertical-alignment: center;
            color: Palette.foreground;
        }
    }
    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// A Material Design 1 tab: a flat 48px-high text target with a 2px accent
// indicator along the bottom when selected. PageControls lays these out in a
// wrapping grid instead of the single scrolling row used by the original MD1
// component, keeping every page visible.
component Md1Tab inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked();
    horizontal-stretch: 0;
    width: tab-label.preferred-width + 24px;
    height: 48px;
    preferred-height: 48px;
    background: transparent;

    tab-label := Text {
        x: 12px;
        width: parent.width - 24px;
        height: parent.height - 2px;
        text: root.text;
        font-size: Typography.body-rem * 1rem;
        vertical-alignment: center;
        horizontal-alignment: center;
        color: Palette.foreground;
    }
    Rectangle {
        y: parent.height - 2px;
        width: parent.width;
        height: 2px;
        background: root.selected ? Palette.accent-background : transparent;
    }
    TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// A content-width section in one joined segmented control. Adjacent sections
// have no gap, and one-sided divider lines keep every seam a consistent width.
component SegmentedButton inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked();
    horizontal-stretch: 0;
    width: segment-label.preferred-width + 32px;
    height: 48px;
    preferred-height: 48px;
    border-width: 1px;
    border-color: Palette.foreground;
    background: root.selected ? Palette.accent-background : Palette.control-background;

    segment-label := Text {
        x: 16px;
        width: parent.width - 32px;
        height: parent.height;
        text: root.text;
        font-size: Typography.body-rem * 1rem;
        vertical-alignment: center;
        horizontal-alignment: center;
        color: root.selected ? Palette.accent-foreground : Palette.foreground;
    }
    TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// A wrapping segmented group whose transparent remainder never resembles a
// full-width segment. Each naturally sized segment paints its own outline.
component SegmentedControls inherits Rectangle {
    in property <[string]> labels;
    in property <int> selected-page;
    callback select-page(int);
    height: segment-layout.preferred-height;
    preferred-height: segment-layout.preferred-height;
    background: transparent;

    segment-layout := FlexboxLayout {
        width: parent.width;
        flex-wrap: wrap;
        alignment: start;
        align-content: start;
        cross-axis-alignment: start;
        vertical-stretch: 0;
        for label[p] in root.labels: SegmentedButton {
            text: label;
            selected: p == root.selected-page;
            clicked => {
                root.select-page(p);
            }
        }
    }
}

// A hardware page button adapted from the supplied LED segmented-control master.
// Each control is a content-width metal island so Slint's wrapping layout never
// paints unused row width. The 60px plate keeps the source's 8px margin around
// a 44px cap; inactive plastic reflects ambient light, while selection insets
// the rigid cap by 2px and switches on purple cap and legend LEDs.
component LedSegmentButton inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked();
    horizontal-stretch: 0;
    width: min(led-label.preferred-width + 48px, root.max-width);
    height: 60px;
    preferred-height: 60px;
    background: transparent;

    plate := Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: 17px;
        clip: true;
        background: @linear-gradient(
            135deg,
            #212121 0%,
            #141414 30%,
            #111111 55%,
            #0d0d0d 100%
        );
        inner-shadow-offset-x: 3px;
        inner-shadow-offset-y: 3px;
        inner-shadow-blur: 6px;
        inner-shadow-color: #00000057;

        // Seeded-looking micro highlights suggest a bead-blasted plate without
        // requiring a raster tile that would scale differently across renderers.
        Rectangle { x: parent.width * 0.18; y: parent.height * 0.22; width: 1px; height: 1px; background: #ffffff14; }
        Rectangle { x: parent.width * 0.42; y: parent.height * 0.68; width: 1px; height: 1px; background: #ffffff10; }
        Rectangle { x: parent.width * 0.71; y: parent.height * 0.28; width: 1px; height: 1px; background: #ffffff18; }
        Rectangle { x: parent.width * 0.86; y: parent.height * 0.72; width: 1px; height: 1px; background: #ffffff0f; }
    }

    opening := Rectangle {
        x: 8px;
        y: 8px;
        width: parent.width - 16px;
        height: 44px;
        border-radius: 10px;
        background: root.selected ? #030304 : #050506;
    }

    cap-face := Rectangle {
        x: root.selected ? 10px : 8px;
        y: root.selected ? 10px : 8px;
        width: parent.width - (root.selected ? 20px : 16px);
        height: root.selected ? 40px : 44px;
        border-radius: root.selected ? 7px : 9px;
        background: root.selected
            ? @radial-gradient(circle, #ffffff5c 0%, #a63fd0 58%, #782597 100%)
            : @radial-gradient(circle, #ffffff36 0%, #aaaaaa 58%, #747474 100%);
        drop-shadow-offset-x: root.selected ? 0px : 2.5px;
        drop-shadow-offset-y: root.selected ? 0px : 3.5px;
        drop-shadow-blur: root.selected ? 10px : 5px;
        drop-shadow-color: root.selected ? #c874ea73 : #0000006b;
        animate x, y, width, height, background, drop-shadow-color {
            duration: 160ms;
            easing: ease;
        }
    }

    Rectangle {
        x: cap-face.x;
        y: cap-face.y;
        width: cap-face.width;
        height: cap-face.height;
        border-radius: cap-face.border-radius;
        background: @linear-gradient(
            135deg,
            #ffffff38 0%,
            #ffffff1f 25%,
            #ffffff08 45%,
            #0000000a 55%,
            #0000002e 75%,
            #00000052 100%
        );
    }

    if root.selected: Rectangle {
        x: cap-face.x;
        y: cap-face.y;
        width: cap-face.width;
        height: 4px;
        background: @linear-gradient(180deg, #00000073 0%, transparent 100%);
    }
    if root.selected: Rectangle {
        x: cap-face.x;
        y: cap-face.y;
        width: 4px;
        height: cap-face.height;
        background: @linear-gradient(90deg, #00000073 0%, transparent 100%);
    }

    if root.selected: Text {
        x: 23px;
        y: 9px;
        width: parent.width - 46px;
        height: 46px;
        text: root.text;
        font-size: Typography.body-rem * 1rem + 1px;
        font-weight: 600;
        vertical-alignment: center;
        horizontal-alignment: center;
        overflow: elide;
        color: #f0d4ff80;
    }

    led-label := Text {
        x: 24px;
        y: root.selected ? 10px : 8px;
        width: parent.width - 48px;
        height: 44px;
        text: root.text;
        font-size: Typography.body-rem * 1rem;
        font-weight: 600;
        vertical-alignment: center;
        horizontal-alignment: center;
        overflow: elide;
        color: root.selected ? #ffffff : #3d3f45;
        animate y, color { duration: 160ms; easing: ease; }
    }

    TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// Wrapping LED controls stay content-width and leave every unused row pixel
// transparent. Independent metal islands preserve whole-control wrapping even
// though Slint does not expose wrapped-row boundaries for one shared plate.
component LedSegmentControls inherits Rectangle {
    in property <[string]> labels;
    in property <int> selected-page;
    callback select-page(int);
    height: led-layout.preferred-height;
    preferred-height: led-layout.preferred-height;
    background: transparent;

    led-layout := FlexboxLayout {
        width: parent.width;
        spacing-horizontal: 8px;
        spacing-vertical: 8px;
        flex-wrap: wrap;
        alignment: start;
        align-content: start;
        cross-axis-alignment: start;
        vertical-stretch: 0;
        for label[p] in root.labels: LedSegmentButton {
            text: label;
            selected: p == root.selected-page;
            max-width: root.width;
            clicked => {
                root.select-page(p);
            }
        }
    }
}

// Chromium's logical metrics: a 35px tab below 6px strip padding,
// 10px top corners, 12px outward shoulders, 1px contour, and 20px insets.
component ChromiumTab inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    in property <bool> show-divider;
    callback clicked();
    private property <color> active-color: Palette.accent-background.with-alpha(0.2);
    private property <color> active-outline-color: Palette.accent-background.with-alpha(0.65);
    private property <color> divider-color: Palette.foreground.with-alpha(0.25);
    private property <color> ink-color: Palette.foreground;
    horizontal-stretch: 0;
    width: min(chromium-label.preferred-width + 40px, root.max-width);
    height: 41px;
    preferred-height: 41px;
    background: transparent;

    if !root.selected && chromium-touch.has-hover: Rectangle {
        x: 12px;
        y: 6px;
        width: parent.width - 24px;
        height: 35px;
        border-radius: 10px;
        background: Palette.accent-background.with-alpha(0.12);
    }

    if root.selected: Path {
        y: 6px;
        width: parent.width;
        height: 35px;
        viewbox-width: root.width / 1px;
        viewbox-height: 35;
        fit: fill;
        fill: root.active-color;
        MoveTo { x: 0; y: 35; }
        CubicTo { control-1-x: 6; control-1-y: 35; control-2-x: 12; control-2-y: 29; x: 12; y: 23; }
        LineTo { x: 12; y: 10; }
        QuadraticTo { control-x: 12; control-y: 0; x: 22; y: 0; }
        LineTo { x: root.width / 1px - 22; y: 0; }
        QuadraticTo {
            control-x: root.width / 1px - 12;
            control-y: 0;
            x: root.width / 1px - 12;
            y: 10;
        }
        LineTo { x: root.width / 1px - 12; y: 23; }
        CubicTo {
            control-1-x: root.width / 1px - 12;
            control-1-y: 29;
            control-2-x: root.width / 1px - 6;
            control-2-y: 35;
            x: root.width / 1px;
            y: 35;
        }
        LineTo { x: 0; y: 35; }
        Close {}
    }

    if root.selected: Path {
        y: 6px;
        width: parent.width;
        height: 35px;
        viewbox-width: root.width / 1px;
        viewbox-height: 35;
        fit: fill;
        fill: transparent;
        stroke: root.active-outline-color;
        stroke-width: 1px;
        stroke-line-cap: round;
        MoveTo { x: 0; y: 35; }
        CubicTo { control-1-x: 6; control-1-y: 35; control-2-x: 12; control-2-y: 29; x: 12; y: 23; }
        LineTo { x: 12; y: 10; }
        QuadraticTo { control-x: 12; control-y: 0; x: 22; y: 0; }
        LineTo { x: root.width / 1px - 22; y: 0; }
        QuadraticTo {
            control-x: root.width / 1px - 12;
            control-y: 0;
            x: root.width / 1px - 12;
            y: 10;
        }
        LineTo { x: root.width / 1px - 12; y: 23; }
        CubicTo {
            control-1-x: root.width / 1px - 12;
            control-1-y: 29;
            control-2-x: root.width / 1px - 6;
            control-2-y: 35;
            x: root.width / 1px;
            y: 35;
        }
    }

    if !root.selected: Rectangle {
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: root.divider-color;
    }

    if !root.selected && root.show-divider: Rectangle {
        x: parent.width - 1px;
        y: 16px;
        width: 2px;
        height: 16px;
        border-radius: 1px;
        background: root.divider-color;
    }

    chromium-label := Text {
        x: 20px;
        y: 6px;
        width: parent.width - 40px;
        height: 35px;
        text: root.text;
        font-size: 13px;
        vertical-alignment: center;
        horizontal-alignment: left;
        overflow: elide;
        color: root.ink-color;
    }

    chromium-touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// A full-width Chromium tab strip with content-width tabs. Whole tabs wrap
// between rows while strip paint remains behind unused row space.
component ChromiumControls inherits Rectangle {
    in property <[string]> labels;
    in property <int> selected-page;
    callback select-page(int);
    height: chromium-layout.preferred-height;
    preferred-height: chromium-layout.preferred-height;
    background: Palette.color-scheme == ColorScheme.dark ? #000000 : Palette.background;

    chromium-layout := FlexboxLayout {
        width: parent.width;
        flex-wrap: wrap;
        alignment: start;
        align-content: start;
        cross-axis-alignment: start;
        vertical-stretch: 0;
        for label[p] in root.labels: ChromiumTab {
            text: label;
            selected: p == root.selected-page;
            show-divider: p < root.labels.length - 1 && p + 1 != root.selected-page;
            max-width: root.width;
            clicked => {
                root.select-page(p);
            }
        }
    }
}

// One page selector with six user-selectable visual styles. Style 0 is the
// default radio control, style 1 is a wrapping MD1 tab grid, style 2 keeps
// the previous rounded button grid, style 3 joins content-width segments,
// style 4 uses raised Chromium-like tabs, and style 5 uses LED hardware caps.
component PageControls inherits VerticalLayout {
    in property <[string]> labels;
    in property <int> selected-page;
    in property <int> control-style;
    callback select-page(int);
    alignment: start;

    if root.control-style == 0: FlexboxLayout {
        spacing-horizontal: 12px;
        spacing-vertical: 4px;
        flex-wrap: wrap;
        alignment: start;
        align-content: start;
        cross-axis-alignment: start;
        vertical-stretch: 0;
        for label[p] in root.labels: RadioButton {
            text: label;
            selected: p == root.selected-page;
            large-target: true;
            clicked => {
                root.select-page(p);
            }
        }
    }
    if root.control-style == 1: FlexboxLayout {
        flex-wrap: wrap;
        alignment: start;
        align-content: start;
        cross-axis-alignment: start;
        vertical-stretch: 0;
        for label[p] in root.labels: Md1Tab {
            text: label;
            selected: p == root.selected-page;
            clicked => {
                root.select-page(p);
            }
        }
    }
    if root.control-style == 2: FlexboxLayout {
        spacing: 4px;
        flex-wrap: wrap;
        alignment: start;
        align-content: start;
        cross-axis-alignment: start;
        vertical-stretch: 0;
        for label[p] in root.labels: Button {
            text: label;
            primary: p == root.selected-page;
            clicked => {
                root.select-page(p);
            }
        }
    }
    if root.control-style == 3: SegmentedControls {
        labels: root.labels;
        selected-page: root.selected-page;
        select-page(p) => {
            root.select-page(p);
        }
    }
    if root.control-style == 4: ChromiumControls {
        labels: root.labels;
        selected-page: root.selected-page;
        select-page(p) => {
            root.select-page(p);
        }
    }
    if root.control-style == 5: LedSegmentControls {
        labels: root.labels;
        selected-page: root.selected-page;
        select-page(p) => {
            root.select-page(p);
        }
    }
}

// A prominent vertical scrollbar that drives a Flickable's viewport. It is drawn
// deliberately wide and high-contrast (a visible track Rectangle plus a rounded
// thumb), unlike the thin near-invisible default std-widgets bar. `maximum` is
// the largest scroll distance (the content height minus the visible height);
// `page-size` is the visible height; `value` two-way binds to the Flickable's
// `viewport-y` (which Slint keeps <= 0, scrolling up as it grows negative). The
// thumb's height is the visible fraction of the content, and dragging it moves
// the viewport proportionally. Mirrors the Slint energy-monitor demo's
// ScrollBar, turned vertical and made bolder.
component VScrollBar inherits Rectangle {
    in property <length> page-size;
    in property <length> maximum;
    in-out property <length> value;

    // a wide gutter so the bar reads as a real scrollbar, not a hairline
    width: 14px;
    // only worth showing once the content actually overflows the viewport
    visible: root.maximum > 0;
    // theme-tinted translucent track: white at 10% alpha on a dark scheme,
    // black at 10% alpha on a light scheme (the unknown scheme falls back to dark-on-light)
    background: Palette.color-scheme == ColorScheme.dark ? #ffffff.with-alpha(0.1) : #000000.with-alpha(0.1);
    border-radius: 7px;

    // the draggable thumb: its length is the visible fraction of the content,
    // and its position tracks how far we have scrolled. Accent-tinted so it reads
    // as the active control: 60% accent alpha at rest, 80% on hover, full accent
    // while grabbed.
    thumb := Rectangle {
        x: 2px;
        width: parent.width - 4px;
        height: max(32px, (parent.height - 4px) * root.page-size / (root.maximum + root.page-size));
        y: 2px + (parent.height - 4px - self.height) * (-root.value / root.maximum);
        background: ta.pressed ? Palette.accent-background : ta.has-hover ? Palette.accent-background.with-alpha(0.8) : Palette.accent-background.with-alpha(0.6);
        border-radius: self.width / 2;
    }

    // the drag handler fills the whole bar as a sibling of the thumb, never a
    // child of it. A TouchArea nested inside the thumb moves with the thumb as the
    // thumb chases the pointer, so its mouse-y is measured in a frame that follows
    // the drag, which halves the apparent travel (1cm mouse to 0.5cm thumb).
    // Anchored to the static bar instead, mouse-y is absolute and the thumb tracks
    // the pointer 1:1. Mirrors the Slint energy-monitor ScrollBar, whose
    // i-touch-area is likewise a sibling of i-handle filling the bar
    // (demos/energy-monitor/ui/widgets/scroll_view.slint).
    ta := TouchArea {
        // remember where the viewport sat when the drag began, so movement
        // is measured relative to the press point (no jump on grab)
        property <length> pressed-value;
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                self.pressed-value = -root.value;
            }
        }
        moved => {
            if (self.pressed) {
                root.value = -max(0px, min(root.maximum, self.pressed-value
                    + (self.mouse-y - self.pressed-y) * (root.maximum / (root.height - 4px - thumb.height))));
            }
        }
    }
}

export component AppWindow inherits Window {
    // Window title: the playing track's list path (folder/.../file, the same string
    // the queue row shows) while audio is playing, plain "Music Player" when paused
    // or idle. Bound to `playing` + `track-name` (both pushed from Rust), so the
    // taskbar / window-list entry shows the song only during active playback and
    // reverts the moment it pauses.
    title: root.playing && root.track-name != "" ? root.track-name : "Music Player";
    preferred-width: 480px;
    preferred-height: 600px;

    // Global 10% type-scale reduction that still honours the OS UI-font setting.
    // Every font is a rem multiple of the window default-font-size: the hand-drawn
    // Text (Typography.body-rem * 1rem) and the native widgets (Button / CheckBox /
    // Slider), whose only font-size lever is rem. Rust sets `base-font-size` to
    // 0.9 * the OS font; `default-font-size` binds to it, and 0 falls back to the
    // platform font, so nothing breaks before Rust runs. The OS font is not known at
    // startup, because Slint reads it from the desktop portal asynchronously
    // (i-slint-backend-winit xdg_desktop_settings.rs), so `os-font-size` (= 1rem, the
    // resolved platform font while base is 0) changes once the portal responds, and
    // `changed os-font-size` hands the real value to Rust, which applies the 0.9 a
    // single time (guarded). A relative `default-font-size: 0.9rem` is a binding loop
    // (rem resolves against this very property), which is why the scale is applied
    // from Rust. See doc/troubleshooting/slint-rem-binding-loop.md.
    in property <length> base-font-size;
    default-font-size: root.base-font-size;
    out property <length> os-font-size: 1rem;
    callback probe-os-font(length);
    changed os-font-size => {
        root.probe-os-font(root.os-font-size);
    }

    // Pure black under dark mode (OLED-friendly, maximum contrast) instead of the
    // style's near-black Palette.background; light mode keeps the adaptive default.
    background: Palette.color-scheme == ColorScheme.dark ? #000000 : Palette.background;

    // Inputs from Rust (the engine pushes these via Update messages).
    in property <string> track-name: "";
    // Two-way (`in-out`) because the seek Slider two-way binds its `value` to this
    // property. Slint breaks a ONE-WAY binding the first time the user interacts with
    // the slider (a drag/click/key runs an imperative `set-value`, and "if a property's
    // value is later changed using an imperative assignment, the original binding is
    // broken"), which froze the seek bar while audio kept playing. A two-way `<=>` alias
    // survives user input, so engine `Update::Position` writes keep moving the thumb.
    in-out property <float> position: 0;
    in property <float> duration: 0;
    in property <string> position-text: "0:00";
    in property <string> duration-text: "0:00";
    in property <bool> playing: false;
    // Two-way (`in-out`) for the same reason as `position`: the volume Slider two-way
    // binds its `value` here, so a one-way binding would break on the first user drag and
    // stop reflecting engine/restored volume changes.
    in-out property <float> volume: 1.0;
    // Shuffle mode as an int the radio group compares against: 0 = off,
    // 1 = within page, 2 = all. Off/within-page confine playback to the current
    // page; all spans the whole queue (the scope logic lives in Rust).
    in property <int> shuffle-mode: 0;
    // Whether "repeat track" is on (replay the current track on its natural end).
    // Two-way (`in-out`) for the same reason as `volume`/`position`: the native
    // CheckBox flips its own `checked` with an imperative assignment on click
    // (widgets/fluent/checkbox.slint), which would break a one-way binding (see
    // doc/troubleshooting/slint-slider-binding-breaks-on-input.md); a two-way
    // `<=>` alias survives that, so engine updates keep moving the checkbox.
    in-out property <bool> repeat-track: false;
    in property <int> current-index: -1;
    in property <[string]> queue: [];

    // Pagination view, derived in Rust from `queue`. `page-labels` are the tab
    // captions (a top-level folder, an A-Z letter, or `#`; folder pages first,
    // then letters, then `#`); `selected-page` is the index of the visible tab;
    // `page-items` are only the selected page's tracks.
    in property <[string]> page-labels: [];
    in property <int> selected-page: 0;
    in property <[PageItem]> page-items: [];
    // Page selector style: 0 = radio controls, 1 = multi-row MD1 tabs,
    // 2 = the previous rounded buttons, 3 = segmented buttons,
    // 4 = Chromium-like tabs, 5 = super fun LED segmented buttons.
    // Rust restores and persists this value.
    in-out property <int> page-control-style: 0;
    // Settings is a local navigation page, not playback state.
    in-out property <bool> show-settings: false;

    // Outputs to Rust (each maps to one engine Command).
    callback toggle-play();
    callback prev();
    callback next();
    callback seek(float);
    callback set-volume(float);
    // The user picked a shuffle radio; the argument is the mode int (0/1/2).
    callback set-shuffle-mode(int);
    // The user toggled the repeat-track checkbox; the argument is the new state.
    callback set-repeat-track(bool);
    // A single click on an UNSELECTED row selects it: Rust makes it current and
    // loads it paused (pausing whatever was playing). A click on the already-current
    // row instead toggles play/pause (see the row handler below). The argument is
    // the track's full-queue index.
    callback select-index(int);
    callback open-files();
    // Persist a page-control style selected on the settings page.
    callback set-page-control-style(int);
    // The user clicked a page tab; the argument is the page index. Rust swaps the
    // visible page (refills `page-items` and updates `selected-page`).
    callback select-page(int);

    VerticalBox {
        padding: 12px;
        spacing: 8px;

        HorizontalBox {
            alignment: stretch;
            Text {
                text: root.position-text;
                font-size: Typography.body-rem * 1rem;
                vertical-alignment: center;
            }
            // `seek-slider :=` gives this element a stable id so the embedded MCP
            // server (`find_elements_by_id "AppWindow::seek-slider"`) and the
            // ElementHandle regression test can target the seek bar specifically.
            seek-slider := Slider {
                horizontal-stretch: 1;
                minimum: 0;
                maximum: root.duration > 0 ? root.duration : 1.0;
                value <=> root.position;
                changed(value) => {
                    root.seek(value);
                }
            }
            Text {
                text: root.duration-text;
                font-size: Typography.body-rem * 1rem;
                vertical-alignment: center;
            }
        }

        HorizontalBox {
            Text {
                text: "Volume";
                font-size: Typography.body-rem * 1rem;
                vertical-alignment: center;
            }
            // `volume-slider :=` gives this element a stable id for the same reason as
            // the seek slider: MCP `find_elements_by_id "AppWindow::volume-slider"`
            // and the ElementHandle regression test target it directly.
            volume-slider := Slider {
                horizontal-stretch: 1;
                minimum: 0;
                maximum: 1.0;
                value <=> root.volume;
                changed(value) => {
                    root.set-volume(value);
                }
            }
        }

        // Combined control row, left to right: an Open button, the three-state
        // shuffle radio group (a "Shuffle" label then Off / Within page / All),
        // the transport buttons (prev / play-pause / next), and a "repeat track"
        // checkbox. The radio and checkbox are plain-HTML-styled custom
        // components. A FlexboxLayout (the same experimental builtin the page-tab
        // bar uses, enabled via SLINT_ENABLE_EXPERIMENTAL_FEATURES in the
        // Containerfile) lays the four groups left-to-right and wraps them onto
        // more rows when the window is too narrow. Each group is wrapped in its
        // own HorizontalLayout so a wrap never splits a group. alignment:
        // space-between is taffy's justify-content: space-between, and
        // spacing-horizontal: 48px is taffy's column gap, which acts as the
        // minimum: space-between only ADDS free space on top of the gap, so the
        // groups spread across the row yet never sit closer than 48px (verified
        // against the slint clone's internal/core/layout.rs:1495-1524, where
        // alignment maps to justify_content and spacing-h/v map to the taffy gap
        // independently). spacing-vertical: 8px is the gap between wrapped rows;
        // cross-axis-alignment: center vertically centres each group against the
        // tallest in its row; vertical-stretch: 0 keeps the row at its wrapped height (the
        // queue region below absorbs the vertical slack).
        FlexboxLayout {
            flex-wrap: wrap;
            alignment: space-between;
            cross-axis-alignment: center;
            spacing-horizontal: 48px;
            spacing-vertical: 8px;
            vertical-stretch: 0;
            Button {
                text: "Settings";
                primary: root.show-settings;
                clicked => {
                    root.show-settings = true;
                }
            }
            Button {
                text: "Open";
                // Highlight (accent style) when the queue is empty, so a fresh
                // launch points the user at the only useful action.
                primary: root.queue.length == 0;
                clicked => {
                    root.open-files();
                }
            }
            // shuffle group: the label plus the three mutually-exclusive radios,
            // kept together as one flex item so wrapping never splits them
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: "Shuffle";
                    font-size: Typography.body-rem * 1rem;
                    vertical-alignment: center;
                    color: Palette.foreground;
                }
                RadioButton {
                    text: "Off";
                    selected: root.shuffle-mode == 0;
                    clicked => {
                        root.set-shuffle-mode(0);
                    }
                }
                RadioButton {
                    text: "Within page";
                    selected: root.shuffle-mode == 1;
                    clicked => {
                        root.set-shuffle-mode(1);
                    }
                }
                RadioButton {
                    text: "All";
                    selected: root.shuffle-mode == 2;
                    clicked => {
                        root.set-shuffle-mode(2);
                    }
                }
            }
            // transport group: prev / play-pause / next, one flex item
            HorizontalLayout {
                spacing: 8px;
                Button {
                    text: "Prev";
                    clicked => {
                        root.prev();
                    }
                }
                Button {
                    text: root.playing ? "Pause" : "Play";
                    clicked => {
                        root.toggle-play();
                    }
                }
                Button {
                    text: "Next";
                    clicked => {
                        root.next();
                    }
                }
            }
            CheckBox {
                text: "Repeat track";
                // Native CheckBox owns its `checked` and flips it on click, so bind
                // two-way; `toggled` then fires with the new value already in place.
                checked <=> root.repeat-track;
                toggled => {
                    root.set-repeat-track(root.repeat-track);
                }
            }
        }

        // 32px gap between the control row and the queue area below. The spacer
        // is 16px because the enclosing VerticalBox adds its own 8px spacing on
        // each side of the spacer (8 + 16 + 8 = 32), so the visible gap is 32px
        // while the 8px rhythm between the rows above is left untouched.
        // vertical-stretch: 0 keeps it fixed; the queue Rectangle (stretch 1)
        // absorbs all vertical slack, so the spacer never grows.
        Rectangle {
            height: 16px;
            vertical-stretch: 0;
        }

        // Queue area. The width breakpoint splits both geometry AND scrolling.
        //
        // Wide (>= 900px): the page-tab bar and the track list are two
        // INDEPENDENT scroll containers side by side, each with its own
        // Flickable and VScrollBar. A long track list scrolls under its own bar
        // without moving the tab bar (and a tall tab grid scrolls without moving
        // the list). Each Flickable fills the queue height and scrolls only its
        // own content.
        //
        // Narrow (< 900px): one shared Flickable keeps the original vertical
        // tab-then-list order under a single scrollbar.
        //
        // Every Flickable wraps its content in a VerticalLayout (alignment:
        // start) and pins viewport-width to self.width. The wrapping page-tab
        // FlexboxLayout must not be a Flickable's bare content root: its wrapped
        // cross-axis height depends on its assigned width, and a bare flex root
        // makes the viewport/content size binding loop. Wrapping it keeps the
        // geometry top-down and analysable by Slint's layout-info pass. The 18px
        // reserved on each Flickable's right edge is the scrollbar gutter.
        Rectangle {
            vertical-stretch: 1;

            // Settings page. Each choice applies immediately and is persisted by
            // Rust; Back returns to the library without changing playback.
            if root.show-settings: VerticalLayout {
                alignment: start;
                spacing: 8px;
                Text {
                    text: "Page controls";
                    font-size: 1.4 * Typography.body-rem * 1rem;
                    color: Palette.foreground;
                }
                Text {
                    text: "Choose how library pages are shown.";
                    font-size: Typography.body-rem * 1rem;
                    color: Palette.foreground;
                }
                RadioButton {
                    text: "Radio controls";
                    selected: root.page-control-style == 0;
                    large-target: true;
                    clicked => {
                        root.page-control-style = 0;
                        root.set-page-control-style(0);
                    }
                }
                RadioButton {
                    text: "Multi-row MD1 tabs";
                    selected: root.page-control-style == 1;
                    large-target: true;
                    clicked => {
                        root.page-control-style = 1;
                        root.set-page-control-style(1);
                    }
                }
                RadioButton {
                    text: "Rounded buttons";
                    selected: root.page-control-style == 2;
                    large-target: true;
                    clicked => {
                        root.page-control-style = 2;
                        root.set-page-control-style(2);
                    }
                }
                RadioButton {
                    text: "Segmented buttons";
                    selected: root.page-control-style == 3;
                    large-target: true;
                    clicked => {
                        root.page-control-style = 3;
                        root.set-page-control-style(3);
                    }
                }
                RadioButton {
                    text: "Super fun LED segmented buttons";
                    selected: root.page-control-style == 5;
                    large-target: true;
                    clicked => {
                        root.page-control-style = 5;
                        root.set-page-control-style(5);
                    }
                }
                RadioButton {
                    text: "Chromium-like tabs";
                    selected: root.page-control-style == 4;
                    large-target: true;
                    clicked => {
                        root.page-control-style = 4;
                        root.set-page-control-style(4);
                    }
                }
                Button {
                    text: "Back to library";
                    clicked => {
                        root.show-settings = false;
                    }
                }
            }

            // Wide: two independent scroll containers.
            if !root.show-settings && root.width >= 900px: HorizontalLayout {
                spacing: 24px;
                alignment: stretch;

                // Left scroll container: the page-tab bar (one tab per page, a
                // top-level folder or a letter). Present only when there are
                // pages, so an empty library leaves the full width to the list.
                if root.page-labels.length > 0: Rectangle {
                    min-width: 320px;
                    preferred-width: 480px;
                    horizontal-stretch: 1;
                    tabsFlick := Flickable {
                        x: 0px;
                        y: 0px;
                        width: max(0px, parent.width - 18px);
                        height: parent.height;
                        viewport-width: self.width;
                        viewport-height: tabsContent.preferred-height;
                        tabsContent := VerticalLayout {
                            alignment: start;
                            PageControls {
                                labels: root.page-labels;
                                selected-page: root.selected-page;
                                control-style: root.page-control-style;
                                select-page(p) => {
                                    root.select-page(p);
                                }
                            }
                        }
                    }
                    VScrollBar {
                        x: parent.width - self.width;
                        y: 0px;
                        height: parent.height;
                        page-size: tabsFlick.height;
                        maximum: tabsFlick.viewport-height - tabsFlick.height;
                        value <=> tabsFlick.viewport-y;
                    }
                }

                // Right scroll container: the selected page's rows. The larger
                // stretch factor gives long track names more room than the tabs.
                Rectangle {
                    min-width: 320px;
                    preferred-width: 480px;
                    horizontal-stretch: 2;
                    rowsFlick := Flickable {
                        x: 0px;
                        y: 0px;
                        width: max(0px, parent.width - 18px);
                        height: parent.height;
                        viewport-width: self.width;
                        viewport-height: rowsContent.preferred-height;
                        rowsContent := VerticalLayout {
                            alignment: start;
                            for item in root.page-items: Rectangle {
                                height: 30px;
                                preferred-height: 30px;
                                // Active row painted with the system accent (matching
                                // the active page tab's primary Button); inactive rows
                                // stay transparent over the window background.
                                background: item.index == root.current-index ? Palette.accent-background : transparent;
                                TouchArea {
                                    // Click the already-selected (highlighted) row to
                                    // toggle play/pause; click any other row to merely
                                    // select it (Rust loads it paused). A "double click
                                    // to play" then falls out for free: the first click
                                    // selects, the second (now on the selected row)
                                    // toggles to play, so no real double-click is needed.
                                    clicked => {
                                        if (item.index == root.current-index) {
                                            root.toggle-play();
                                        } else {
                                            root.select-index(item.index);
                                        }
                                    }
                                    Text {
                                        text: item.name;
                                        font-size: Typography.body-rem * 1rem;
                                        x: 8px;
                                        width: parent.width - 16px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        // Active row uses the palette's on-accent ink so
                                        // it stays legible on the accent fill (it can be a
                                        // light tint under the dark scheme); inactive rows
                                        // use the palette foreground, which tracks the
                                        // system light/dark theme.
                                        color: item.index == root.current-index ? Palette.accent-foreground : Palette.foreground;
                                    }
                                }
                            }
                        }
                    }
                    VScrollBar {
                        x: parent.width - self.width;
                        y: 0px;
                        height: parent.height;
                        page-size: rowsFlick.height;
                        maximum: rowsFlick.viewport-height - rowsFlick.height;
                        value <=> rowsFlick.viewport-y;
                    }
                }
            }

            // Narrow: one shared scroll region, the original tab-then-list order.
            if !root.show-settings && root.width < 900px: Rectangle {
                narrowFlick := Flickable {
                    x: 0px;
                    y: 0px;
                    width: max(0px, parent.width - 18px);
                    height: parent.height;
                    viewport-width: self.width;
                    viewport-height: narrowContent.preferred-height;
                    narrowContent := VerticalLayout {
                        // Pack from the top at natural heights, leaving any slack
                        // below the last row rather than stretching the rows.
                        alignment: start;

                        // Narrow page-tab bar: the vertical order, one tab grid
                        // followed by the selected page's rows.
                        if root.page-labels.length > 0: PageControls {
                            labels: root.page-labels;
                            selected-page: root.selected-page;
                            control-style: root.page-control-style;
                            select-page(p) => {
                                root.select-page(p);
                            }
                        }

                        // 24px gap between the narrow page-tab bar and the list.
                        if root.page-labels.length > 0: Rectangle {
                            height: 24px;
                        }

                        // Narrow selected-page rows.
                        VerticalLayout {
                            vertical-stretch: 0;
                            alignment: start;
                            for item in root.page-items: Rectangle {
                                height: 30px;
                                preferred-height: 30px;
                                background: item.index == root.current-index ? Palette.accent-background : transparent;
                                TouchArea {
                                    clicked => {
                                        if (item.index == root.current-index) {
                                            root.toggle-play();
                                        } else {
                                            root.select-index(item.index);
                                        }
                                    }
                                    Text {
                                        text: item.name;
                                        font-size: Typography.body-rem * 1rem;
                                        x: 8px;
                                        width: parent.width - 16px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        color: item.index == root.current-index ? Palette.accent-foreground : Palette.foreground;
                                    }
                                }
                            }
                        }
                    }
                }
                VScrollBar {
                    x: parent.width - self.width;
                    y: 0px;
                    height: parent.height;
                    page-size: narrowFlick.height;
                    maximum: narrowFlick.viewport-height - narrowFlick.height;
                    value <=> narrowFlick.viewport-y;
                }
            }
        }
    }
}
