// Feedback overlay on the 443 wide cover, dark: Undo above the error, both bounded by the card width.
export component FeedbackDark443 inherits Window {
    width: 443px;
    height: 260px;
    background: Theme.canvas;
    init => { Theme.scheme-override = 2; }
    FeedbackOverlay {
        x: 16px;
        y: 32px;
        width: parent.width - 32px;
        available-width: parent.width - 32px;
        items: [
            { id: "undo-ghost", text: "Moved Ghost to trash", kind: 1, action-label: "Undo" },
            { id: "error-folder", text: "That folder can't be kept open. Choose it again, or pick another folder.", kind: 0, action-label: "" },
        ];
    }
}

// Feedback overlay on the 443 wide cover, light.
export component FeedbackLight443 inherits Window {
    width: 443px;
    height: 260px;
    background: Theme.canvas;
    init => { Theme.scheme-override = 1; }
    FeedbackOverlay {
        x: 16px;
