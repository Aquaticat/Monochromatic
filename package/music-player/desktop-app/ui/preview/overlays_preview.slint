// Preview windows for the scan indicator and the feedback overlay; render each with --component.
import { Theme } from "../theme.slint";
import { ScanIndicator, FeedbackOverlay, FeedbackItem } from "../overlays.slint";

// Scan bar on the 443 wide cover, dark, determinate at 412 of 1,218.
export component ScanDeterminateDark443 inherits Window {
    width: 443px;
    height: 120px;
    background: Theme.canvas;
    init => { Theme.scheme-override = 2; }
    ScanIndicator {
        y: 64px;
        width: parent.width;
        visible-model: true;
        status-text: "Analysing true peak · 412 of 1,218";
        fraction: 412 / 1218;
    }
}

// Scan bar on the 443 wide cover, light, determinate.
export component ScanDeterminateLight443 inherits Window {
    width: 443px;
    height: 120px;
    background: Theme.canvas;
    init => { Theme.scheme-override = 1; }
    ScanIndicator {
        y: 64px;
        width: parent.width;
        visible-model: true;
        status-text: "Analysing true peak · 412 of 1,218";
        fraction: 412 / 1218;
    }
}

// Indeterminate scan bar while the library is read, dark.
export component ScanIndeterminateDark443 inherits Window {
    width: 443px;
    height: 120px;
    background: Theme.canvas;
    init => { Theme.scheme-override = 2; }
    ScanIndicator {
        y: 64px;
        width: parent.width;
        visible-model: true;
        status-text: "Scanning library";
        fraction: -1;
    }
}

// Indeterminate scan bar while the library is read, light.
export component ScanIndeterminateLight443 inherits Window {
    width: 443px;
    height: 120px;
    background: Theme.canvas;
    init => { Theme.scheme-override = 1; }
    ScanIndicator {
        y: 64px;
        width: parent.width;
        visible-model: true;
        status-text: "Scanning library";
        fraction: -1;
    }
}

// Scan bar across the 851 wide inner panel, dark, to check the wide-width layout.
export component ScanDeterminateDark851 inherits Window {
    width: 851px;
    height: 120px;
    background: Theme.canvas;
    init => { Theme.scheme-override = 2; }
    ScanIndicator {
        y: 64px;
        width: parent.width;
        visible-model: true;
        status-text: "Analysing true peak · 412 of 1,218";
        fraction: 412 / 1218;
