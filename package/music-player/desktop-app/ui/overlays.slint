// Bottom-edge scan status bar and the transient feedback overlay (D83, D84, D26).
// Both components take their data from the caller and never reflow the content beneath them.
import { Theme } from "theme.slint";

// Height of the scan bar, fixed so that showing or hiding it never changes the caller's layout (D13, D26).
// The bar paints the progress line on its top edge and one status line below it, with no controls (D84).
export component ScanIndicator inherits Rectangle {
    // Shows the bar while the library is scanned or true peaks are measured; hidden keeps the 56px geometry.
    in property <bool> visible-model: false;
    // One line of status copy, already formatted by the Rust side (for example `Scanning library`).
    in property <string> status-text: "";
    // Completed share from 0 to 1; a negative value draws the indeterminate line.
    in property <float> fraction: -1;

    height: 56px;
    background: Theme.current-row;
    visible: root.visible-model;

    // Progress line on the top edge, 4px tall as the Android linear indicator.
    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 4px;
        background: Theme.secondary-container;
        clip: true;

        // Determinate fill, sized from the completed share.
        if root.fraction >= 0 : Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width * max(0, min(1, root.fraction));
            height: parent.height;
            background: Theme.primary;
        }

        // Indeterminate segment that sweeps across the track.
        if root.fraction < 0 : Rectangle {
            y: 0px;
            width: parent.width * 0.3;
            height: parent.height;
            background: Theme.primary;
            x: (parent.width - self.width) * indeterminate-phase;
        }
    }

    // Repeats the sweep while the indicator is indeterminate; ping-pong over the track.
    in-out property <float> indeterminate-phase: 0;
    animate indeterminate-phase {
        duration: 1600ms;
        iteration-count: -1;
        easing: ease-in-out;
    }

    // Status text in the 16px inset row below the progress line, one line, elided.
    Text {
        x: 16px;
        y: 4px;
        width: parent.width - 32px;
        height: parent.height - 4px;
        text: root.status-text;
        font-size: Theme.body-small;
        color: Theme.on-surface-variant;
        vertical-alignment: center;
        overflow: elide;
        wrap: no-wrap;
    }
}

// One feedback message. `kind` is 0 for an error (warning glyph, error container) and 1 for an Undo message.
// `action-label` is empty when the message offers no action button.
export struct FeedbackItem {
    // Stable key the caller uses to dismiss the message and to report its action.
    id: string,
    // Message text; wraps to two lines and elides beyond that.
    text: string,
    // 0 for an error, 1 for an Undo message.
    kind: int,
    // Label of the action button, or an empty string when there is none.
    action-label: string,
}

// Stacked feedback messages. Each message is content width and left aligned, and the caller bounds the width (D83).
// Items are drawn top to bottom in the order given, so the caller puts Undo above Error (D29).
export component FeedbackOverlay inherits Rectangle {
    // Messages in display order, top to bottom.
    in property <[FeedbackItem]> items: [];
    // Widest a message may be; a message wraps to two lines within it. Zero leaves messages unbounded.
    in property <length> available-width: 0px;

    // Fired with the item id when the dismiss control is pressed.
    callback dismiss(string);
    // Fired with the item id when the action button is pressed; the caller decides whether that also dismisses.
    callback action(string);

    // The dark mix is a muted rose rather than the saturated red of the captures (accepted difference).

    background: transparent;

    VerticalLayout {
        alignment: start;
        spacing: 16px;

        for item[index] in root.items : card := Rectangle {
            // Error uses the error container and error content; Undo uses the surface-high token (capture-measured).
            property <color> container: item.kind == 0 ? Theme.error-container : Theme.surface-high;
            property <color> content: item.kind == 0 ? Theme.on-error-container : Theme.on-surface;

            horizontal-stretch: 0;
            // Content width, capped by the caller's width.
            width: root.available-width > 0px ? min(row.preferred-width, root.available-width) : row.preferred-width;
            height: max(48px, row.preferred-height);
            background: card.container;
            border-radius: 24px;

            row := HorizontalLayout {
                padding-left: 16px;
                padding-right: 8px;
                spacing: 12px;
                alignment: center;

                // Warning glyph, 24px with 12px gap after it, only on errors.
                if item.kind == 0 : Rectangle {
                    width: 24px;
                    height: 24px;
                    Path {
                        width: parent.width;
                        height: parent.height;
                        viewbox-width: 24;
                        viewbox-height: 24;
                        commands: "M1 21 h22 L12 2 L1 21 Z M13 18 h-2 v-2 h2 v2 Z M13 14 h-2 v-4 h2 v4 Z";
                        fill: card.content;
                    }
                }

                // Message text: two lines maximum, elided beyond that.
                Text {
                    horizontal-stretch: 1;
                    text: item.text;
                    color: card.content;
                    font-size: Theme.body-medium;
                    wrap: word-wrap;
                    // Slint 1.17 has no max-lines; a two-line height clips a third line.
                    overflow: clip;
                    height: Theme.body-medium * 2.5;
                    vertical-alignment: center;
                }

                // Action button, 48px target, only when the item carries a label.
                if item.action-label != "" : Rectangle {
                    width: max(48px, action-text.preferred-width + 16px);
                    height: 48px;
                    action-text := Text {
                        text: item.action-label;
                        font-size: Theme.label-large;
                        font-weight: 700;
                        color: item.kind == 0 ? Theme.error : Theme.primary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    TouchArea {
                        clicked => { root.action(item.id); }
                    }
                }

                // Dismiss control, a 48px target with a 24px close glyph centred inside.
                Rectangle {
                    width: 48px;
                    height: 48px;
                    Path {
                        width: 24px;
                        height: 24px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        viewbox-width: 24;
                        viewbox-height: 24;
                        commands: "M19 6.41 L17.59 5 L12 10.59 L6.41 5 L5 6.41 L10.59 12 L5 17.59 L6.41 19 L12 13.41 L17.59 19 L19 17.59 L13.41 12 Z";
                        fill: card.content;
                    }
                    TouchArea {
                        clicked => { root.dismiss(item.id); }
                    }
                }
            }
        }
    }
}
