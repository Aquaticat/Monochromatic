# Icon-rendering toolchain for the `gen:icons` mise task. The host is an
# immutable-style Fedora without these tools, so icon generation runs in this
# throwaway image (same podman pattern as the build Containerfile). gen:icons is
# rare (regenerate only when asset/icon.svg changes), and its outputs
# (asset/music-player.icns, asset/music-player.ico) are committed, so neither
# the build nor the sign tasks need this image.
#   librsvg2-tools  rsvg-convert: render asset/icon.svg to PNG at each size
#   libicns-utils   png2icns: pack the PNGs into a macOS .icns
#   icoutils        icotool: pack the PNGs into a Windows .ico
#   ImageMagick     fallback rasteriser / format glue if needed
# Pinned by digest (the multi-arch index of fedora:41, resolved 2026-10-18) so a moving tag cannot change the build
# input. Refresh on purpose: skopeo inspect --raw docker://registry.fedoraproject.org/fedora:41 | sha256sum
FROM registry.fedoraproject.org/fedora@sha256:893f7eeffce8e3e2bb2bc62786ba5603fb1e0bd6ba07091acb892266b95bafdf
RUN dnf install -y \
      librsvg2-tools \
      libicns-utils \
      icoutils \
      ImageMagick \
    && dnf clean all
WORKDIR /work
