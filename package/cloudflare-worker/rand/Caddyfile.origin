# Reference copy of the Caddy site block this Worker replaces.
#
# Nothing in this repository runs this file. It served rand.c.aquati.cat from the
# Coolify host's self-managed Caddy, where it exists only on that host and under no
# version control, so it is committed here as the porting spec and as provenance.
# The /int line carries the owner's inclusive fix, which changed the upper bound from
# randInt's exclusive max to (int (add max 1)); that fix is live on the origin.
#
# Behaviours this block encodes, each measured against the live origin on 2026-10-02:
# - randAlphaNum draws from 62 characters, 0-9A-Za-z, uppercase included.
# - Response bodies carry no trailing newline, so Content-Length equals the value length.
# - Path matching is case-insensitive, so /UUIDV4 and /INT both serve.
# - Every method matches, so POST and OPTIONS on /uuidv4 both return 200.
# - Anything unmatched returns 501 with an empty body.
# - atoi coerces unparseable input to 0 rather than failing, and duplicate query
#   parameters collapse into one unparseable string, so min=0&max=2&max=6 returned a
#   constant 0 with status 200. The Worker answers 400 for both.
#
# The 64 literal branches below are why the Worker parses the segment instead of
# enumerating it. The reachable set is unchanged: lengths 1 to 64, plus / for 64.
#
# Status: soft-deprecated. The owner keeps the origin running, and will neither delete
# nor change it, even if it breaks. See package README.

rand.c.aquati.cat {
	log
	import tls13
	templates

	respond /uuidv4 `{{uuidv4}}` 200 {
		close
	}

	respond /int `{{randInt (atoi (placeholder "http.request.uri.query.min")) (int (add (atoi (placeholder "http.request.uri.query.max")) 1))}}` 200 {
		close
	}

	respond /1 `{{randAlphaNum 1}}` 200 {
		close
	}
	respond /2 `{{randAlphaNum 2}}` 200 {
		close
	}
	respond /3 `{{randAlphaNum 3}}` 200 {
