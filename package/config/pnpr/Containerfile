# Private pnpr registry image (doc/decision/private-npm-registry.md).
# Base pinned by OCI index digest so Coolify rebuilds start from the same layers.
# Refresh with: skopeo inspect --raw docker://docker.io/library/node:24-slim | sha256sum
FROM docker.io/library/node:24-slim@sha256:2fe369e969550cde8e867afc3fe370b260140cab4a23d467074295b42163d553

# pnpr's TLS verifier reads the system CA bundle, which node:24-slim lacks.
# Without it pnpr exits at startup with "OIDC provider unavailable".
RUN apt-get update \
 && apt-get install --yes --no-install-recommends ca-certificates \
 && rm --recursive --force /var/lib/apt/lists/*

# Owner decision: track the @pnpm/pnpr `next` dist-tag instead of an exact version.
# A cached layer keeps the previously resolved `next`; rebuild without cache to pick up a newer release.
RUN npm install --global @pnpm/pnpr@next \
 && pnpr --version

RUN mkdir --parents /pnpr/storage \
 && chown --recursive node:node /pnpr

# Generated by file-enforcer; baked in so a Coolify redeploy is the only way config changes.
COPY config.yaml /pnpr/config.yaml

USER node
WORKDIR /pnpr
EXPOSE 7677

ENTRYPOINT ["pnpr"]
# --disable-resolver: the install accelerator fetches upstream indexes for clients,
# and this registry deliberately proxies nothing.
CMD ["--config", "/pnpr/config.yaml", "--listen", "0.0.0.0:7677", "--storage", "/pnpr/storage", "--disable-resolver"]
