+/**
+ Analysis-environment identity shared by every consuming project with equal semantics.
+
+ The persistent summary cache was addressed by the configured project path, so one sibling
+ source reached from many consuming projects was summarized once per project. Summaries depend
+ on the resolved compiler options, the governing lockfile, and the source closure, none of which
+ names the consuming project, so the address names the environment instead: the analysis-scope
+ policy plus the resolved compiler options with configuration-directory paths relocated to a
+ placeholder. Two projects extending the same shared configuration then share one address,
+ while a project on another `lib` or `types` selection keeps its own.
+
+ @module
+ */
+
+import { createHash, } from 'node:crypto';
+import {
+  dirname,
+  sep,
+} from 'node:path';
+
+import type { Project, } from 'typescript/unstable/sync';
+
+import { updateHashPlainValue, } from './effect-hash-value.ts';
+
+/**
+ Placeholder replacing the configuration directory inside path-valued compiler options.
+ */
+const CONFIG_DIRECTORY_PLACEHOLDER = '${configDir}';
+
+/**
+ Tests whether compiler option value is a property-bearing record.
+
+ @param value - Compiler option value.
+
+ @returns whether string-keyed properties can be inspected.
+ */
+function isPlainRecord(value: unknown,): value is Readonly<Record<string, unknown>> {
+  return ((typeof value) === 'object')
+    && (value !== null)
+    && (!Array.isArray(value,));
+}
+
+/**
+ Rewrites configuration-directory prefixes inside one JSON-compatible compiler option value.
+
+ Path-valued options such as `rootDirs`, `paths`, `outDir`, and `tsBuildInfoFile` are expanded
+ from `${configDir}` by TypeScript, so every project extending one shared configuration resolves
+ them to a different absolute path while meaning the same thing. Relocating the prefix back to the
+ placeholder restores that equality; a path outside the configuration directory is kept verbatim.
+
+ @param value - Resolved compiler option value.
+
+ @param configDirectory - Directory holding the configured project.
+
+ @returns equal-shaped value with configuration-directory prefixes replaced.
+
+ @example
+ ```ts
+ relocatedOptionValue({ value: '/repo/package/a/src', configDirectory: '/repo/package/a' });
+ ```
+ */
+function relocatedOptionValue({
+  value,
+  configDirectory,
+}: {
+  readonly value: unknown;
+  readonly configDirectory: string;
+},): unknown {
+  if ((typeof value) === 'string') {
+    if (value === configDirectory)
+      return CONFIG_DIRECTORY_PLACEHOLDER;
+    if (value.startsWith(`${configDirectory}${sep}`,))
+      return `${CONFIG_DIRECTORY_PLACEHOLDER}${value.slice(configDirectory.length,)}`;
+    return value;
+  }
+  if (Array.isArray(value,)) {
+    return value.map(function relocateElement(element: unknown,): unknown {
+      return relocatedOptionValue({
+        value: element,
+        configDirectory,
+      },);
+    },);
+  }
+  if (isPlainRecord(value,)) {
+    return Object.fromEntries(Object.entries(value,)
+      .map(function relocateProperty([key, property,],): readonly [string, unknown,] {
+        return [
+          key,
+          relocatedOptionValue({
+            value: property,
+            configDirectory,
+          },),
+        ];
+      },),);
+  }
+  return value;
+}
+
+/**
+ Digests resolved compiler options with configuration-directory paths relocated.
+
+ @param project - Configured TypeScript project.
+
+ @returns compiler-option identity equal across projects extending one configuration.
+
+ @example
+ ```ts
+ const digest = compilerOptionsEnvironmentDigest(project);
+ ```
+ */
+export function compilerOptionsEnvironmentDigest(project: Project,): string {
+  /**
+   Directory whose absolute prefix every `${configDir}` option expands to.
+   */
+  const configDirectory = dirname(project.configFileName,);
+  /**
+   Deterministic digest over the relocated option tree.
+   */
+  const digest = createHash('sha256',);
+  updateHashPlainValue({
+    digest,
+    value: relocatedOptionValue({
+      value: project.compilerOptions,
+      configDirectory,
+    },),
+  },);
+  return digest.digest('hex',);
+}
+
+/**
+ Builds persistent cache scope identity naming the analysis environment rather than the project.
+
+ @param project - Configured TypeScript project.
+
+ @param analysisRoot - Optional external implementation root admitted into analysis.
+
+ @returns scope key shared by every project with equal analysis policy and compiler options.
+
+ @example
+ ```ts
+ const scopeKey = analysisEnvironmentKey({ project });
+ ```
+ */
+export function analysisEnvironmentKey({
+  project,
+  analysisRoot,
+}: {
+  readonly project: Project;
+  readonly analysisRoot?: string;
+},): string {
+  return `${analysisRoot ?? ''}\0${compilerOptionsEnvironmentDigest(project,)}`;
+}
