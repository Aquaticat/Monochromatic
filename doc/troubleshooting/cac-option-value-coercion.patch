+test('preserves exact string option values', () => {
+  const cli = cac()
+
+  cli.option('--policy <id>', 'Policy identifier')
+
+  expect(
+    cli.parse(['node', 'bin', '--policy', '001'], { run: false }).options,
+  ).toMatchObject({ policy: '001' })
+  expect(
+    cli.parse(['node', 'bin', '--policy', '+2'], { run: false }).options,
+  ).toMatchObject({ policy: '+2' })
+})
+
+test('preserves exact values before explicit string array transforms', () => {
+  const cli = cac()
+
+  cli.option('--policy <id>', 'Policy identifier', { type: [String] })
+
+  expect(
+    cli.parse(['node', 'bin', '--policy', '001'], { run: false }).options,
+  ).toMatchObject({ policy: ['001'] })
+  expect(
+    cli.parse(['node', 'bin', '--policy', '+2'], { run: false }).options,
+  ).toMatchObject({ policy: ['+2'] })
+})
