diff --git a/crates/rolldown/src/utils/deliver_warnings.rs b/crates/rolldown/src/utils/deliver_warnings.rs
new file mode 100644
index 0000000..0d18393
--- /dev/null
+++ b/crates/rolldown/src/utils/deliver_warnings.rs
@@ -0,0 +1,41 @@
+use rolldown_common::{Log, LogLevel, NormalizedBundlerOptions};
+use rolldown_error::{
+  BuildDiagnostic, Diagnostic, DiagnosticOptions, filter_out_disabled_diagnostics,
+};
+
+/// Deliver warnings to the user's `onLog` handler, stopping at the first handler error.
+///
+/// `Bundle::bundle_write` calls this before writing any file, so a handler that
+/// escalates a warning to an error (`defaultHandler('error', log)` or `throw`)
+/// fails the build without leaving output on disk. Rollup behaves the same way,
+/// because it calls `onLog` synchronously while loading modules.
+///
+/// Mirrors `handle_warnings` in `rolldown_binding` and `emit_warnings` in
+/// `rolldown_watcher`, including the batched rendering from #9748.
+pub async fn deliver_warnings_to_on_log(
+  warnings: Vec<BuildDiagnostic>,
+  options: &NormalizedBundlerOptions,
+) -> anyhow::Result<()> {
+  if warnings.is_empty() || options.log_level == Some(LogLevel::Silent) {
+    return Ok(());
+  }
+  let Some(on_log) = options.on_log.as_ref() else {
+    return Ok(());
+  };
+
+  let warnings: Vec<BuildDiagnostic> =
+    filter_out_disabled_diagnostics(warnings, &options.checks).collect();
+  if warnings.is_empty() {
+    return Ok(());
+  }
+
+  let diagnostic_options = DiagnosticOptions { cwd: options.cwd.clone() };
+  let diagnostics: Vec<Diagnostic> =
+    warnings.iter().map(|warning| warning.to_diagnostic_with(&diagnostic_options)).collect();
+  let rendered = Diagnostic::render_batch(&diagnostics, true);
+
+  for (warning, rendered) in warnings.into_iter().zip(rendered) {
+    on_log.call(LogLevel::Warn, Log::from_rendered(&warning, rendered)).await?;
+  }
+  Ok(())
+}
