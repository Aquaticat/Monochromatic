index 0000000..3a9e083
--- /dev/null
+++ b/rust/examples/surrogate_safety.rs
@@ -0,0 +1,74 @@
+//! What: An isolated consumer of the candidate Rust JSONC parser.
+//! Why: Exercise Unicode escape behavior without modifying production callers.
+//!
+//! In TS you'd write (pseudocode):
+//! ```ts
+//! parseJsonc('{"s":"\\u0041"}');
+//! ```
+
+/// What: Import the parser's tagged JSON value representation.
+/// Why: The test must inspect decoded string contents, not merely successful parsing.
+///
+/// In TS you'd write (pseudocode):
+/// ```ts
+/// import type { JsoncValue } from 'momoa';
+/// ```
+use momoa::ast::Node;
+
+/// What: A standalone executable that calls the library's public JSONC parser.
+/// Why: A patched candidate must reject isolated surrogate escapes and accept valid pairs.
+///
+/// In TS you'd write (pseudocode):
+/// ```ts
+/// function main(): void { /* parse cases and assert results */ }
+/// ```
+fn main() {
+    // What: `momoa::jsonc::parse` returns `Result`; `.is_err()` checks its failure variant.
+    // Why: An isolated high surrogate must not construct an invalid Rust `char`.
+    //
+    // In TS you'd write (pseudocode):
+    // ```ts
+    // assert.throws(() => parseJsonc('{"s":"\\uD800"}'));
+    // ```
+    assert!(momoa::jsonc::parse(r#"{"s":"\uD800"}"#).is_err());
+
+    // An isolated low surrogate must also fail safely.
+    assert!(momoa::jsonc::parse(r#"{"s":"\uDFFF"}"#).is_err());
+    // Object keys share the same decoder and must reject an isolated high half.
+    assert!(momoa::jsonc::parse(r#"{"\uD800":0}"#).is_err());
+    // A high half followed by a non-low code unit must fail safely.
+    assert!(momoa::jsonc::parse(r#"{"s":"\uD83D\u0041"}"#).is_err());
+
+    // What: `.expect` extracts the success value from a `Result` or fails this test.
+    // Why: A valid pair must parse so we can inspect the decoded scalar.
+    //
+    // In TS you'd write (pseudocode):
+    // ```ts
+    // const parsed = parseJsonc('{"s":"\\uD83D\\uDE00"}');
+    // ```
+    let parsed = momoa::jsonc::parse(r#"{"s":"\uD83D\uDE00"}"#).expect("valid pair");
+    // What: `let` patterns extract the tagged document, object, member, and string shapes.
+    // Why: Inspect the actual value that the public parser returned, not just success.
+    //
+    // In TS you'd write (pseudocode):
+    // ```ts
+    // const value = parsed.body.members[0].value.value;
+    // ```
+    let Node::Document(document) = parsed else { panic!("expected document"); };
+    let Node::Object(object) = document.body else { panic!("expected object"); };
+    let Some(first) = object.members.first() else { panic!("expected member"); };
+    let Node::Member(member) = first else { panic!("expected member node"); };
+    let Node::String(string) = &member.value else { panic!("expected string value"); };
+    assert_eq!(string.value, "😀");
+    // A valid pair in an object key also takes the checked path.
+    assert!(momoa::jsonc::parse(r#"{"\uD83D\uDE00":0}"#).is_ok());
+
+    // ASCII Unicode escapes remain valid after the pair-handling change.
+    assert!(momoa::jsonc::parse(r#"{"s":"\u0041"}"#).is_ok());
+
+    // A double-backslash source spells a literal backslash, not a surrogate escape.
+    assert!(momoa::jsonc::parse(r#"{"s":"\\uD800"}"#).is_ok());
+
+    // Tell the harness every case passed without showing any secret input.
+    println!("safe surrogate consumer cases passed");
+}
