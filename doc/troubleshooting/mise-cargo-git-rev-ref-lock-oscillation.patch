+        let cmd = lock_cmd(&[]);
+        let backend = "cargo:https://github.com/slint-ui/slint";
+        let revision = "85e3eb76819762cdcaa732fa87533ff896546bac";
+        let mut lockfile = Lockfile::default();
+        lockfile.set_platform_info(
+            backend,
+            &format!("rev:{revision}"),
+            Some(backend),
+            &BTreeMap::new(),
+            "linux-x64",
+            PlatformInfo {
+                checksum: Some("sha256:rev".to_string()),
+                ..Default::default()
+            },
+        );
+        lockfile.set_platform_info(
+            backend,
+            &format!("ref:{revision}"),
+            Some(backend),
+            &BTreeMap::new(),
+            "linux-x64",
+            PlatformInfo {
+                checksum: Some("sha256:ref".to_string()),
+                ..Default::default()
+            },
+        );
+        let tools = vec![configured_tool_with_resolved_version(
+            backend,
+            &format!("rev:{revision}"),
+            &format!("ref:{revision}"),
+        )];
+
+        cmd.prune_stale_versions(&mut lockfile, &tools);
+
+        let requested_rev = BTreeSet::from([format!("rev:{revision}")]);
+        assert!(
+            lockfile
+                .stale_tool_versions(backend, &requested_rev)
+                .is_empty()
+        );
+        assert_eq!(
+            lockfile.all_platform_keys(),
+            std::collections::BTreeSet::from(["linux-x64".to_string()])
+        );
+    }
