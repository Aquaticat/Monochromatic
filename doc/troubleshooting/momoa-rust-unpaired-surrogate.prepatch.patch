+++ b/rust/examples/surrogate_safety.rs
@@ -0,0 +1,140 @@
+//! What: An isolated consumer of the candidate Rust JSONC parser.
+//! Why: Exercise Unicode escape behavior without modifying production callers.
+//!
+//! In TS you'd write (pseudocode):
+//! ```ts
+//! parseJsonc('{"s":"\\u0041"}');
+//! ```
+
+/// What: Import the parser's tagged JSON value representation.
+/// Why: The test must inspect decoded string contents, not merely successful parsing.
+///
+/// In TS you'd write (pseudocode):
+/// ```ts
+/// import type { JsoncValue } from 'momoa';
+/// ```
+use momoa::ast::Node;
+
+/// What: Check for the candidate's expected error on a complete but invalid surrogate escape.
+/// Why: A generic `is_err` could pass for an unrelated syntax failure.
+///
+/// In TS you'd write (pseudocode):
+/// ```ts
+/// function assertInvalidEscape(source: string): void { /* assert specific error type */ }
+/// ```
+fn assert_invalid_escape(source: &str) {
+    // What: `matches!` tests the tagged `Err` variant without constructing an invalid character.
+    // Why: A correct repair reports an ordinary parser error on isolated surrogates.
+    //
+    // In TS you'd write (pseudocode):
+    // ```ts
+    // if (!(parse(source) instanceof UnexpectedElement)) throw Error('wrong error');
+    // ```
+    let result = momoa::jsonc::parse(source);
+    assert!(matches!(result, Err(momoa::MomoaError::UnexpectedElement { .. })), "{result:?}");
+}
+
+/// What: Extract the first member from the candidate parser's tagged document.
+/// Why: Key and value tests need to inspect decoded strings through the public parser.
+///
+/// In TS you'd write (pseudocode):
+/// ```ts
+/// function firstMember(source: string): MemberNode { return parse(source).body.members[0]; }
+/// ```
+fn first_member(source: &str) -> Box<momoa::ast::MemberNode> {
+    // What: `.expect` extracts a successful `Result` or fails the test at this call.
+    // Why: String-value assertions must not pass on a parse error.
+    //
+    // In TS you'd write (pseudocode):
+    // ```ts
+    // const parsed = parse(source);
+    // ```
+    let parsed = momoa::jsonc::parse(source).expect("valid JSONC");
+    // What: `let` patterns unwrap the tagged document, object, and first member.
+    // Why: A wrong tree shape is a test failure, not a fallback.
+    //
+    // In TS you'd write (pseudocode):
+    // ```ts
+    // const member = parsed.body.members[0];
+    // ```
+    let Node::Document(document) = parsed else { panic!("expected document"); };
+    let Node::Object(object) = document.body else { panic!("expected object"); };
+    let Some(first) = object.members.into_iter().next() else { panic!("expected member"); };
+    let Node::Member(member) = first else { panic!("expected member node"); };
+    // What: The `Box` owns this member (unlike a borrowed `&MemberNode` or shared `Rc`/`Arc`).
+    // Why: The parsed document can be dropped while the helper returns its first member.
+    //
+    // In TS you'd write (pseudocode):
+    // ```ts
+    // return member;
+    // ```
+    return member;
+}
+
+/// What: Read the decoded string value of the first object member.
+/// Why: Successful parse alone does not prove a surrogate pair was combined correctly.
+///
+/// In TS you'd write (pseudocode):
+/// ```ts
+/// function value(source: string): string { return firstMember(source).value.value; }
+/// ```
+fn decoded_value(source: &str) -> String {
+    let member = first_member(source);
+    let Node::String(string) = member.value else { panic!("expected string value"); };
+    // Return an owned string; no caller can retain a reference to a dropped AST.
+    return string.value;
+}
+
+/// What: Read the decoded string key of the first object member.
+/// Why: Keys traverse the same escape decoder and must respect the same safety rules.
+///
+/// In TS you'd write (pseudocode):
+/// ```ts
+/// function key(source: string): string { return firstMember(source).name.value; }
+/// ```
+fn decoded_key(source: &str) -> String {
+    let member = first_member(source);
+    let Node::String(string) = member.name else { panic!("expected string key"); };
+    return string.value;
+}
+
+/// What: A standalone executable that calls the library's public JSONC parser.
+/// Why: Exercise the patched path without running the original unchecked conversion.
+///
+/// In TS you'd write (pseudocode):
+/// ```ts
+/// function main(): void { /* assert safe errors and exact decoded strings */ }
+/// ```
+fn main() {
+    // Isolated surrogate halves fail with the intended ordinary parser error.
+    assert_invalid_escape(r#"{"s":"\uD800"}"#);
+    assert_invalid_escape(r#"{"s":"\uDFFF"}"#);
+    assert_invalid_escape(r#"{"\uD800":0}"#);
+    assert_invalid_escape(r#"{"\uDFFF":0}"#);
+    // Mismatched or interrupted pairs must not construct a scalar.
+    assert_invalid_escape(r#"{"s":"\uD83D\u0041"}"#);
+    assert_invalid_escape(r#"{"s":"\uD800\uD800"}"#);
+    assert_invalid_escape(r#"{"s":"\uDC00\uD800"}"#);
+    assert_invalid_escape(r#"{"s":"\uD800\\uDC00"}"#);
+    assert_invalid_escape(r#"{"s":"\uD800\n"}"#);
+    assert_invalid_escape(r#"{"s":"\uD83D\uDE00\uDC00"}"#);
+
+    // Boundary surrogate pairs decode to their exact scalar values.
+    assert_eq!(decoded_value(r#"{"s":"\uD800\uDC00"}"#), "\u{10000}");
+    assert_eq!(decoded_value(r#"{"s":"\uDBFF\uDFFF"}"#), "\u{10FFFF}");
+    assert_eq!(decoded_value(r#"{"s":"\uD83D\uDE00"}"#), "😀");
+    assert_eq!(decoded_key(r#"{"\uD83D\uDE00":0}"#), "😀");
+    // Scalar neighbors and zero remain valid Unicode code points.
+    assert_eq!(decoded_value(r#"{"s":"\uD7FF"}"#), "\u{D7FF}");
+    assert_eq!(decoded_value(r#"{"s":"\uE000"}"#), "\u{E000}");
+    assert_eq!(decoded_value(r#"{"s":"\u0000"}"#), "\u{0000}");
+    assert_eq!(decoded_value(r#"{"s":"\uFFFF"}"#), "\u{FFFF}");
+    // Mixed-case hex, adjacent pairs, and surrounding plain text keep order.
+    assert_eq!(decoded_value(r#"{"s":"x\uD83d\uDe00\uD83D\uDE00y"}"#), "x😀😀y");
+    assert_eq!(decoded_value(r#"{"s":"\u0041"}"#), "A");
+    assert_eq!(decoded_value(r#"{"s":"\\uD800"}"#), r"\uD800");
+    // The tokenizer must reject incomplete and nonhex Unicode escapes without panic.
+    assert!(momoa::jsonc::parse(r#"{"s":"\uD80"}"#).is_err());
+    assert!(momoa::jsonc::parse(r#"{"s":"\uZZZZ"}"#).is_err());
+    println!("safe surrogate consumer cases passed");
+}
