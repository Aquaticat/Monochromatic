+/// `x.slice()` / `x.toSpliced()` equals `[...x]` only when `x` is an `Array`.
+/// For strings, typed arrays, or user-defined classes the rewrite changes the
+/// result type, so the fix is dangerous unless the receiver is a known array.
+fn receiver_fix_kind(receiver: &Expression, ctx: &LintContext) -> FixKind {
+    if is_known_array(receiver, ctx) { FixKind::SafeFix } else { FixKind::DangerousFix }
+}
+
+/// Returns `true` for `Array.from(...)`, `Array.of(...)`, or a `const` binding
+/// initialized with an array literal or one of those calls.
+fn is_known_array(expr: &Expression, ctx: &LintContext) -> bool {
+    match expr.without_parentheses() {
+        Expression::ArrayExpression(_) => true,
+        Expression::CallExpression(call) => {
+            call.callee.is_specific_member_access("Array", "from")
+                || call.callee.is_specific_member_access("Array", "of")
+        }
+        Expression::Identifier(ident) => {
+            let Some(symbol_id) = ast_util::get_symbol_id_of_variable(ident, ctx) else {
+                return false;
+            };
+            let scoping = ctx.scoping();
+            if !scoping.symbol_flags(symbol_id).is_const_variable() {
+                return false;
+            }
+            let node = ctx.nodes().get_node(scoping.symbol_declaration(symbol_id));
+            matches!(
+                node.kind(),
+                AstKind::VariableDeclarator(decl)
+                    if decl.id.is_binding_identifier()
+                        && decl.init.as_ref().is_some_and(|init| {
+                            !matches!(init.without_parentheses(), Expression::Identifier(_))
+                                && is_known_array(init, ctx)
+                        })
+            )
+        }
+        _ => false,
+    }
+}
