+    /// CLI filters (`-A` / `-W` / `-D`) must reach JS plugin rules the same way they reach
+    /// builtin rules. `with_filter` cannot resolve JS plugin rule names itself (it has no
+    /// `ExternalPluginStore`), so the effect is checked on the built `Config`.
+    #[test]
+    fn test_filter_external_rules() {
+        let mut store = ExternalPluginStore::new(true);
+        store.register_plugin(
+            PathBuf::from("path/to/custom-plugin"),
+            "custom".to_string(),
+            0,
+            vec!["my-rule".to_string(), "other-rule".to_string()],
+        );
+        let my_rule = store.lookup_rule_id("custom", "my-rule").unwrap();
+        let other_rule = store.lookup_rule_id("custom", "other-rule").unwrap();
+        let options = smallvec::smallvec![serde_json::json!({ "foo": true })];
+        let options_id = store.add_options(my_rule, &options);
+
+        // What `OxlintRules::override_rules` records for
+        // `"custom/my-rule": ["warn", { "foo": true }]` and `"custom/other-rule": "error"`.
+        let configured = || {
+            let mut builder = ConfigStoreBuilder::empty();
+            builder.external_rules.insert(my_rule, (options_id, AllowWarnDeny::Warn));
+            builder
+                .external_rules
+                .insert(other_rule, (ExternalOptionsId::NONE, AllowWarnDeny::Deny));
+            builder
+        };
+        let external_rules = |builder: ConfigStoreBuilder, store: &mut ExternalPluginStore| {
+            builder.build(store).unwrap().base.external_rules.to_vec()
+        };
+
+        // `-A custom/my-rule` removes the rule and leaves the other one untouched.
+        let builder = configured()
+            .with_filter(&LintFilter::new(AllowWarnDeny::Allow, "custom/my-rule").unwrap());
+        assert_eq!(
+            external_rules(builder, &mut store),
+            vec![(other_rule, ExternalOptionsId::NONE, AllowWarnDeny::Deny)],
+            "`-A plugin/rule` should remove a configured JS plugin rule"
+        );
+
+        // `-D custom/my-rule` promotes the rule and keeps its configured options.
+        let builder = configured()
+            .with_filter(&LintFilter::new(AllowWarnDeny::Deny, "custom/my-rule").unwrap());
+        assert_eq!(
+            external_rules(builder, &mut store),
+            vec![
+                (my_rule, options_id, AllowWarnDeny::Deny),
+                (other_rule, ExternalOptionsId::NONE, AllowWarnDeny::Deny)
+            ],
+            "`-D plugin/rule` should change severity and preserve options"
+        );
+
+        // `-A my-rule` (no plugin prefix) matches by rule name, as it does for builtin rules.
+        let builder =
+            configured().with_filter(&LintFilter::new(AllowWarnDeny::Allow, "my-rule").unwrap());
+        assert_eq!(
+            external_rules(builder, &mut store),
+            vec![(other_rule, ExternalOptionsId::NONE, AllowWarnDeny::Deny)],
+            "`-A rule` should remove a configured JS plugin rule by bare name"
+        );
+
+        // `-A all` clears JS plugin rules along with builtin rules.
+        let builder =
+            configured().with_filter(&LintFilter::new(AllowWarnDeny::Allow, "all").unwrap());
+        assert!(
+            external_rules(builder, &mut store).is_empty(),
+            "`-A all` should clear configured JS plugin rules"
+        );
+
+        // `-W custom/unknown-rule` names no registered rule and must not add anything.
+        let builder = configured()
+            .with_filter(&LintFilter::new(AllowWarnDeny::Warn, "custom/unknown-rule").unwrap());
+        assert_eq!(external_rules(builder, &mut store).len(), 2);
+    }
+
