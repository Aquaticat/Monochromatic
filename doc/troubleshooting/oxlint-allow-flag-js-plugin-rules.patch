+    /// Apply the recorded filters (`-A` / `-W` / `-D`) to JS plugin rules, mirroring what
+    /// [`with_filter`] does for builtin rules. Names are resolved through `external_plugin_store`,
+    /// the same lookup `OxlintRules::override_rules` uses for config file keys.
+    ///
+    /// `-W all` / `-D all` are not applied to JS plugin rules: they carry no category, so
+    /// "every rule except nursery" has no meaning for them.
+    ///
+    /// [`with_filter`]: ConfigStoreBuilder::with_filter
+    fn apply_external_filters(&mut self, external_plugin_store: &ExternalPluginStore) {
+        if !external_plugin_store.is_enabled() {
+            return;
+        }
+
+        for filter in std::mem::take(&mut self.external_filters) {
+            let (severity, kind): (AllowWarnDeny, &LintFilterKind) = (&filter).into();
+            let rule_ids: Vec<ExternalRuleId> = match kind {
+                LintFilterKind::Rule(plugin, rule) => {
+                    let (plugin, rule) = super::rules::unalias_plugin_name(plugin, rule);
+                    external_plugin_store.lookup_rule_id(&plugin, &rule).ok().into_iter().collect()
+                }
+                LintFilterKind::Generic(name) => {
+                    external_plugin_store.rule_ids_named(name.as_ref()).collect()
+                }
+                LintFilterKind::All if severity.is_allow() => {
+                    self.external_rules.clear();
+                    continue;
+                }
+                LintFilterKind::All | LintFilterKind::Category(_) => continue,
+            };
+
+            for rule_id in rule_ids {
+                if severity.is_allow() {
+                    self.external_rules.remove(&rule_id);
+                } else {
+                    self.external_rules
+                        .entry(rule_id)
+                        .and_modify(|(_, existing_severity)| *existing_severity = severity)
+                        .or_insert((ExternalOptionsId::NONE, severity));
+                }
+            }
+        }
+    }
