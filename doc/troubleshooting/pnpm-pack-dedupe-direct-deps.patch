+#[test]
+fn extract_applies_dedupe_direct_deps_override() {
+    for (flag, expected) in [
+        ("--dedupe-direct-deps", true),
+        ("--dedupe-direct-deps=true", true),
+        ("--dedupe-direct-deps=false", false),
+        ("--config.dedupe-direct-deps=true", true),
+        ("--config.dedupe-direct-deps=false", false),
+        ("--no-dedupe-direct-deps", false),
+    ] {
+        let (overrides, remaining) = ConfigOverrides::extract(argv(["pacquet", flag, "install"]));
+        assert_eq!(remaining, argv(["pacquet", "install"]), "{flag}");
+
+        let mut config = Config { dedupe_direct_deps: !expected, ..Config::default() };
+        overrides.apply(&mut config, Path::new("/workspace"));
+        assert_eq!(config.dedupe_direct_deps, expected, "{flag}");
+        assert_eq!(
+            config.explicit_settings.get("dedupeDirectDeps"),
+            Some(&serde_json::Value::Bool(expected)),
+            "{flag}",
+        );
+    }
+}
