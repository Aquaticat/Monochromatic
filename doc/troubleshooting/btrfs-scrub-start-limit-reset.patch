 	u64 old_limit;
 	u64 limit;
 };
@@ -1205,17 +1206,20 @@ static int is_scrub_running_in_kernel(int fd,
 	return 0;
 }
 
-static u64 read_scrub_device_limit(int fd, u64 devid)
+static int read_scrub_device_limit_checked(int fd, u64 devid, u64 *limit)
 {
 	char path[PATH_MAX] = { 0 };
-	u64 limit;
