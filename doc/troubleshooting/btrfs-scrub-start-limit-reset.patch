 			break;
 		case GETOPT_VAL_LIMIT:
 			throughput_limit = arg_strtou64_with_suffix(optarg);
+			limit_set = true;
 			break;
 		default:
 			usage_unknown_option(cmd, argv);
@@ -1410,12 +1451,22 @@ static int scrub_start(const struct cmd_struct *cmd, int argc, char **argv,
 
 	for (i = 0; i < fi_args.num_devices; ++i) {
 		devid = di_args[i].devid;
-		sp[i].old_limit = read_scrub_device_limit(fdmnt, devid);
-		ret = write_scrub_device_limit(fdmnt, devid, throughput_limit);
-		if (ret < 0) {
-			errno = -ret;
-			warning("failed to set scrub throughput limit on devid %llu: %m",
-				devid);
+		if (limit_set) {
+			ret = read_scrub_device_limit_checked(fdmnt, devid, &sp[i].old_limit);
+			if (ret < 0) {
+				errno = -ret;
+				warning("failed to read scrub throughput limit on devid %llu: %m",
+					devid);
+			} else {
+				ret = write_scrub_device_limit(fdmnt, devid, throughput_limit);
+				if (ret < 0) {
+					errno = -ret;
+					warning("failed to set scrub throughput limit on devid %llu: %m",
+						devid);
+				} else {
+					sp[i].temporary_limit_set = true;
+				}
+			}
 		}
 		ret = pthread_mutex_init(&sp[i].progress_mutex, NULL);
 		if (ret) {
@@ -1519,6 +1570,7 @@ static int scrub_start(const struct cmd_struct *cmd, int argc, char **argv,
 
 		if (pid) {
 			int stat;
+			restore_limits = false;
 			scrub_handle_sigint_parent();
 			pr_default("scrub %s on %s, fsid %s (pid=%d)\n",
 				   n_start ? "started" : "resumed",
@@ -1594,14 +1646,6 @@ static int scrub_start(const struct cmd_struct *cmd, int argc, char **argv,
 
 	err = 0;
 	for (i = 0; i < fi_args.num_devices; ++i) {
-		/* Revert to the older scrub limit. */
-		ret = write_scrub_device_limit(fdmnt, di_args[i].devid, sp[i].old_limit);
-		if (ret < 0) {
-			errno = -ret;
-			warning("failed to reset scrub throughput limit on devid %llu: %m",
-				di_args[i].devid);
-		}
-
 		if (sp[i].skip)
 			continue;
 		devid = di_args[i].devid;
@@ -1645,6 +1689,9 @@ static int scrub_start(const struct cmd_struct *cmd, int argc, char **argv,
 			e_correctable++;
 	}
 
+	restore_scrub_device_limits(fdmnt, di_args, sp, fi_args.num_devices,
+				    throughput_limit);
+
 	if (do_print) {
 		const char *append = "done";
 		u64 total_bytes_scrubbed = 0;
@@ -1710,6 +1757,9 @@ static int scrub_start(const struct cmd_struct *cmd, int argc, char **argv,
 	scrub_handle_sigint_child(-1);
 
 out:
+	if (restore_limits && limit_set && di_args && sp)
+		restore_scrub_device_limits(fdmnt, di_args, sp, fi_args.num_devices,
+					    throughput_limit);
 	free_history(past_scrubs);
