diff --git a/tests/cli-tests/024-scrub-limit/test.sh b/tests/cli-tests/024-scrub-limit/test.sh
index a417f31..d4dff01 100755
--- a/tests/cli-tests/024-scrub-limit/test.sh
+++ b/tests/cli-tests/024-scrub-limit/test.sh
@@ -47,6 +47,116 @@ run_check "$TOP/btrfs" scrub limit "$TEST_MNT"
 run_check $SUDO_HELPER "$TOP/btrfs" scrub limit -a -l 30m "$TEST_MNT"
 run_check "$TOP/btrfs" scrub limit "$TEST_MNT"
 
+wait_for_scrub_running() {
+	local scrub_output="$1"
+	local attempt
+	local status
+
+	for attempt in {1..50}; do
+		status=$($SUDO_HELPER "$TOP/btrfs" scrub status "$TEST_MNT")
+		if printf '%s\n' "$status" | grep --extended-regexp --quiet '^Status:[[:space:]]+running$'; then
+			return
+		fi
+		sleep 0.1
+	done
+	cat "$scrub_output"
+	_fail "scrub did not remain active for its limit check"
+}
+
+wait_for_scrub_limit() {
+	local expected="$1"
+	local attempt
+	local i
+	local limit
+	local matches
+
+	for attempt in {1..600}; do
+		matches=true
+		for i in "$sysfs"/devinfo/*/scrub_speed_max; do
+			limit=$(cat "$i")
+			if [[ "$limit" != "$expected" ]]; then
+				matches=false
+				break
+			fi
+		done
+		if $matches; then
+			return
+		fi
+		sleep 0.1
+	done
+	_fail "scrub limit did not become $expected"
+}
+
+assert_scrub_limit() {
+	local expected="$1"
+	local i
+	local limit
+
+	for i in "$sysfs"/devinfo/*/scrub_speed_max; do
+		limit=$(cat "$i")
+		[[ "$limit" == "$expected" ]] || _fail "scrub limit is $limit, expected $expected"
+	done
+}
+
+# Force data allocation and commit its transaction before scrub discovery
+run_check $SUDO_HELPER dd if=/dev/zero of="$TEST_MNT/scrub-data" bs=1M count=64
+run_check $SUDO_HELPER sync "$TEST_MNT/scrub-data"
+run_check $SUDO_HELPER "$TOP/btrfs" filesystem sync "$TEST_MNT"
+scrub_output=$(_mktemp scrub-limit-output)
+
+# Keep preconfigured limits active when scrub start has no --limit option
+run_check $SUDO_HELPER "$TOP/btrfs" scrub limit -a -l 16m "$TEST_MNT"
+$SUDO_HELPER "$TOP/btrfs" scrub start -B "$TEST_MNT" >"$scrub_output" 2>&1 &
+scrub_pid=$!
+wait_for_scrub_running "$scrub_output"
+assert_scrub_limit 16777216
+wait "$scrub_pid" || {
+	cat "$scrub_output"
+	_fail "foreground scrub without --limit failed"
+}
+assert_scrub_limit 16777216
+
+# Keep an explicit temporary limit active and restore prior limits after scrub
+run_check $SUDO_HELPER "$TOP/btrfs" scrub limit -a -l 30m "$TEST_MNT"
+$SUDO_HELPER "$TOP/btrfs" scrub start -B --limit 16m "$TEST_MNT" >"$scrub_output" 2>&1 &
+scrub_pid=$!
+wait_for_scrub_running "$scrub_output"
+assert_scrub_limit 16777216
+wait "$scrub_pid" || {
+	cat "$scrub_output"
+	_fail "foreground scrub with --limit failed"
+}
+assert_scrub_limit 31457280
+
+# Restore prior limits after a background scrub
+run_check $SUDO_HELPER "$TOP/btrfs" scrub start --limit 4m "$TEST_MNT"
+assert_scrub_limit 4194304
+wait_for_scrub_limit 31457280
+
+# Preserve an operator's live override after a foreground scrub
+$SUDO_HELPER "$TOP/btrfs" scrub start -B --limit 16m "$TEST_MNT" >"$scrub_output" 2>&1 &
+scrub_pid=$!
+wait_for_scrub_running "$scrub_output"
+assert_scrub_limit 16777216
+run_check $SUDO_HELPER "$TOP/btrfs" scrub limit -a -l 24m "$TEST_MNT"
+assert_scrub_limit 25165824
+wait "$scrub_pid" || {
+	cat "$scrub_output"
+	_fail "foreground scrub with live limit override failed"
+}
+assert_scrub_limit 25165824
+
+# Restore prior limits when an interrupted foreground scrub exits
+run_check $SUDO_HELPER "$TOP/btrfs" scrub limit -a -l 30m "$TEST_MNT"
+$SUDO_HELPER "$TOP/btrfs" scrub start -B --limit 16m "$TEST_MNT" >"$scrub_output" 2>&1 &
+scrub_pid=$!
+wait_for_scrub_running "$scrub_output"
+assert_scrub_limit 16777216
+run_check $SUDO_HELPER kill --signal INT "$scrub_pid"
+wait "$scrub_pid" || true
+wait_for_scrub_limit 31457280
+rm "$scrub_output"
+
 run_check_umount_test_dev
 
 cleanup_loopdevs
