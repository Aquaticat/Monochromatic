+	return sysfs_read_fsid_file_u64(fd, path, limit);
+}
+
+static u64 read_scrub_device_limit(int fd, u64 devid)
+{
+	u64 limit = 0;
+
+	read_scrub_device_limit_checked(fd, devid, &limit);
 	return limit;
 }
 
@@ -1230,6 +1234,40 @@ static u64 write_scrub_device_limit(int fd, u64 devid, u64 limit)
 	return ret;
 }
 
+static void restore_scrub_device_limits(int fd,
+		struct btrfs_ioctl_dev_info_args *di_args,
+		struct scrub_progress *sp, int nr_devices, u64 temporary_limit)
+{
+	for (int i = 0; i < nr_devices; ++i) {
+		u64 current_limit;
+		int ret;
+
+		if (!sp[i].temporary_limit_set)
+			continue;
+
+		ret = read_scrub_device_limit_checked(fd, di_args[i].devid, &current_limit);
+		if (ret < 0) {
+			errno = -ret;
+			warning("failed to read scrub throughput limit on devid %llu: %m",
+				di_args[i].devid);
+			continue;
+		}
+		if (current_limit != temporary_limit) {
+			sp[i].temporary_limit_set = false;
+			continue;
+		}
+
+		ret = write_scrub_device_limit(fd, di_args[i].devid, sp[i].old_limit);
+		if (ret < 0) {
+			errno = -ret;
+			warning("failed to reset scrub throughput limit on devid %llu: %m",
+				di_args[i].devid);
+			continue;
+		}
+		sp[i].temporary_limit_set = false;
+	}
+}
+
 static int scrub_start(const struct cmd_struct *cmd, int argc, char **argv,
 		       bool resume)
 {
@@ -1275,7 +1313,9 @@ static int scrub_start(const struct cmd_struct *cmd, int argc, char **argv,
 	u64 throughput_limit = 0;
