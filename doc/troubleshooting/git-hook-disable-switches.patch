+test_expect_success 'hook.<event>.enabled=false also skips the hook from the hookdir' '
+	test_hook test-hook <<-\EOF &&
+	echo hookdir-ran
+	EOF
+	test_config hook.hook-1.event test-hook &&
+	test_config hook.hook-1.command "echo config-ran" &&
+	test_config hook.test-hook.enabled false &&
+	git hook run --allow-unknown-hook-name test-hook >out 2>err &&
+	test_must_be_empty out &&
+	test_must_be_empty err
+'
+
+test_expect_success 'git hook list shows the hookdir hook as event-disabled' '
+	test_hook test-hook <<-\EOF &&
+	echo hookdir-ran
+	EOF
+	test_config hook.test-hook.enabled false &&
+	git hook list --allow-unknown-hook-name test-hook >actual &&
+	test_grep "^event-disabled	hook from hookdir$" actual
+'
+
+test_expect_success 'hook.<event>.enabled=false skips a failing hookdir pre-commit' '
