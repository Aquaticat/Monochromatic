+    #[test]
+    fn test_comments_round_trip() {
+        let samples = [
+            "{ /* block */ \"a\": 1 }",
+            "/* top */ {\"a\": 1}",
+            "{\"a\": 1} /* tail */",
+            "[1, /* x */ 2]",
+            "/** doc **/ {}",
+            "{\n  \"compilerOptions\": {\n    /* strictness */\n    \"strict\": false, // todo\n  },\n}\n",
+            "{\"a\": 1} // caf\u{e9}",
+            "{\"a\": 1 // x\u{2028}}",
+            "{\"a\": 1 // x\u{2029}}",
+        ];
+        for sample in samples {
+            let res = from_str(sample).unwrap();
+            assert_eq!(res.to_string(), sample);
+        }
+    }
