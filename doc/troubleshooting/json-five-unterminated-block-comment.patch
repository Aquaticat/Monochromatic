+    #[test]
+    fn test_rt_comments() {
+        for text in ["{ /* block */ \"a\": 1 }", "{\"a\": 1} /* tail */", "{\"a\": 1} // caf\u{e9}", "{\"a\": 1 // x\u{2028}}"] {
+            let tokens = source_to_tokens(text).unwrap();
+            assert_eq!(text, tokens_to_source(&tokens));
+        }
+        let tokens = source_to_tokens("{ /* block */ \"a\": 1 }").unwrap();
+        let comment = tokens.iter().find(|tok| tok.tok_type == TokType::BlockComment).unwrap();
+        assert_eq!(comment.lexeme, "/* block */");
+    }
