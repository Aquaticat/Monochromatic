+use super::{
+    AddError, AddOptions, AddResolution,
+    registry::{RegistryPickTarget, pick_saved_registry_range},
+};
+use pnpm_config::Config;
+use pnpm_package_manifest::PackageManifest;
+use pnpm_resolving_npm_resolver::{
+    NamedRegistryPackageSpec, merge_named_registries,
+    parse_named_registry_specifier_to_registry_package_spec,
+};
+use std::collections::{HashMap, HashSet};
+
+/// A `pacquet add <prefix>:[@<scope>/]<name>[@<selector>]` argument whose
+/// `<prefix>` names a registry: the `prefix` of a `registries` entry in
+/// `pnpm-workspace.yaml`, or a built-in one (`gh`, `npmjs`).
+///
+/// The package name sits inside the prefix, so the manifest entry is keyed
+/// by it rather than by the text before the first `@`, and the saved
+/// specifier is rendered back under the prefix with the picked version
+/// pinned: `pacquet add work:@corp/lib@^2.0.0` records
+/// `"@corp/lib": "work:^2.1.3"`, as the TypeScript CLI does.
+pub(super) struct NamedRegistrySelector {
+    spec: NamedRegistryPackageSpec,
+    registry: String,
+}
+impl NamedRegistrySelector {
+    /// `Ok(None)` for an argument whose prefix names no known registry, so
+    /// the caller falls through to the other selector shapes.
+    pub(super) fn parse(selector: &str, config: &Config) -> Result<Option<Self>, AddError> {
+        let registries = named_registries(config)?;
+        let known: HashSet<String> = registries.keys().cloned().collect();
+        let Some(spec) =
+            parse_named_registry_specifier_to_registry_package_spec(selector, &known, None, "latest")
+                .map_err(AddError::ParseNamedRegistrySpecifier)?
+        else {
+            return Ok(None);
+        };
+        let Some(registry) = registries.get(&spec.registry_name).cloned() else {
+            return Ok(None);
+        };
+        Ok(Some(Self { spec, registry }))
+    }
+
+    pub(super) fn package_name(&self) -> &str {
+        &self.spec.spec.name
+    }
+
+    /// The `<prefix>:<range>` specifier to save, or `None` when the named
+    /// registry has no version matching the selector.
+    pub(super) async fn save_specifier(
+        &self,
+        prev_specifier: Option<&str>,
+        add: AddOptions<'_>,
+        manifest: &PackageManifest,
+        resolution: &AddResolution<'_>,
+    ) -> Result<Option<String>, AddError> {
+        let range = pick_saved_registry_range(
+            RegistryPickTarget {
+                package_name: self.package_name(),
+                spec: &self.spec.spec,
+                registry: &self.registry,
+                typed_spec: &self.spec.spec.fetch_spec,
+                prev_specifier,
+            },
+            add,
+            manifest,
+            resolution,
+        )
+        .await?;
+        Ok(range.map(|range| format!("{}:{range}", self.spec.registry_name)))
+    }
+}
+/// The built-in named registries with the configured ones layered on top,
+/// validated the way the install validates them.
+fn named_registries(config: &Config) -> Result<HashMap<String, String>, AddError> {
+    let user_defined: HashMap<String, String> = config
+        .registries_by_prefix
+        .iter()
+        .map(|(name, url)| (name.clone(), url.clone()))
+        .collect();
+    merge_named_registries(&user_defined).map_err(AddError::InvalidNamedRegistry)
+}
