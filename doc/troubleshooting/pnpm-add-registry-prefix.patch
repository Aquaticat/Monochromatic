+/// Run `pacquet add <selector>` with `package_name` served only by a
+/// registry declared under the `work` prefix, and report the specifier the
+/// manifest saves for `package_name`. The default registry is mocked too,
+/// expecting no request: the prefix must route every lookup.
+async fn add_named_registry_selector(selector: &str, package_name: &str) -> Option<String> {
+    let dir = tempdir().unwrap();
+    let project_root = dir.path().join("project");
+    let modules_dir = project_root.join("node_modules");
+    let virtual_store_dir = modules_dir.join(".pacquet");
+    std::fs::create_dir_all(&project_root).unwrap();
+
+    let mut manifest = PackageManifest::create_if_needed(project_root.join("package.json"))
+        .expect("create manifest");
+
+    let mut default_registry = mockito::Server::new_async().await;
+    let default_requests = default_registry
+        .mock("GET", mockito::Matcher::Any)
+        .expect(0)
+        .create_async()
+        .await;
+
+    let encoded_name = package_name.replace('/', "%2F");
+    let mut work_registry = mockito::Server::new_async().await;
+    let work_registry_url = format!("{}/", work_registry.url());
+    let _work_latest = work_registry
+        .mock("GET", format!("/{encoded_name}/latest").as_str())
+        .with_status(200)
+        .with_header("content-type", "application/json")
+        .with_body(version_body(package_name, &work_registry_url))
+        .create_async()
+        .await;
+    let _work_packument = work_registry
+        .mock("GET", format!("/{encoded_name}").as_str())
+        .with_status(200)
+        .with_header("content-type", "application/json")
+        .with_body(package_body(package_name, &work_registry_url))
+        .create_async()
+        .await;
+
+    let mut config = Config::new();
+    config.store_dir = dir.path().join("pacquet-store").into();
+    config.modules_dir = modules_dir;
+    config.virtual_store_dir = virtual_store_dir;
+    config.registry = format!("{}/", default_registry.url());
+    config.registries_by_prefix.insert("work".to_string(), work_registry_url);
+    config.minimum_release_age = None;
+    let config = config.leak();
+
+    let http_client = ThrottledClient::default();
+    let resolved_packages = ResolvedPackages::default();
+    let package_names = [selector.to_string()];
+    Add {
+        manifest: &mut manifest,
+        options: crate::AddOptions {
+            resolved_packages: &resolved_packages,
+            http_client: &http_client,
+            config,
+            lockfile: None,
+            lockfile_path: None,
+            package_names: &package_names,
+            range_spec_style: RangeSpecStyle::Major,
+            lockfile_only: true,
+        },
+        resources: crate::AddResources {
+            tarball_mem_cache: Arc::default(),
+            http_client_arc: Arc::new(ThrottledClient::default()),
+            dependency_groups: Some([DependencyGroup::Prod]),
+            save_catalog_name: None,
+            supported_architectures: None,
+        },
+    }
+    .run::<SilentReporter>()
+    .await
+    .unwrap_or_else(|error| panic!("add {selector} should succeed: {error}"));
+
+    default_requests.assert_async().await;
+    saved_dependency_specifier(&manifest, package_name)
+}
