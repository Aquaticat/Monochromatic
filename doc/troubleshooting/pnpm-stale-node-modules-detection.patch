             &self.dependencies.package_key.name,
             self.dependencies.snapshot.optional_dependencies
                 .iter()
                 .flatten()
+                .filter(|(alias, dep_ref)| {
+                    !include_optional
+                        || dep_ref.resolve(alias).is_some_and(|target| skipped.contains(&target))
+                })
                 .map(|(alias, _)| alias),
         )
     }
