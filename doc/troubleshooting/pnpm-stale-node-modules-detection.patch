+    /// `optional_children_match` on every later install and re-import the
+    /// slot each time.
+    fn remove_unlinked_optional_children(
+        &self,
+        node_modules: &Path,
+    ) -> Result<(), CreateVirtualDirError> {
+        let include_optional = self.dependencies.include_optional;
+        let skipped = self.dependencies.skipped;
         remove_obsolete_children(
