-    fn remove_optional_children(&self, node_modules: &Path) -> Result<(), CreateVirtualDirError> {
+    /// Unlink every optional child `create_symlink_layout` did not link:
+    /// all of them when optional dependencies are excluded, otherwise the
+    /// ones whose target snapshot is skipped on this host. A link left by
