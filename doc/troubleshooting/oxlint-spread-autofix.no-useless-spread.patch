+/// Returns `true` when the hint for `expr` depends on guessing the receiver's
+/// type from a method name alone, e.g. `foo.slice()` or `foo.split()`.
+///
+/// `foo` may be a string, typed array, or iterator, where removing the spread
+/// changes the result type. Fixes based on such hints are not safe.
+pub(super) fn is_method_name_guess(expr: &Expression) -> bool {
+    match expr.get_inner_expression() {
+        Expression::AwaitExpression(expr) => is_method_name_guess(&expr.argument),
+        Expression::SequenceExpression(expr) => {
+            expr.expressions.last().is_some_and(is_method_name_guess)
+        }
+        Expression::ConditionalExpression(cond) => {
+            is_method_name_guess(&cond.consequent) || is_method_name_guess(&cond.alternate)
+        }
+        Expression::CallExpression(call) => {
+            is_split_method(call) || is_functional_array_method(call) || is_array_reduce(call)
+        }
+        _ => false,
+    }
+}
