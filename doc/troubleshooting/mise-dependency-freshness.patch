--- /dev/null
+++ b/e2e/tasks/test_task_source_freshness_failed_first_run
@@ -0,0 +1,26 @@
+#!/usr/bin/env bash
+
+# A task whose first run fails after writing its explicit outputs has no
+# source baseline yet. The mtime fallback must not treat those outputs as
+# proof of success.
+
+cat <<EOF >mise.toml
+[tasks.build]
+run = 'touch out.txt; if [ -f poison ]; then exit 1; fi; echo built'
+sources = ['src.txt']
+outputs = ['out.txt']
+EOF
+
+echo "hello" >src.txt
+touch poison
+
+# First run writes out.txt, then fails
+assert_fail "mise run build 2>&1"
+
+rm poison
+
+# out.txt is newer than src.txt, but the failed run must not count as fresh
+assert "mise run -q build" "built"
+
+# After a success the task is fresh again
+assert_empty "mise run -q build"
