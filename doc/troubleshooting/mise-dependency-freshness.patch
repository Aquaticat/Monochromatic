+/// Record that a run of this task has started. `save_checksum` clears the
+/// marker after success; a failed or interrupted run leaves it, so the next
+/// freshness check reruns the task even when that attempt wrote outputs newer
+/// than its sources and no earlier baseline exists.
+pub(crate) async fn mark_run_pending(task: &Task, config: &Arc<Config>) -> Result<()> {
+    if task.sources.is_empty() {
+        return Ok(());
+    }
+    let root = task_cwd(task, config).await?;
+    let path = pending_run_path(task, &root);
+    if let Some(dir) = path.parent() {
+        file::create_dir_all(dir)?;
+    }
+    file::write(&path, "")?;
+    Ok(())
+}
