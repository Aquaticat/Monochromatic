+++ b/tests/surrogate_safety.rs
@@ -0,0 +1,80 @@
+/// What: Verify that two escaped UTF-16 surrogate halves produce one Unicode scalar.
+/// Why: A safety fix must preserve valid non-BMP JSON string values.
+///
+/// In TS you'd write (pseudocode):
+/// ```ts
+/// assert.equal(JSON.parse('"\\uD83D\\uDE00"'), '😀');
+/// ```
+#[test]
+fn valid_surrogate_pair_decodes() {
+    // What: `from_str::<String>` requests an owned UTF-8 string from the crate.
+    // Why: This crosses the same public parsing entry point as a consumer.
+    //
+    // In TS you'd write (pseudocode):
+    // ```ts
+    // const value: string = JSON.parse('"\\uD83D\\uDE00"');
+    // ```
+    let value = json_with_comments::from_str::<String>(r#""\uD83D\uDE00""#);
+    // What: `.unwrap()` extracts the string or fails this test on a parsing error.
+    // Why: A valid pair must remain accepted after the safety change.
+    //
+    // In TS you'd write (pseudocode):
+    // ```ts
+    // assert.equal(value, '😀');
+    // ```
+    assert_eq!(value.unwrap(), "😀");
+}
+
+/// What: Reject escapes whose two halves cannot form a valid Unicode scalar.
+/// Why: None may reach an unchecked Rust character constructor.
+///
+/// In TS you'd write (pseudocode):
+/// ```ts
+/// for (const text of invalid) assert.throws(() => decode(text));
+/// ```
+#[test]
+fn isolated_or_wrong_surrogates_return_errors() {
+    // What: Raw Rust strings keep each backslash and quote in the parser input unchanged.
+    // Why: The parser must see real JSON Unicode escapes rather than pre-decoded scalars.
+    //
+    // In TS you'd write (pseudocode):
+    // ```ts
+    // const invalid = ['"\\uD800"', '"\\uDC00"', '"\\uD800\\u0041"'];
+    // ```
+    let invalid = [
+        r#""\uD800""#,
+        r#""\uDC00""#,
+        r#""\uD800\u0041""#,
+        r#""\uD800x""#,
+        r#""\uD800\x0041""#,
+        r#""\uD800\uZZZZ""#,
+        r#""\u00""#,
+    ];
+    // Each input must return an error through both the decoded and raw-value public routes.
+    for text in invalid {
+        // The decoded String route previously reached the unchecked conversion.
+        assert!(json_with_comments::from_str::<String>(text).is_err());
+        // The raw route also validates strings through the same token parser.
+        assert!(json_with_comments::from_str_raw::<String>(text).is_err());
+    }
+}
+
+/// What: Check escaped backslashes and ordinary Unicode escapes stay distinct.
+/// Why: A guard must not reject text that merely resembles an escaped surrogate.
+///
+/// In TS you'd write (pseudocode):
+/// ```ts
+/// assert.equal(JSON.parse('"\\\\uD800"'), '\\uD800');
+/// ```
+#[test]
+fn valid_escapes_remain_accepted() {
+    // A regular scalar escape still decodes to the expected character.
+    assert_eq!(json_with_comments::from_str::<String>(r#""\u0041""#).unwrap(), "A");
+    // A backslash escape leaves the following uD800 as literal text.
+    assert_eq!(json_with_comments::from_str::<String>(r#""\\uD800""#).unwrap(), "\\uD800");
+    // The raw route returns authored escape bytes after validating a valid pair.
+    assert_eq!(
+        json_with_comments::from_str_raw::<String>(r#""\uD83D\uDE00""#).unwrap(),
+        "\\uD83D\\uDE00"
+    );
+}
