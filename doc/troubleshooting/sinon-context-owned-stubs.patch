+/** Disposable lifecycle and actual-console probes for context-owned method stubs. @module */
+import assert from 'node:assert/strict';
+import { setTimeout as delay } from 'node:timers/promises';
+import { EventEmitter } from 'node:events';
+import { describe } from './describe.ts';
+import { it } from './it.ts';
+
+/** Console identity must survive both owners' completion. */
+const originalWarn = Object.getOwnPropertyDescriptor(console, 'warn');
+/** Barriers prove both stubs remain installed across a timer callback. */
+const ready = [Promise.withResolvers<void>(), Promise.withResolvers<void>()];
+await describe({ name: 'actual console ownership', children: ready.map((own, index) => it({
+  name: `console owner ${index}`,
+  fn: async ({ sinon }): Promise<void> => {
+    /** Stub must retain its own call history even when sibling uses the same global. */
+    const fake = sinon.stub(console, 'warn');
+    own.resolve();
+    await Promise.all(ready.map(entry => entry.promise));
+    await delay(1);
+    console.warn(`owner ${index}`);
+    assert.equal(fake.callCount, 1);
+    assert.deepEqual(fake.firstCall.args, [`owner ${index}`]);
+  },
+})) });
+assert.deepEqual(Object.getOwnPropertyDescriptor(console, 'warn'), originalWarn);
+console.log('CONSOLE_CONFIRMED: overlapping actual console.warn stubs retain separate histories across timers');
+
+/** Repetition counter detects a reused fake leaking call history or restoration. */
+let attempt = 0;
+/** Shared object is accessed by the original method through its receiver. */
+const target = { label: 'receiver', value(input: string): string { return `${this.label}:${input}`; } };
+/** Descriptor comparison checks exact cleanup, not just return behavior. */
+const original = Object.getOwnPropertyDescriptor(target, 'value');
+await it({ name: 'repeat and ordinary fake APIs', repeats: 1, fn: async ({ sinon }): Promise<void> => {
+  attempt += 1;
+  /** A new fake starts clean on every attempt. */
+  const fake = sinon.stub(target, 'value').callThrough();
+  assert.equal(fake.callCount, 0);
+  assert.equal(target.value('input'), 'receiver:input');
+  assert.equal(fake.firstCall.thisValue, target);
+  assert.throws(() => sinon.stub(target, 'value'), { message: 'Attempted to wrap value which is already wrapped' });
+  fake.resetHistory();
+  assert.equal(fake.callCount, 0);
+  fake.restore();
+  /** Old fake cleanup must not remove the replacement registered later. */
+  const next = sinon.stub(target, 'value').returns('next');
+  fake.restore();
+  assert.equal(target.value('again'), 'next');
+  assert.equal(next.callCount, 1);
+} });
+assert.equal(attempt, 2);
+assert.deepEqual(Object.getOwnPropertyDescriptor(target, 'value'), original);
+console.log('LIFECYCLE_CONFIRMED: repeats, same-owner rejection, callThrough, this, history reset, restub, stale restore');
+
+/** Tail remains pending until another test owns the same property. */
+const releaseTail = Promise.withResolvers<void>();
+/** Detached work is explicitly awaited after its test times out. */
+const tailDone = Promise.withResolvers<void>();
+/** Observed value must be original, never the next owner's fake. */
+let tailValue: string | undefined;
+try {
+  await it({ name: 'timed-out owner', timeout: 1, fn: async ({ sinon }): Promise<void> => {
+    sinon.stub(target, 'value').returns('expired');
+    await releaseTail.promise;
+    tailValue = target.value('tail');
+    tailDone.resolve();
+  } });
+  assert.fail('Expected timeout');
+} catch (error) {
+  assert.ok(error instanceof Error && error.cause instanceof Error);
+  assert.ok(error.cause.message.includes('timed-out owner'));
+  console.log('EXPECTED_TIMEOUT:', error.cause.message);
+}
+await it({ name: 'subsequent owner', fn: async ({ sinon }): Promise<void> => {
+  /** New owner's fake must never receive work from an expired owner. */
+  const fake = sinon.stub(target, 'value').returns('new owner');
+  releaseTail.resolve();
+  await tailDone.promise;
+  assert.equal(tailValue, 'receiver:tail');
+  assert.equal(fake.callCount, 0);
+  assert.equal(target.value('current'), 'new owner');
+} });
+assert.deepEqual(Object.getOwnPropertyDescriptor(target, 'value'), original);
+console.log('TIMEOUT_CONFIRMED: expired async tail does not enter subsequent owner fake');
+
+/** Event callback ownership is invocation context, not registration context. */
+const emitter = new EventEmitter();
+/** Ready signal ensures registration precedes cross-owner emission. */
+const registered = Promise.withResolvers<void>();
+/** Completion keeps the registering test active through the event. */
+const emitted = Promise.withResolvers<void>();
+/** Records the result of a method lookup inside a cross-owner callback. */
+let eventValue: string | undefined;
+await describe({ name: 'callback ownership boundary', children: [
+  it({ name: 'registering owner', fn: async ({ sinon }): Promise<void> => {
+    sinon.stub(target, 'value').returns('registration');
+    emitter.once('probe', () => { eventValue = target.value('event'); });
+    registered.resolve();
+    await emitted.promise;
+  } }),
+  it({ name: 'emitting owner', fn: async ({ sinon }): Promise<void> => {
+    await registered.promise;
+    sinon.stub(target, 'value').returns('invocation');
+    emitter.emit('probe');
+    emitted.resolve();
+    assert.equal(eventValue, 'invocation');
+  } }),
+] });
+assert.deepEqual(Object.getOwnPropertyDescriptor(target, 'value'), original);
+console.log('BOUNDARY_CONFIRMED: unbound EventEmitter callback uses emitting context, not registering test');
