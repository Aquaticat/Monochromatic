+/** Disposable Node-only method-isolation prototype, not production Sinon coverage. @module */
+import { AsyncLocalStorage } from 'node:async_hooks';
+import type { SinonSandbox } from 'sinon';
+
+/** Unique per-body attempt ownership, including repeated invocations. */
+const storage = new AsyncLocalStorage<object>();
+/** Original descriptor plus active per-attempt private targets. */
+type Slot = {
+  readonly original: PropertyDescriptor;
+  readonly facades: Map<object, Record<PropertyKey, unknown>>;
+};
+/** Registry shares the actual object's property without sharing fake state. */
+const registry = new WeakMap<object, Map<PropertyKey, Slot>>();
+
+/** Runs the unchanged callback under a new attempt identity. @example runWithStubOwner(body) */
+export function runWithStubOwner<Result>(run: () => Result): Result {
+  return storage.run({}, run);
+}
+
+/** Installs method-only interception on an ordinary sandbox. @example adaptSandbox(sandbox) */
+export function adaptSandbox(sandbox: SinonSandbox): void {
+  /** Original Sinon factory still owns fake behavior, matching, and collection cleanup. */
+  const rawStub = sandbox.stub;
+  sandbox.stub = new Proxy(rawStub, {
+    apply(originalStub, receiver, args) {
+      if (args.length === 0) return Reflect.apply(originalStub, receiver, args);
+      /** This experiment deliberately refuses unimplemented API shapes. */
+      const [target, property] = args;
+      /** Active attempt, not merely test name or reusable sandbox. */
+      const owner = storage.getStore();
+      if (args.length !== 2 || owner === undefined || target === null
+        || (typeof target !== 'object' && typeof target !== 'function')
+        || (typeof property !== 'string' && typeof property !== 'symbol')) {
+        throw new Error('Prototype supports only contextual two-argument method stubs');
+      }
+      /** Per-object registry can be allocated lazily. */
+      const properties = registry.get(target) ?? new Map<PropertyKey, Slot>();
+      /** Original shape must not be confused with our temporary accessor. */
+      const previous = properties.get(property);
+      /** The prototype supports configurable own function properties only. */
+      const descriptor = previous?.original ?? Object.getOwnPropertyDescriptor(target, property);
+      if (descriptor?.configurable !== true || typeof descriptor.value !== 'function') {
+        throw new Error('Prototype requires a configurable own method');
+      }
+      /** Cell persists only while at least one owner has a fake. */
+      const slot = previous ?? { original: descriptor, facades: new Map() };
+      /** Reusing the facade retains Sinon's same-owner double-wrap rejection. */
+      const facade = slot.facades.get(owner) ?? Object.defineProperty({}, property, descriptor);
+      /** Ordinary Sinon stub mutates the private facade, never another owner's fake. */
+      const fake = Reflect.apply(originalStub, receiver, [facade, property]);
+      /** Preserve Sinon's restoration of its private target. */
+      const originalRestore = fake.restore;
+      fake.restore = new Proxy(originalRestore, {
+        apply(restore, restoreReceiver, restoreArgs) {
+          /** Keep Sinon cleanup semantics on its own target. */
+          const result = Reflect.apply(restore, restoreReceiver, restoreArgs);
+          if (slot.facades.get(owner) !== facade) return result;
+          slot.facades.delete(owner);
+          if (slot.facades.size === 0) {
+            Object.defineProperty(target, property, slot.original);
+            properties.delete(property);
+          }
+          return result;
+        },
+      });
+      slot.facades.set(owner, facade);
+      if (previous === undefined) {
+        properties.set(property, slot);
+        registry.set(target, properties);
+        Object.defineProperty(target, property, {
+          configurable: true,
+          enumerable: descriptor.enumerable,
+          get() {
+            /** Lookup happens at property read, so extracted references keep ordinary ownership. */
+            const active = storage.getStore();
+            return (active === undefined ? undefined : slot.facades.get(active)?.[property])
+              ?? slot.original.value;
+          },
+        });
+      }
+      return fake;
+    },
+  });
+}
