+/** Disposable issue #481 experiment; imports the fork's harness source. @module */
+import assert from 'node:assert/strict';
+import { describe } from './describe.ts';
+import { it } from './it.ts';
+
+/** Selects expected baseline failure versus prototype success. */
+const mode = process.env.PROBE_MODE ?? 'baseline';
+console.log('PROBE_RUNTIME:', process.version);
+/** Synthetic method target avoids modifying process-wide logging during the probe. */
+const target = {
+  label: 'original',
+  warn(input: string): string { return `${this.label}:${input}`; },
+};
+/** Descriptor must be exactly restored at the consumer boundary. */
+const original = Object.getOwnPropertyDescriptor(target, 'warn');
+/** Each barrier forces overlap without relying on elapsed time. */
+const firstReady = Promise.withResolvers<void>();
+/** The second contender releases the first even if wrapping throws. */
+const secondReady = Promise.withResolvers<void>();
+/** A reader must finish while both writers still own their replacements. */
+const readerReady = Promise.withResolvers<void>();
+/** Captured fake verifies ordinary read-time function ownership. */
+let captured: ((input: string) => string) | undefined;
+/** Consumer-visible marker list proves which bodies reached their assertions. */
+const verified: string[] = [];
+/** Collects the original harness cause chain without error formatting dependencies. */
+function messages(error: unknown): string {
+  /** Work stack covers aggregates and causes. */
+  const queue: unknown[] = [error];
+  /** Message fragments are joined once. */
+  const output: string[] = [];
+  while (queue.length > 0) {
+    /** Current throwable, possibly a primitive. */
+    const current = queue.pop();
+    if (current instanceof Error) {
+      output.push(current.message);
+      if (current.cause !== undefined) queue.push(current.cause);
+      if (current instanceof AggregateError) queue.push(...current.errors);
+    }
+  }
+  return output.join('\n');
+}
+/** Captures expected baseline errors without suppressing the diagnostic assertion. */
+let failure: unknown;
+try {
+  await describe({
+    name: 'issue 481 forced overlap',
+    children: [
+      describe({ name: 'sibling A', concurrency: 1, children: [it({
+        name: 'writer A',
+        fn: async ({ sinon }): Promise<void> => {
+          /** Each sandbox must get an independent fake. */
+          const fake = sinon.stub(target, 'warn').returns('A');
+          captured = target.warn;
+          firstReady.resolve();
+          await secondReady.promise;
+          await readerReady.promise;
+          assert.equal(target.warn('own A'), 'A');
+          assert.equal(target.warn, fake);
+          assert.equal(fake.callCount, 2);
+          assert.equal(fake.getCall(0).args[0], 'captured in B');
+          sinon.restore();
+          assert.equal(target.warn('restored A'), 'original:restored A');
+          verified.push('writer A and independent restore');
+        },
+      })] }),
+      describe({ name: 'sibling B', concurrency: 1, children: [it({
+        name: 'writer B',
+        fn: async ({ sinon }): Promise<void> => {
+          await firstReady.promise;
+          /** Always releases A, including the baseline collision path. */
+          using release = { [Symbol.dispose](): void { secondReady.resolve(); } };
+          /** Independent configuration must not replace A's behavior. */
+          const fake = sinon.stub(target, 'warn').returns('B');
+          assert.equal(target.warn('own B'), 'B');
+          assert.equal(target.warn, fake);
+          assert.equal(captured?.('captured in B'), 'A');
+          assert.equal(fake.callCount, 1);
+          secondReady.resolve();
+          await readerReady.promise;
+          fake.restore();
+          assert.equal(target.warn('restored B'), 'original:restored B');
+          verified.push('writer B, captured reference, and stub restore');
+        },
+      })] }),
+      it({ name: 'unstubbed reader', fn: async (): Promise<void> => {
+        await firstReady.promise;
+        await secondReady.promise;
+        /** Releases both writers even when baseline reader isolation fails. */
+        using release = { [Symbol.dispose](): void { readerReady.resolve(); } };
+        assert.equal(target.warn('reader'), 'original:reader');
+        verified.push('unstubbed reader');
+      } }),
+    ],
+  });
+} catch (error) {
+  failure = error;
+  console.log('observed failure:', messages(error));
+}
+assert.deepEqual(Object.getOwnPropertyDescriptor(target, 'warn'), original);
+if (mode === 'baseline') {
+  assert.ok(messages(failure).includes('Attempted to wrap warn which is already wrapped'));
+  console.log('BASELINE_CONFIRMED: collision with sequential siblings; exact descriptor restored');
+} else {
+  assert.equal(failure, undefined);
+  assert.equal(verified.length, 3);
+  console.log('CONTEXT_CONFIRMED:', verified.join('; '), '; exact descriptor restored');
+}
