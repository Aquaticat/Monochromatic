{
  "license": "LGPL-3.0-or-later",
  "name": "@monochromatic-dev/module-toml-edit",
  "description": "Comment-preserving TOML edit utility built on toml-eslint-parser. Free-function API over an immutable TomlEditState; splice and canonical fidelity modes.",
  "type": "module",
  "version": "0.0.1",
  "private": false,
  "module": "dist/final/neutral/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/final/neutral/index.d.mts",
      "default": "./dist/final/neutral/index.mjs"
    },
    "./ts": "./src/index.ts",
    "./ts/*": "./src/*"
  },
  "dependencies": {
    "@monochromatic-dev/module-caught-value": "workspace:*",
    "@monochromatic-dev/module-logger": "workspace:*",
    "@monochromatic-dev/module-or-throw": "workspace:*",
    "@monochromatic-dev/ownership-marker-foreign-borrowed": "workspace:*",
    "toml-eslint-parser": "catalog:"
  },
  "devDependencies": {
    "@monochromatic-dev/config-tsdown": "workspace:*",
    "@monochromatic-dev/config-typescript": "workspace:*",
    "@monochromatic-dev/module-test": "workspace:*",
    "@monochromatic-dev/test-fixture-toml-edit": "workspace:*",
    "@types/node": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:"
  },
  "files": [
    "dist/final",
    "src",
    "LICENSES"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Aquaticat/Monochromatic.git",
    "directory": "packages/module/toml-edit"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
