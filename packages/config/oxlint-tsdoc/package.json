{
  "name": "@monochromatic-dev/config-oxlint-tsdoc",
  "keywords": [
    "oxlint",
    "tsdoc",
    "config",
    "monochromatic"
  ],
  "dependencies": {
    "@microsoft/tsdoc": "catalog:",
    "@oxlint/plugins": "catalog:"
  },
  "devDependencies": {
    "@monochromatic-dev/config-typescript": "workspace:*",
    "@monochromatic-dev/module-fs-path": "workspace:*",
    "@monochromatic-dev/module-test": "workspace:*",
    "@types/bun": "catalog:",
    "nano-spawn": "catalog:"
  },
  "type": "module",
  "files": [
    "src"
  ],
  "author": {
    "name": "Aquaticat",
    "email": "an@aquati.cat",
    "url": "https://aquati.cat"
  },
  "license": "LGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aquaticat/Monochromatic.git",
    "directory": "packages/config/oxlint-tsdoc"
  },
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./.ts": {
      "default": "./src/index.ts"
    }
  },
  "description": "Oxlint JS plugin providing TSDoc validation rules adapted from eslint-plugin-jsdoc recommended config."
}
