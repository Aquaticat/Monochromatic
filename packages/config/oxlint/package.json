{
  "name": "@monochromatic-dev/config-oxlint",
  "private": false,
  "keywords": [
    "oxlint",
    "config",
    "monochromatic"
  ],
  "dependencies": {
    "@monochromatic-dev/config-oxlint-no-restricted-syntax": "workspace:*",
    "@monochromatic-dev/config-oxlint-prefer-readonly-parameter-type": "workspace:*",
    "@monochromatic-dev/config-oxlint-stylistic": "workspace:*",
    "@monochromatic-dev/config-oxlint-tsdoc": "workspace:*",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  },
  "devDependencies": {
    "@monochromatic-dev/config-rolldown": "workspace:*",
    "@monochromatic-dev/config-typescript": "workspace:*",
    "@types/node": "catalog:"
  },
  "type": "module",
  "files": [
    "src",
    "dist/final",
    "LICENSES"
  ],
  "author": {
    "name": "Aquaticat",
    "email": "an@aquati.cat",
    "url": "https://aquati.cat"
  },
  "license": "LGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aquaticat/Monochromatic.git",
    "directory": "packages/config/oxlint"
  },
  "exports": {
    ".": {
      "types": "./dist/final/node/index.d.mts",
      "default": "./dist/final/node/index.mjs"
    },
    "./ts": "./src/index.ts",
    "./ts/*": "./src/*"
  },
  "description": "Shared oxlint configuration for Monochromatic repositories, exported as a typed OxlintConfig object."
}
