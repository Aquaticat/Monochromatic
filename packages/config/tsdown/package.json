{
  "name": "@monochromatic-dev/config-tsdown",
  "version": "0.0.1",
  "private": false,
  "keywords": [
    "tsdown",
    "config",
    "monochromatic"
  ],
  "devDependencies": {
    "tsdown": "catalog:"
  },
  "type": "module",
  "files": [
    "src",
    "dist/final"
  ],
  "author": {
    "name": "Aquaticat",
    "email": "an@aquati.cat",
    "url": "https://aquati.cat"
  },
  "license": "LGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aquaticat/Monochromatic.git",
    "directory": "packages/config/tsdown"
  },
  "exports": {
    "./.ts": {
      "default": "./src/index.ts"
    },
    "./.node.ts": {
      "default": "./src/index.node.ts"
    },
    "./.client.ts": {
      "default": "./src/index.client.ts"
    }
  },
  "description": "Shared tsdown build configuration for Monochromatic packages.",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
