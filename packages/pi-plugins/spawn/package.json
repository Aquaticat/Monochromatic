{
  "name": "@monochromatic-dev/pi-spawn",
  "description": "Visible child Pi session spawner with automatic parent result forwarding.",
  "type": "module",
  "private": true,
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aquaticat/Monochromatic.git",
    "directory": "packages/pi-plugins/spawn"
  },
  "exports": {
    ".": {
      "types": "./dist/final/node/index.d.mts",
      "default": "./dist/final/node/index.mjs"
    },
    "./ts": "./src/index.ts"
  },
  "bin": {
    "spawn-pi": "./dist/final/node/cli.mjs"
  },
  "pi": {
    "extensions": ["./dist/final/node/index.mjs"]
  },
  "files": [
    "dist/final",
    "src"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "dependencies": {
    "@monochromatic-dev/agent-harnesses-shared-session-discovery": "workspace:*",
    "@monochromatic-dev/agent-harnesses-shared-text-scan": "workspace:*",
    "@monochromatic-dev/module-logger": "workspace:*",
    "@monochromatic-dev/ownership-marker-foreign-borrowed": "workspace:*",
    "@optique/core": "catalog:",
    "@optique/run": "catalog:"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "catalog:",
    "@monochromatic-dev/config-tsdown": "workspace:*",
    "@monochromatic-dev/config-typescript": "workspace:*",
    "@monochromatic-dev/module-test": "workspace:*",
    "@types/node": "catalog:"
  }
}
