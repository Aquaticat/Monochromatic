{
  "license": "LGPL-3.0-or-later",
  "name": "@monochromatic-dev/build-tool-css",
  "private": true,
  "description": "CSS build tool with @mixin/@apply processing and @import resolution for monorepo packages.",
  "type": "module",
  "module": "dist/final/node/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/final/node/index.d.mts",
      "default": "./dist/final/node/index.mjs"
    },
    "./ts": "./src/index.ts",
    "./ts/*": "./src/*.ts"
  },
  "bin": {
    "build-css": "dist/final/node/cli.mjs"
  },
  "main": "dist/final/node/index.mjs",
  "typings": "dist/final/node/index.d.mts",
  "files": [
    "src",
    "dist/final",
    "LICENSES"
  ],
  "devDependencies": {
    "@monochromatic-dev/config-rolldown": "workspace:*",
    "@monochromatic-dev/config-typescript": "workspace:*",
    "@monochromatic-dev/module-test": "workspace:*",
    "@types/node": "catalog:",
    "nano-spawn": "catalog:"
  },
  "dependencies": {
    "@monochromatic-dev/module-fs-path": "workspace:*",
    "@optique/core": "catalog:",
    "@optique/run": "catalog:",
    "postcss": "catalog:"
  },
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aquaticat/Monochromatic.git",
    "directory": "packages/build-tool/css"
  },
  "sideEffects": [
    "./src/process-shim.ts"
  ]
}
