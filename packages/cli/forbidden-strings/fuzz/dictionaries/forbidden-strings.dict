# libFuzzer dictionary for forbidden-strings fuzz targets.
# Format: one entry per line as `name="value"` or just `"value"`.
# Bytes inside the quotes are taken literally; `\xHH` for binary
# bytes. The tokens here cover parser branches the bug class behind
# e49d8694 / e100659f / 9b41fca0 / 1463c59b exercised.

# Inline flags
"/"
"//i"
"(?i)"
"(?u)"
"(?iu)"
"(?-i)"
"(?i:"
"(?x:"
"(?u:"

# Groups (capturing / non-capturing / named / lookaround)
"("
")"
"(?:"
"(?="
"(?!"
"(?<="
"(?<!"
"(?P<"
"(?<name>"
"(?#"

# Character classes
"["
"]"
"[^"
"[_]"
"[A-Z]"
"[a-z]"
"[0-9]"

# Anchors and shorthands
"\b"
"\B"
"\s"
"\S"
"\w"
"\W"
"\d"
"\D"
"\A"
"\z"
"^"
"$"

# Resharp algebra
"&"
"~("
"~["
"(A&B)|C"
"A&(B|C)"

# Wildcard underscore triad
"_"
"\_"
"[_]"

# Quantifiers and metacharacters
"*"
"+"
"?"
"|"
"{0,50}"
"{1,3}"
"{0}"
"."

# Content fixtures (multi-byte / boundary-relevant)
"\xc2\xa0"          # NBSP U+00A0
"\xe2\x80\x94"      # em dash U+2014
"\xe2\x80\x9c"      # left smart double quote
"\xe2\x80\x9d"      # right smart double quote
"\xe2\x80\x98"      # left smart single quote
"\xe2\x80\x99"      # right smart single quote
"\xe2\x80\x83"      # em space U+2003
"\xe3\x80\x80"      # ideographic space U+3000
"\x00"              # NUL

# Common rule-source motifs from test corpus
"—password"
"—token"
"(?i)—Password"
"(?:—password|—token)"
"(?<=foo)bar"
"foo(?=x)bar"
"required\_(?x:foo bar)"
"pre_post"
"literalA(?i)keyword-suffix"
"cohere"
"CO_API_KEY"
"étudiant"
"cafésecret"
