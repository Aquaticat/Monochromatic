{
  "license": "LGPL-3.0-or-later",
  "name": "@monochromatic-dev/cli-git",
  "description": "Policy-aware Git wrapper and side-effect-free policy authoring API.",
  "type": "module",
  "private": false,
  "main": "dist/final/node/index.mjs",
  "types": "dist/final/node/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/final/node/index.d.mts",
      "import": "./dist/final/node/index.mjs"
    }
  },
  "bin": {
    "git": "dist/final/node/bin.mjs"
  },
  "files": [
    "dist/final/node",
    "LICENSES",
    "README.md"
  ],
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@monochromatic-dev/config-tsdown": "workspace:*",
    "@monochromatic-dev/config-typescript": "workspace:*",
    "@monochromatic-dev/module-fs-path": "workspace:*",
    "@monochromatic-dev/module-logger": "workspace:*",
    "@monochromatic-dev/module-test": "workspace:*",
    "@types/node": "catalog:",
    "nano-spawn": "catalog:"
  },
  "dependencies": {
    "@optique/core": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "valibot": "catalog:"
  },
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aquaticat/Monochromatic.git",
    "directory": "packages/cli/git"
  },
  "sideEffects": [
    "dist/final/node/bin.mjs"
  ]
}
