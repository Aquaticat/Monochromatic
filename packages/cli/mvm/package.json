{
  "license": "LGPL-3.0-or-later",
  "name": "@monochromatic-dev/cli-mvm",
  "description": "CLI tool for creating and managing ephemeral KVM virtual machines.",
  "type": "module",
  "private": true,
  "main": "src/index.ts",
  "bin": {
    "mvm": "src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./ts": "./src/index.ts",
    "./ts/*": "./src/*",
    "./list": "./src/list.ts",
    "./create": "./src/create.ts",
    "./destroy": "./src/destroy.ts",
    "./exec": "./src/exec.ts",
    "./run": "./src/run.ts",
    "./clone": "./src/clone.ts",
    "./registry": "./src/registry.ts",
    "./update": "./src/update.ts",
    "./meta": "./src/meta.ts",
    "./file-transfer": "./src/file-transfer.ts"
  },
  "devDependencies": {
    "@monochromatic-dev/config-typescript": "workspace:*",
    "@monochromatic-dev/module-test": "workspace:*",
    "@types/bun": "catalog:"
  },
  "dependencies": {
    "@monochromatic-dev/module-logger": "workspace:*",
    "@monochromatic-dev/module-hyperscript": "workspace:*",
    "@monochromatic-dev/module-const": "workspace:*",
    "@monochromatic-dev/module-numeric-format": "workspace:*",
    "nano-spawn": "catalog:",
    "@optique/core": "catalog:",
    "@optique/run": "catalog:"
  },
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aquaticat/Monochromatic.git",
    "directory": "packages/cli/mvm"
  },
  "sideEffects": true
}
