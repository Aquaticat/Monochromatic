{
  "license": "LGPL-3.0-or-later",
  "name": "@monochromatic-dev/cli-terminal-exec",
  "description": "Cross-platform terminal emulator launcher. XDG + KDE kdeglobals on Linux, Windows Terminal / cmd on Windows.",
  "type": "module",
  "private": true,
  "main": "src/launch.ts",
  "bin": {
    "terminal-exec": "src/index.ts"
  },
  "exports": {
    ".": "./src/launch.ts",
    "./ts": "./src/launch.ts",
    "./ts/*": "./src/*"
  },
  "devDependencies": {
    "@monochromatic-dev/config-typescript": "workspace:*",
    "@monochromatic-dev/module-test": "workspace:*",
    "@types/bun": "catalog:"
  },
  "dependencies": {
    "@monochromatic-dev/module-logger": "workspace:*"
  },
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aquaticat/Monochromatic.git",
    "directory": "packages/cli/terminal-exec"
  },
  "sideEffects": true
}
