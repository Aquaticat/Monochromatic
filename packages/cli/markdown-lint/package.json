{
  "name": "@monochromatic-dev/cli-markdown-lint",
  "private": true,
  "keywords": [
    "markdown",
    "mdx",
    "linter",
    "monochromatic"
  ],
  "dependencies": {
    "@monochromatic-dev/module-logger": "workspace:*",
    "@monochromatic-dev/module-or-throw": "workspace:*",
    "@monochromatic-dev/ownership-marker-foreign-borrowed": "workspace:*",
    "ignore": "catalog:",
    "satteri": "catalog:",
    "type-fest": "catalog:"
  },
  "devDependencies": {
    "@monochromatic-dev/config-tsdown": "workspace:*",
    "@monochromatic-dev/config-typescript": "workspace:*",
    "@monochromatic-dev/module-test": "workspace:*",
    "@types/mdast": "catalog:",
    "@types/node": "catalog:",
    "@types/unist": "catalog:",
    "typescript": "catalog:"
  },
  "type": "module",
  "main": "src/index.ts",
  "module": "dist/final/node/index.mjs",
  "bin": {
    "markdown-lint": "dist/final/node/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/final/node/index.d.mts",
      "default": "./dist/final/node/index.mjs"
    },
    "./ts": "./src/index.ts",
    "./ts/*": "./src/*"
  },
  "files": [
    "dist/final",
    "src",
    "LICENSES"
  ],
  "author": {
    "name": "Aquaticat",
    "email": "an@aquati.cat",
    "url": "https://aquati.cat"
  },
  "license": "LGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aquaticat/Monochromatic.git",
    "directory": "packages/cli/markdown-lint"
  },
  "sideEffects": true,
  "description": "Purpose-built Markdown and MDX linter with localized autofixes, replacing markdownlint-cli2; runs under Node."
}
