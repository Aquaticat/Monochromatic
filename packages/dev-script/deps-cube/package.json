{
  "license": "LGPL-3.0-or-later",
  "name": "@monochromatic-dev/dev-script-deps-cube",
  "description": "Catalog dependency audit report: interactive 3D scatter (deck.gl WebGL) rendering each catalog package as a feature vector across TS-ratio, source size, install size, staleness, downloads, and dep count.",
  "type": "module",
  "private": true,
  "module": "dist/final/node/index.mjs",
  "main": "dist/final/node/index.mjs",
  "typings": "dist/final/node/index.d.mts",
  "exports": {
    ".": "./dist/final/node/index.mjs",
    "./ts": "./src/index.ts"
  },
  "bin": {
    "deps-cube": "./dist/final/node/cli.mjs"
  },
  "files": [
    "dist/final",
    "src"
  ],
  "devDependencies": {
    "@monochromatic-dev/config-tsdown": "workspace:*",
    "@monochromatic-dev/config-typescript": "workspace:*",
    "@monochromatic-dev/module-test": "workspace:*",
    "@types/bun": "catalog:"
  },
  "dependencies": {
    "@cspotcode/outdent": "catalog:",
    "@deck.gl/core": "catalog:",
    "@deck.gl/layers": "catalog:",
    "@deck.gl/mesh-layers": "catalog:",
    "@luma.gl/engine": "catalog:",
    "@monochromatic-dev/module-es": "workspace:*",
    "@monochromatic-dev/module-fs-path": "workspace:*",
    "@monochromatic-dev/module-numeric-const": "workspace:*",
    "find-up": "catalog:",
    "nano-spawn": "catalog:",
    "p-limit": "catalog:",
    "yaml": "catalog:"
  },
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aquaticat/Monochromatic.git",
    "directory": "packages/dev-script/deps-cube"
  },
  "sideEffects": true
}
