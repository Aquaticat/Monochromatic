---
import {
  i18n,
  langs,
  names,
  posts,
} from '@/src';
import Html from '@_/layouts/Html.astro';
import type { GetStaticPaths, } from 'astro';
import { render, } from 'astro:content';

export const getStaticPaths: GetStaticPaths = async () => langs.flatMap(lang => (names.map(name => ({
    params: { lang, name, },
  }))));

const { lang, name, } = Astro.params;
const potentialPost = posts.find(post => post.name === name && post.lang === lang);
const PotentialContent = potentialPost && (await render(potentialPost,)).Content;
const postDoesntExist = i18n.get("Post doesn't exist in specified language",);
const title = potentialPost
  ? potentialPost.data.title
  : postDoesntExist?.get(lang,) ?? "Post doesn't exist in specified language";
---
<Html
  {title}
  {lang}>
  <main>
    <h1>{title}</h1>
    {
      PotentialContent ? <PotentialContent /> : (
        <p>
          Redirecting to <a
            class='redirectingTo'
            href={`/${name}`}>Choose a language page for {name}</a>
        </p>
      )
    }
  </main>
</Html>
