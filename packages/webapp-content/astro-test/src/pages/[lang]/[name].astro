---
// oxlint-disable tsdoc/require-tsdoc, no-non-null-assertion, no-restricted-syntax/no-arrow-function, typescript-eslint/no-unsafe-member-access, typescript-eslint/no-unsafe-assignment, typescript-eslint/no-unsafe-call, typescript-eslint/no-unsafe-type-assertion, typescript-eslint/explicit-function-return-type, require-await -- Astro component frontmatter with framework-dictated patterns
import {
  i18n,
  langs,
  names,
  posts,
} from '@/src';
import Html from '@_/layouts/Html.astro';
import type { GetStaticPaths, } from 'astro';
import { render, } from 'astro:content';

export async function getStaticPaths() { return langs.flatMap(lang => (names.map(name => ({
    params: { lang, name, },
  })))) }

const { lang, name, } = Astro.params;
const potentialPost = posts.find(post => post.name === name && post.lang === lang);
const PotentialContent = potentialPost && (await render(potentialPost,)).Content;
const title = potentialPost
  ? potentialPost.data.title
  : i18n.get("Post doesn't exist in specified language",)!.get(lang,)!;
---
<Html
  {title}
  {lang}>
  <main>
    <h1>{title}</h1>
    {
      PotentialContent ? <PotentialContent /> : (
        <p>
          Redirecting to <a
            class='redirectingTo'
            href={`/${name}`}>Choose a language page for {name}</a>
        </p>
      )
    }
  </main>
</Html>
