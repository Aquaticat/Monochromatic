---
// oxlint-disable tsdoc/require-tsdoc, no-non-null-assertion, no-restricted-syntax/no-arrow-function, typescript-eslint/no-unsafe-member-access, typescript-eslint/no-unsafe-assignment -- Astro component frontmatter
import Html from '@_/layouts/Html.astro';

import {
  names,
  postsGroupedByName,
} from '@/src';

type StaticPath = { params: { name: string; }; };

export async function getStaticPaths(): Promise<StaticPath[]> {
  return names.map(name => ({
    params: { name, },
  }));
}

const { name, } = Astro.params;
const namePosts = postsGroupedByName[name]!;
---

<Html
  title={name}
  lang='en'>
  <main>
    <h1>{name}</h1>
    <ul>
      {
        namePosts.map(post => (
          <li>
            <a href={`/${post.id}`}>{post.data.title}</a>
          </li>
        ))
      }
    </ul>
  </main>
</Html>
