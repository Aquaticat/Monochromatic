---
// oxlint-disable tsdoc/require-tsdoc, no-non-null-assertion -- Astro component frontmatter
// eslint-disable-next-line import/no-unassigned-import -- Pre-built CSS bundle
import '../../dist/bundle.css';
import { i18n, } from '@_/index.ts';
import { types, } from '@monochromatic-dev/module-es';
type Props = {
  title: string;
  lang: string;
};
const { title, lang, } = Astro.props;
---
<head>
  <meta charset='utf-8'>
  <meta
    name='viewport'
    content='width=device-width, initial-scale=1'>
  <link
    rel='icon'
    href='/favicon.svg'
    type='image/svg+xml'>
  <title>{title} | {i18n.get('siteName',)!.get(lang,)!}</title>
  <script>
  types.never.from.never.onLoadRedirectingTo.sync.positional.$();
  </script>
</head>
