{
  "name": "agent-resume-guard",
  "description": "Blocks Agent resume calls to prevent polling loops on background agents.",
  "version": "0.0.1",
  "author": {
    "name": "Aquaticat"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/dist/final/ccarg.js"
          }
        ]
      }
    ]
  }
}
