{
  "license": "LGPL-3.0-or-later",
  "name": "@monochromatic-dev/mcp-nvim",
  "version": "0.1.0",
  "description": "MCP server that exposes Neovim diagnostics and current file to Factory Droid.",
  "type": "module",
  "private": true,
  "module": "dist/final/node/index.mjs",
  "bin": {
    "nvim-mcp": "./dist/final/node/index.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/final/node/index.d.mts",
      "default": "./dist/final/node/index.mjs"
    },
    "./ts": "./src/index.ts"
  },
  "files": [
    "dist/final",
    "src"
  ],
  "dependencies": {
    "neovim": "catalog:"
  },
  "devDependencies": {
    "@monochromatic-dev/config-tsdown": "workspace:*",
    "@monochromatic-dev/config-typescript": "workspace:*",
    "@monochromatic-dev/mcp-stdio": "workspace:*",
    "@monochromatic-dev/module-test": "workspace:*",
    "@types/bun": "catalog:",
    "nano-spawn": "catalog:",
    "typescript": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Aquaticat/Monochromatic.git",
    "directory": "packages/mcp/nvim"
  }
}
