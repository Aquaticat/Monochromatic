// Column-strip virtualization spike UI.
//
// The interaction model is Niri-like: a horizontal strip of columns, each
// column stacking one or more panes vertically. The whole point of this spike
// is that Slint has no built-in two-dimensional strip virtualization, so Rust
// does the windowing: it holds the FULL strip as cheap identity but publishes
// only a BOUNDED WINDOW (visible columns plus one prefetch column each side, and
// within each column only the visible panes plus one prefetch pane each side) to
// the models below. Slint's `for` instantiates exactly one element per model
// row, so publishing a small window is what keeps instantiation bounded.
//
// Everything comes IN from Rust as properties; every user action goes OUT as a
// callback. No windowing logic lives here.
//
// The row list inside a directory pane is a std-widgets `ListView`, the one
// widget Slint documents as instantiating only visible items; its model is a
// custom Rust `Model` that counts `row_data` access, so row virtualization is
// measured, not assumed.

import { ListView, Slider, Button, Palette } from "std-widgets.slint";

// One directory row. Rust's custom row model generates these on demand; the
// label is synthetic ("entry 000123") so a pane can advertise a huge row count
// without allocating every row up front.
struct RowView {
    label: string,
    index: int,
}

// One pane inside a column. `kind` is 0 for a directory listing (shows `rows` in
// a ListView) or 1 for a file preview (shows the decoded `preview` image).
// `rows` is only populated for directory panes; `preview` only for preview panes
// that are currently in-window (Rust decodes on entry, drops on exit).
struct PaneView {
    pane-id: int,
    kind: int,
    title: string,
    y-px: length,
    height-px: length,
    is-active: bool,
    rows: [RowView],
    row-total: int,
    preview: image,
    resident: bool,
}

// One column in the strip. `x-px` is its absolute position inside the strip's
// horizontal content; `panes` holds only the vertically-windowed panes for this
// column; `v-offset-px` is this column's own vertical scroll (Niri scrolls the
// focused column), applied here so windowed panes land in the viewport.
struct ColumnView {
    strip-index: int,
    x-px: length,
    width-px: length,
    is-active: bool,
    panes: [PaneView],
    column-height-px: length,
    v-offset-px: length,
}

export component AppWindow inherits Window {
    title: "Monochromatic File Manager (virtualization spike)";
    preferred-width: 1100px;
    preferred-height: 720px;
    background: Palette.background;
    forward-focus: strip-focus;

    // Strip geometry and the bounded columns window (all IN from Rust).
    in property <[ColumnView]> columns: [];
    in property <length> strip-width-px: 1000px;
    in property <length> column-width-px: 320px;

    // Instrumentation, all IN from Rust. `total-*` count the full strip; the
    // `resident-*` count only what Rust published into the window; the `*-builds`
    // are Slint-side init counters (see the `init =>` callbacks below) that
    // cross-check Slint actually instantiates the window, not the whole strip.
    in property <int> total-columns: 0;
    in property <int> resident-columns: 0;
    in property <int> total-panes: 0;
    in property <int> resident-panes: 0;
    in property <int> live-row-delegates: 0;
    in property <int> total-rows-addressable: 0;
    in property <int> decoded-image-kib: 0;
    in property <int> decode-count: 0;
    in property <int> pending-decodes: 0;
    in property <int> column-builds: 0;
    in property <int> pane-builds: 0;
    in property <int> active-column: 0;
    in property <int> active-pane: 0;
    in property <bool> active-pane-focused: false;

    // Horizontal scroll position in pixels (positive = scrolled right). Two-way
    // so the h-position slider and the Flickable stay in sync.
    in-out property <length> h-scroll-px: 0px;

    // Row context-menu state. `last-menu` is the HUD read-back of the last menu
    // command plus the (pane, row) identity it targeted, so a headless MCP session
    // can confirm the command received the correct FileEntry identity. The
    // `menu-target-*` pair is the currently targeted row, used to highlight it so
    // the clicked/focused row is visibly deterministic; -1 means "no target".
    // Rust is the source of truth (mirrored in on a timer); the mouse handlers
    // also set the target directly for instant highlight with no timer lag.
    in property <string> last-menu: "";
    in-out property <int> menu-target-pane-id: -1;
    in-out property <int> menu-target-row: -1;

    // Outbound actions.
    callback horizontal-scrolled(float);
    callback vertical-scrolled(float);
    callback key-nav(string);
    callback column-built();
    callback pane-built();
    callback active-focus-changed(bool);
    // A row was activated (left-clicked or right-clicked): Rust records it as the
    // menu target so a following menu command carries this (pane-id, row) identity.
    callback row-activate(int, int);
    // The keyboard menu key was pressed on the active pane: Rust sets the menu
    // target to the active pane's active row before the menu shows.
    callback menu-key();
    // A menu command was chosen; Rust resolves it against the current target.
    callback menu-action(string);

    VerticalLayout {
        // Instrumentation HUD. Element ids (hud := ...) let the MCP server read
        // these strings back with get_element_properties.
        Rectangle {
            height: 82px;
            background: Palette.alternate-background;
            border-width: 1px;
            border-color: Palette.border;
            VerticalLayout {
                padding: 6px;
                spacing: 2px;
                hud-a := Text {
                    text: "columns resident/total: " + root.resident-columns + "/" + root.total-columns
                        + "   panes resident/total: " + root.resident-panes + "/" + root.total-panes
                        + "   builds col/pane: " + root.column-builds + "/" + root.pane-builds;
                    color: Palette.foreground;
                    font-size: 13px;
                }
                hud-b := Text {
                    text: "rows materialized: " + root.live-row-delegates + " of " + root.total-rows-addressable + " addressable"
                        + "   decoded images: " + root.decoded-image-kib + " KiB resident, " + root.decode-count + " decodes, "
                        + root.pending-decodes + " decoding";
                    color: Palette.foreground;
                    font-size: 13px;
                }
                hud-c := Text {
                    text: "active column/pane: " + root.active-column + "/" + root.active-pane
                        + "   focus: " + (root.active-pane-focused ? "yes" : "no");
                    color: Palette.foreground;
                    font-size: 13px;
                }
                hud-d := Text {
                    text: "last menu: " + (root.last-menu == "" ? "(none)" : root.last-menu);
                    color: Palette.foreground;
                    font-size: 13px;
                }
            }
        }

        // MCP-drivable controls: two sliders (horizontal strip position, active
        // column vertical position) plus buttons that map to the keyboard nav.
        // set_element_value on a slider or click_element on a button lets a
        // headless MCP session drive the strip with no key injection.
        Rectangle {
            height: 40px;
            background: Palette.alternate-background;
            HorizontalLayout {
                padding: 6px;
                spacing: 8px;
                h-slider := Slider {
                    minimum: 0;
                    maximum: 100;
                    value: 0;
                    // Drive the Flickable, not the callback directly: setting
                    // h-scroll-px (two-way bound to viewport-x) moves the strip,
                    // whose `changed viewport-x` then fires horizontal-scrolled
                    // with the resulting pixel offset. viewport-x is <= 0, so the
                    // fraction is negated. This is the MCP-drivable horizontal
                    // path (set_element_value on this slider).
                    changed(v) => {
                        root.h-scroll-px = 0px - (v / 100 * (root.strip-width-px - root.width));
                    }
                }
                v-slider := Slider {
                    minimum: 0;
                    maximum: 100;
                    value: 0;
                    changed(v) => {
                        root.vertical-scrolled(v);
                    }
                }
                // Element ids (btn-left := ...) let the MCP server drive keyboard
                // navigation with click_element in headless tests.
                btn-left := Button {
                    text: "◀";
                    clicked => { root.key-nav("Left"); }
                }
                btn-right := Button {
                    text: "▶";
                    clicked => { root.key-nav("Right"); }
                }
                btn-up := Button {
                    text: "▲";
                    clicked => { root.key-nav("Up"); }
                }
                btn-down := Button {
                    text: "▼";
                    clicked => { root.key-nav("Down"); }
                }
                btn-close := Button {
                    text: "close col";
                    clicked => { root.key-nav("Close"); }
                }
                // Drives the keyboard-menu path headless: set the target to the
                // active pane's active row, then show the context menu. Mirrors the
                // pane FocusScope's Menu-key/Shift+F10 handler so MCP can exercise
                // the keyboard path without key injection.
                btn-menu := Button {
                    text: "menu key";
                    clicked => {
                        root.menu-key();
                        context-menu.show({ x: 60px, y: 120px });
                    }
                }
            }
        }

        // The strip itself. A FocusScope wraps a horizontal Flickable so real
        // keyboard input works when the app runs live (arrows nav, PageUp/Down
        // scroll the active column). The Flickable owns horizontal pixel scroll
        // over the FULL strip width, but only the windowed columns exist inside.
        strip-focus := FocusScope {
            key-pressed(event) => {
                if event.text == Key.LeftArrow {
                    root.key-nav("Left");
                } else if event.text == Key.RightArrow {
                    root.key-nav("Right");
                } else if event.text == Key.UpArrow {
                    root.key-nav("Up");
                } else if event.text == Key.DownArrow {
                    root.key-nav("Down");
                }
                accept
            }

            // ContextMenuArea wraps the whole strip. Its built-in right-click path
            // only fires on areas NOT covered by an inner TouchArea (Slint issue
            // #12354: row TouchAreas grab the right press first), so directory rows
            // must call `context-menu.show(...)` from their own pointer-event. This
            // is that workaround; the empty pane background (no TouchArea) still
            // opens this menu through the built-in path, which is the contrast that
            // demonstrates the issue in this app.
            context-menu := ContextMenuArea {
                Menu {
                    MenuItem {
                        title: "Open";
                        activated => { root.menu-action("Open"); }
                    }
                    MenuItem {
                        title: "Rename";
                        activated => { root.menu-action("Rename"); }
                    }
                    MenuItem {
                        title: "Delete";
                        activated => { root.menu-action("Delete"); }
                    }
                }

                strip-flick := Flickable {
                    viewport-width: root.strip-width-px;
                    viewport-height: self.height;
                    viewport-x <=> root.h-scroll-px;
                    changed viewport-x => {
                        root.horizontal-scrolled((0px - self.viewport-x) / 1px);
                    }

                    for col in root.columns: Rectangle {
                        x: col.x-px;
                        y: 0px;
                        width: col.width-px;
                        height: parent.height;
                        background: col.is-active ? Palette.accent-background.with-alpha(0.08) : transparent;
                        border-width: 1px;
                        border-color: Palette.border;

                        // Cross-check: Slint fires init once per instantiated column.
                        // Over a scroll sweep this total grows with distance travelled
                        // (recycling), NOT with the strip size (retention would).
                        init => {
                            root.column-built();
                        }

                        // The column's panes are absolutely positioned by their
                        // y-px minus this column's vertical scroll offset. Rust has
                        // already windowed them, so only in-view panes are present.
                        for pane in col.panes: Rectangle {
                            x: 4px;
                            y: pane.y-px - col.v-offset-px;
                            width: parent.width - 8px;
                            height: pane.height-px - 6px;
                            background: Palette.control-background;
                            border-width: pane.is-active ? 2px : 1px;
                            border-color: pane.is-active ? Palette.accent-background : Palette.border;

                            init => {
                                root.pane-built();
                            }

                            // Pane-level FocusScope wrapping BOTH kinds. Focus
                            // survival: when the active pane is (re)instantiated after
                            // recycling, re-assert focus from Rust-held identity and
                            // report the focus state back for the HUD. Wrapping both
                            // kinds means the active pane keeps focus whether it is a
                            // directory or a preview.
                            pane-focus := FocusScope {
                                width: parent.width;
                                height: parent.height;
                                init => {
                                    if pane.is-active {
                                        self.focus();
                                    }
                                }
                                changed has-focus => {
                                    if pane.is-active {
                                        root.active-focus-changed(self.has-focus);
                                    }
                                }
                                // Keyboard context-menu paths. Slint's ContextMenuArea
                                // wires the dedicated Menu key everywhere but Shift+F10
                                // only on Windows (items.rs is_menu_key), and shows at
                                // its own 0,0 corner. Handle both here for cross-platform
                                // parity and to position the menu at the focused pane;
                                // accept preempts the built-in so the menu shows once,
                                // other keys reject and bubble to strip-focus for nav.
                                key-pressed(event) => {
                                    if (event.text == Key.Menu
                                            || (event.text == Key.F10 && event.modifiers.shift)) {
                                        root.menu-key();
                                        context-menu.show({
                                            x: self.absolute-position.x - context-menu.absolute-position.x + 20px,
                                            y: self.absolute-position.y - context-menu.absolute-position.y + 20px,
                                        });
                                        return accept;
                                    }
                                    return reject;
                                }

                                VerticalLayout {
                                    padding: 4px;
                                    spacing: 2px;
                                    Text {
                                        text: pane.title;
                                        color: Palette.foreground;
                                        font-size: 12px;
                                        overflow: elide;
                                    }

                                    // Directory pane (kind 0): a virtualizing ListView
                                    // over the custom row model. ListView instantiates
                                    // only visible row delegates, so row-data is pulled
                                    // sparsely from the huge model.
                                    if pane.kind == 0: ListView {
                                        for row in pane.rows: Rectangle {
                                            height: 22px;
                                            // Highlight the current menu target (the
                                            // clicked or keyboard-focused row) so the
                                            // deterministic target is visible; else the
                                            // hover tint.
                                            background: (root.menu-target-pane-id == pane.pane-id && root.menu-target-row == row.index)
                                                ? Palette.accent-background.with-alpha(0.25)
                                                : (touch.has-hover ? Palette.accent-background.with-alpha(0.12) : transparent);
                                            touch := TouchArea {
                                                // Left-click selects: record the row as
                                                // the menu target (identity for a later
                                                // keyboard menu) and move the highlight.
                                                // Selection still works; this is the
                                                // pre-existing click path now carrying id.
                                                clicked => {
                                                    root.row-activate(pane.pane-id, row.index);
                                                    root.menu-target-pane-id = pane.pane-id;
                                                    root.menu-target-row = row.index;
                                                }
                                                // Right-click is the #12354 workaround:
                                                // the built-in ContextMenuArea never sees
                                                // this press (this TouchArea grabs it), so
                                                // forward it by recording identity and
                                                // calling show() with the click position
                                                // translated into the ContextMenuArea's
                                                // space (the same absolute-position maths
                                                // Slint's own listview.slint uses).
                                                pointer-event(pe) => {
                                                    if (pe.button == PointerEventButton.right
                                                            && pe.kind == PointerEventKind.up) {
                                                        root.row-activate(pane.pane-id, row.index);
                                                        root.menu-target-pane-id = pane.pane-id;
                                                        root.menu-target-row = row.index;
                                                        context-menu.show({
                                                            x: self.absolute-position.x + self.mouse-x - context-menu.absolute-position.x,
                                                            y: self.absolute-position.y + self.mouse-y - context-menu.absolute-position.y,
                                                        });
                                                    }
                                                }
                                            }
                                            Text {
                                                x: 6px;
                                                text: row.label;
                                                color: Palette.foreground;
                                                font-size: 12px;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    // Preview pane (kind 1): the decoded image when Rust
                                    // has it resident, else a placeholder telling the
                                    // reader the bitmap was evicted (identity survives).
                                    if pane.kind == 1: Rectangle {
                                        Image {
                                            source: pane.preview;
                                            image-fit: contain;
                                            width: parent.width;
                                            height: parent.height;
                                        }
                                        if !pane.resident: Text {
                                            text: "decoding…\n(off the UI thread)";
                                            color: Palette.foreground;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
