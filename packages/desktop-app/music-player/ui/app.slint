// The player window: a seek bar on top, a transport row (prev / play-pause /
// next, shuffle, repeat, open), a volume slider, a page-tab bar, and a
// click-to-play queue list below. The queue is paginated on two axes (decided
// per track in Rust): a track in a subfolder gets a page per top-level folder
// under the loaded root (one level only; the tab is that folder); a track at the
// loaded root gets a first-letter page (A-Z, plus a `#` catch-all). The list
// shows only the selected page's tracks, each row showing its path relative to
// the loaded root (so deeper nesting stays visible). The currently playing
// track is the highlighted row, so no separate now-playing title is drawn. All
// state comes IN from Rust via properties; all user actions go OUT to Rust via
// callbacks. No playback logic (including the pagination grouping) lives here.
//
// Numeric time values (position/duration) are kept as `float` seconds for the
// slider, while their human-readable "m:ss" forms arrive as separate string
// properties formatted in Rust (Slint's number formatting is awkward).

import { Button, Slider, ListView, HorizontalBox, VerticalBox } from "std-widgets.slint";

// One row on the selected page: the display path (relative to the loaded root)
// plus its index into the full queue. The index survives filtering, so clicking a
// filtered row still maps back to the right track. Rust fills these from the
// pagination module.
struct PageItem {
    name: string,
    index: int,
}

export component AppWindow inherits Window {
    title: "Music Player";
    preferred-width: 480px;
    preferred-height: 600px;

    // Inputs from Rust (the engine pushes these via Update messages).
    in property <string> track-name: "";
    in property <float> position: 0;
    in property <float> duration: 0;
    in property <string> position-text: "0:00";
    in property <string> duration-text: "0:00";
    in property <bool> playing: false;
    in property <float> volume: 1.0;
    in property <bool> shuffle: false;
    in property <int> repeat-mode: 0;
    in property <int> current-index: -1;
    in property <[string]> queue: [];

    // Pagination view, derived in Rust from `queue`. `page-labels` are the tab
    // captions (a top-level folder, an A-Z letter, or `#`; folder pages first,
    // then letters, then `#`); `selected-page` is the index of the visible tab;
    // `page-items` are only the selected page's tracks.
    in property <[string]> page-labels: [];
    in property <int> selected-page: 0;
    in property <[PageItem]> page-items: [];

    // Outputs to Rust (each maps to one engine Command).
    callback toggle-play();
    callback prev();
    callback next();
    callback seek(float);
    callback set-volume(float);
    callback toggle-shuffle();
    callback cycle-repeat();
    callback play-index(int);
    callback open-files();
    // The user clicked a page tab; the argument is the page index. Rust swaps the
    // visible page (refills `page-items` and updates `selected-page`).
    callback select-page(int);

    // Label for the repeat button, chosen by the integer mode (0/1/2). Pure
    // integer comparisons only, so no number-to-string formatting is needed.
    pure function repeat-label(mode: int) -> string {
        return mode == 1 ? "Repeat: all" : mode == 2 ? "Repeat: one" : "Repeat: off";
    }

    VerticalBox {
        padding: 12px;
        spacing: 8px;

        HorizontalBox {
            alignment: stretch;
            Text {
                text: root.position-text;
                vertical-alignment: center;
            }
            Slider {
                horizontal-stretch: 1;
                minimum: 0;
                maximum: root.duration > 0 ? root.duration : 1.0;
                value: root.position;
                changed(value) => {
                    root.seek(value);
                }
            }
            Text {
                text: root.duration-text;
                vertical-alignment: center;
            }
        }

        HorizontalBox {
            alignment: center;
            Button {
                text: "Prev";
                clicked => {
                    root.prev();
                }
            }
            Button {
                text: root.playing ? "Pause" : "Play";
                clicked => {
                    root.toggle-play();
                }
            }
            Button {
                text: "Next";
                clicked => {
                    root.next();
                }
            }
            Button {
                text: root.shuffle ? "Shuffle: on" : "Shuffle: off";
                clicked => {
                    root.toggle-shuffle();
                }
            }
            Button {
                text: repeat-label(root.repeat-mode);
                clicked => {
                    root.cycle-repeat();
                }
            }
            Button {
                text: "Open";
                // Highlight (accent style) when the queue is empty, so a fresh
                // launch points the user at the only useful action.
                primary: root.queue.length == 0;
                clicked => {
                    root.open-files();
                }
            }
        }

        HorizontalBox {
            Text {
                text: "Volume";
                vertical-alignment: center;
            }
            Slider {
                horizontal-stretch: 1;
                minimum: 0;
                maximum: 1.0;
                value: root.volume;
                changed(value) => {
                    root.set-volume(value);
                }
            }
        }

        // Page-tab bar: one tab per page (top-level folder or letter), shown only
        // when the queue has at least one page. Wrapped in a Flickable so a wide
        // row of tabs (many folders or letters) scrolls horizontally instead of
        // being clipped. viewport-width is bound to the tab row's natural width so
        // the scrollable area is exactly the content width.
        if root.page-labels.length > 0: Flickable {
            height: 36px;
            viewport-height: 36px;
            viewport-width: tab-row.preferred-width;
            tab-row := HorizontalLayout {
                spacing: 4px;
                for label[p] in root.page-labels: Button {
                    text: label;
                    // The active page's tab is drawn with the accent style.
                    primary: p == root.selected-page;
                    clicked => {
                        root.select-page(p);
                    }
                }
            }
        }

        ListView {
            vertical-stretch: 1;
            // Only the selected page's tracks. `item.index` is the track's position
            // in the full queue, so highlight and play map to the real track.
            for item in root.page-items: Rectangle {
                height: 30px;
                background: item.index == root.current-index ? #3060c0 : transparent;
                TouchArea {
                    clicked => {
                        root.play-index(item.index);
                    }
                    Text {
                        text: item.name;
                        x: 8px;
                        width: parent.width - 16px;
                        vertical-alignment: center;
                        overflow: elide;
                        // Active row sits on the blue highlight, so white reads
                        // best; inactive rows sit on the theme background, which
                        // is dark under a dark system theme where black text
                        // vanished, so use light grey instead.
                        color: item.index == root.current-index ? white : #cccccc;
                    }
                }
            }
        }
    }
}
