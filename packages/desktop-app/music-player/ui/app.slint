// The player window: a seek bar on top, a volume slider, and one combined
// control row (left to right: an Open button, a three-state shuffle radio group
// (Off / Within page / All), the transport buttons prev / play-pause / next, and
// a "repeat track" checkbox; the custom radio and checkbox are drawn plain-HTML
// style), then one shared scroll region. That region uses a wrapping flex layout:
// the page-tab bar and selected-page track list sit side by side when the window
// has room, and wrap back into the old vertical order when it does not. Both
// cases keep one Flickable, so page navigation and tracks share one scrollbar and
// no hidden page picker, nested scrolling, or click-triggered layout jump is
// introduced. The queue is paginated on two axes (decided per track in Rust): a
// track in a subfolder gets a page per top-level folder under the loaded root
// (one level only; the tab is that folder); a track at the loaded root gets a
// first-letter page (A-Z, plus a `#` catch-all). The list shows only the selected
// page's tracks, each row showing its path relative to the loaded root (so deeper
// nesting stays visible). The shuffle mode also chooses what playback loops over
// (Off/Within page stay inside the current page; All spans the whole queue); that
// logic lives in Rust. The currently playing (and selected) track is the
// highlighted row, so no separate now-playing title is drawn; a single click
// selects a row (loading it paused), and a click on the already-highlighted row
// toggles play/pause. The window title mirrors the playing track and reverts to
// "Music Player" when paused. All state comes IN from Rust via properties; all
// user actions go OUT to Rust via callbacks. No playback logic (including the
// pagination grouping) lives here.
//
// Numeric time values (position/duration) are kept as `float` seconds for the
// slider, while their human-readable "m:ss" forms arrive as separate string
// properties formatted in Rust (Slint's number formatting is awkward).

import { Button, Slider, HorizontalBox, VerticalBox, Palette } from "std-widgets.slint";

// One row on the selected page: the display path (relative to the loaded root)
// plus its index into the full queue. The index survives filtering, so clicking a
// filtered row still maps back to the right track. Rust fills these from the
// pagination module.
struct PageItem {
    name: string,
    index: int,
}

// A radio button drawn like a plain HTML <input type="radio">: a small ring that
// shows a filled centre dot when selected, with a label to its right. The whole
// row is clickable. The root is a Rectangle wrapping a HorizontalLayout (which
// gives the component its content-derived size) plus a TouchArea overlay that
// captures the click. Used for the three-state shuffle control.
component RadioButton inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked();
    horizontal-stretch: 0;

    HorizontalLayout {
        spacing: 6px;
        alignment: start;
        // the ring, centred vertically against the label
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 16px;
                height: 16px;
                border-radius: self.width / 2;
                border-width: 1px;
                border-color: Palette.border;
                background: Palette.control-background;
                // filled centre dot, shown only when selected; the OS accent
                // colour via the system palette
                Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 8px;
                    height: 8px;
                    border-radius: self.width / 2;
                    background: root.selected ? Palette.accent-background : transparent;
                }
            }
        }
        Text {
            text: root.text;
            vertical-alignment: center;
            color: Palette.foreground;
        }
    }
    TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// A checkbox drawn like a plain HTML <input type="checkbox">: a small square box
// that fills with the system accent colour (Palette.accent-background) and shows
// a tick when checked, with a label to its right. The whole row toggles. Same
// Rectangle + HorizontalLayout + TouchArea structure as RadioButton. Used for
// "Repeat track".
component CheckBox inherits Rectangle {
    in property <string> text;
    in property <bool> checked;
    callback toggled();
    horizontal-stretch: 0;

    HorizontalLayout {
        spacing: 6px;
        alignment: start;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 16px;
                height: 16px;
                border-radius: 3px;
                border-width: 1px;
                border-color: Palette.border;
                background: root.checked ? Palette.accent-background : Palette.control-background;
                // the tick, drawn only when checked (the font has the glyph; the
                // image ships google-noto plus the default sans). accent-foreground
                // is the palette's matched on-accent ink, legible on the accent fill
                // whichever way the system accent and light/dark land.
                Text {
                    width: parent.width;
                    height: parent.height;
                    text: root.checked ? "✓" : "";
                    color: Palette.accent-foreground;
                    font-size: 12px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
        Text {
            text: root.text;
            vertical-alignment: center;
            color: Palette.foreground;
        }
    }
    TouchArea {
        clicked => {
            root.toggled();
        }
    }
}

// A prominent vertical scrollbar that drives a Flickable's viewport. It is drawn
// deliberately wide and high-contrast (a visible track Rectangle plus a rounded
// thumb), unlike the thin near-invisible default std-widgets bar. `maximum` is
// the largest scroll distance (the content height minus the visible height);
// `page-size` is the visible height; `value` two-way binds to the Flickable's
// `viewport-y` (which Slint keeps <= 0, scrolling up as it grows negative). The
// thumb's height is the visible fraction of the content, and dragging it moves
// the viewport proportionally. Mirrors the Slint energy-monitor demo's
// ScrollBar, turned vertical and made bolder.
component VScrollBar inherits Rectangle {
    in property <length> page-size;
    in property <length> maximum;
    in-out property <length> value;

    // a wide gutter so the bar reads as a real scrollbar, not a hairline
    width: 14px;
    // only worth showing once the content actually overflows the viewport
    visible: root.maximum > 0;
    // recessed track surface from the system palette
    background: Palette.alternate-background;
    border-radius: 7px;

    // the draggable thumb: its length is the visible fraction of the content,
    // and its position tracks how far we have scrolled. Palette-derived greys so
    // it stays prominent and high-contrast on any theme: border at rest, brighter
    // toward the foreground colour on hover and while grabbed.
    thumb := Rectangle {
        x: 2px;
        width: parent.width - 4px;
        height: max(32px, (parent.height - 4px) * root.page-size / (root.maximum + root.page-size));
        y: 2px + (parent.height - 4px - self.height) * (-root.value / root.maximum);
        background: ta.pressed ? Palette.foreground : ta.has-hover ? Palette.foreground.with-alpha(0.7) : Palette.border;
        border-radius: self.width / 2;

        ta := TouchArea {
            // remember where the viewport sat when the drag began, so movement
            // is measured relative to the press point (no jump on grab)
            property <length> pressed-value;
            pointer-event(event) => {
                if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                    self.pressed-value = -root.value;
                }
            }
            moved => {
                if (self.pressed) {
                    root.value = -max(0px, min(root.maximum, self.pressed-value
                        + (self.mouse-y - self.pressed-y) * (root.maximum / (root.height - 4px - thumb.height))));
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    // Window title: the playing track's list path (folder/.../file, the same string
    // the queue row shows) while audio is playing, plain "Music Player" when paused
    // or idle. Bound to `playing` + `track-name` (both pushed from Rust), so the
    // taskbar / window-list entry shows the song only during active playback and
    // reverts the moment it pauses.
    title: root.playing && root.track-name != "" ? root.track-name : "Music Player";
    preferred-width: 480px;
    preferred-height: 600px;

    // Pure black under dark mode (OLED-friendly, maximum contrast) instead of the
    // style's near-black Palette.background; light mode keeps the adaptive default.
    background: Palette.color-scheme == ColorScheme.dark ? #000000 : Palette.background;

    // Inputs from Rust (the engine pushes these via Update messages).
    in property <string> track-name: "";
    in property <float> position: 0;
    in property <float> duration: 0;
    in property <string> position-text: "0:00";
    in property <string> duration-text: "0:00";
    in property <bool> playing: false;
    in property <float> volume: 1.0;
    // Shuffle mode as an int the radio group compares against: 0 = off,
    // 1 = within page, 2 = all. Off/within-page confine playback to the current
    // page; all spans the whole queue (the scope logic lives in Rust).
    in property <int> shuffle-mode: 0;
    // Whether "repeat track" is on (replay the current track on its natural end).
    in property <bool> repeat-track: false;
    in property <int> current-index: -1;
    in property <[string]> queue: [];

    // Pagination view, derived in Rust from `queue`. `page-labels` are the tab
    // captions (a top-level folder, an A-Z letter, or `#`; folder pages first,
    // then letters, then `#`); `selected-page` is the index of the visible tab;
    // `page-items` are only the selected page's tracks.
    in property <[string]> page-labels: [];
    in property <int> selected-page: 0;
    in property <[PageItem]> page-items: [];

    // Outputs to Rust (each maps to one engine Command).
    callback toggle-play();
    callback prev();
    callback next();
    callback seek(float);
    callback set-volume(float);
    // The user picked a shuffle radio; the argument is the mode int (0/1/2).
    callback set-shuffle-mode(int);
    // The user toggled the repeat-track checkbox; the argument is the new state.
    callback set-repeat-track(bool);
    // A single click on an UNSELECTED row selects it: Rust makes it current and
    // loads it paused (pausing whatever was playing). A click on the already-current
    // row instead toggles play/pause (see the row handler below). The argument is
    // the track's full-queue index.
    callback select-index(int);
    callback open-files();
    // The user clicked a page tab; the argument is the page index. Rust swaps the
    // visible page (refills `page-items` and updates `selected-page`).
    callback select-page(int);

    VerticalBox {
        padding: 12px;
        spacing: 8px;

        HorizontalBox {
            alignment: stretch;
            Text {
                text: root.position-text;
                vertical-alignment: center;
            }
            Slider {
                horizontal-stretch: 1;
                minimum: 0;
                maximum: root.duration > 0 ? root.duration : 1.0;
                value: root.position;
                changed(value) => {
                    root.seek(value);
                }
            }
            Text {
                text: root.duration-text;
                vertical-alignment: center;
            }
        }

        HorizontalBox {
            Text {
                text: "Volume";
                vertical-alignment: center;
            }
            Slider {
                horizontal-stretch: 1;
                minimum: 0;
                maximum: 1.0;
                value: root.volume;
                changed(value) => {
                    root.set-volume(value);
                }
            }
        }

        // Combined control row, left to right: an Open button, the three-state
        // shuffle radio group (a "Shuffle" label then Off / Within page / All),
        // the transport buttons (prev / play-pause / next), and a "repeat track"
        // checkbox. The radio and checkbox are plain-HTML-styled custom
        // components. A FlexboxLayout (the same experimental builtin the page-tab
        // bar uses, enabled via SLINT_ENABLE_EXPERIMENTAL_FEATURES in the
        // Containerfile) lays the four groups left-to-right and wraps them onto
        // more rows when the window is too narrow. Each group is wrapped in its
        // own HorizontalLayout so a wrap never splits a group. alignment:
        // space-between is taffy's justify-content: space-between, and
        // spacing-horizontal: 48px is taffy's column gap, which acts as the
        // minimum: space-between only ADDS free space on top of the gap, so the
        // groups spread across the row yet never sit closer than 48px (verified
        // against the slint clone's internal/core/layout.rs:1495-1524, where
        // alignment maps to justify_content and spacing-h/v map to the taffy gap
        // independently). spacing-vertical: 8px is the gap between wrapped rows;
        // align-items: center vertically centres each group against the tallest
        // in its row; vertical-stretch: 0 keeps the row at its wrapped height (the
        // queue region below absorbs the vertical slack).
        FlexboxLayout {
            flex-wrap: wrap;
            alignment: space-between;
            align-items: center;
            spacing-horizontal: 48px;
            spacing-vertical: 8px;
            vertical-stretch: 0;
            Button {
                text: "Open";
                // Highlight (accent style) when the queue is empty, so a fresh
                // launch points the user at the only useful action.
                primary: root.queue.length == 0;
                clicked => {
                    root.open-files();
                }
            }
            // shuffle group: the label plus the three mutually-exclusive radios,
            // kept together as one flex item so wrapping never splits them
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: "Shuffle";
                    vertical-alignment: center;
                    color: Palette.foreground;
                }
                RadioButton {
                    text: "Off";
                    selected: root.shuffle-mode == 0;
                    clicked => {
                        root.set-shuffle-mode(0);
                    }
                }
                RadioButton {
                    text: "Within page";
                    selected: root.shuffle-mode == 1;
                    clicked => {
                        root.set-shuffle-mode(1);
                    }
                }
                RadioButton {
                    text: "All";
                    selected: root.shuffle-mode == 2;
                    clicked => {
                        root.set-shuffle-mode(2);
                    }
                }
            }
            // transport group: prev / play-pause / next, one flex item
            HorizontalLayout {
                spacing: 8px;
                Button {
                    text: "Prev";
                    clicked => {
                        root.prev();
                    }
                }
                Button {
                    text: root.playing ? "Pause" : "Play";
                    clicked => {
                        root.toggle-play();
                    }
                }
                Button {
                    text: "Next";
                    clicked => {
                        root.next();
                    }
                }
            }
            CheckBox {
                text: "Repeat track";
                checked: root.repeat-track;
                toggled => {
                    root.set-repeat-track(!root.repeat-track);
                }
            }
        }

        // 32px gap between the control row and the queue area below. The spacer
        // is 16px because the enclosing VerticalBox adds its own 8px spacing on
        // each side of the spacer (8 + 16 + 8 = 32), so the visible gap is 32px
        // while the 8px rhythm between the rows above is left untouched.
        // vertical-stretch: 0 keeps it fixed; the queue Rectangle (stretch 1)
        // absorbs all vertical slack, so the spacer never grows.
        Rectangle {
            height: 16px;
            vertical-stretch: 0;
        }

        // Queue area: the page-tab bar and the track list share one scroll
        // region, so they move under one scrollbar. A breakpoint switches only
        // the content geometry: wide windows show the full page grid beside the
        // selected page's rows, while narrow windows keep the original vertical
        // tab-then-list order. Slint's Flickable pass forwards preferred size from
        // layout children, and FlexboxLayout's wrapped cross-axis size depends on
        // its assigned width; a single wrapping flex root inside Flickable creates
        // a viewport/content binding loop. The breakpoint keeps the wide and
        // narrow geometries explicit enough for Slint's layout-info analysis.
        Rectangle {
            vertical-stretch: 1;
            flick := Flickable {
                x: 0px;
                y: 0px;
                width: max(0px, parent.width - 18px);
                height: parent.height;
                viewport-width: self.width;
                viewport-height: content.preferred-height;
                content := VerticalLayout {
                    // Pack from the top at natural heights, leaving any slack
                    // below the last row rather than stretching the rows.
                    alignment: start;

                    if root.width >= 900px: HorizontalLayout {
                        spacing: 24px;
                        alignment: stretch;
                        vertical-stretch: 0;

                        // Wide page-tab bar: one tab per page (top-level folder
                        // or letter). It stays complete, so late-alphabet pages
                        // remain visible, but it shares the first scroll screen
                        // with the selected page's rows.
                        //
                        // align-content and align-items are pinned to start because
                        // both default to stretch on FlexboxLayout. This bar shares a
                        // HorizontalLayout (alignment: stretch) with the much taller
                        // track list, so the bar is handed more cross-axis (vertical)
                        // height than its wrapped rows need. With the stretch defaults
                        // that surplus inflates every tab: align-content stretches the
                        // wrapped flex lines apart and align-items stretches each
                        // button to its line, so the tags came out far bigger than in
                        // the 1-column layout. start keeps the lines and buttons at
                        // their natural height, packed at the top, with the surplus
                        // left as empty space below, so the tags match the 1-column
                        // size. (The narrow bar never hits this: it is laid out at the
                        // same width it is measured at, so it gets no surplus height.)
                        if root.page-labels.length > 0: FlexboxLayout {
                            min-width: 320px;
                            preferred-width: 480px;
                            horizontal-stretch: 1;
                            spacing: 4px;
                            flex-wrap: wrap;
                            alignment: start;
                            align-content: start;
                            align-items: start;
                            vertical-stretch: 0;
                            for label[p] in root.page-labels: Button {
                                text: label;
                                // The active page's tab is drawn with the accent style.
                                primary: p == root.selected-page;
                                clicked => {
                                    root.select-page(p);
                                }
                            }
                        }

                        // Wide selected-page rows. The larger stretch factor gives
                        // long track names more room than page navigation.
                        VerticalLayout {
                            min-width: 320px;
                            preferred-width: 480px;
                            horizontal-stretch: 2;
                            vertical-stretch: 0;
                            alignment: start;
                            for item in root.page-items: Rectangle {
                                height: 30px;
                                preferred-height: 30px;
                                // Active row painted with the system accent (matching
                                // the active page tab's primary Button); inactive rows
                                // stay transparent over the window background.
                                background: item.index == root.current-index ? Palette.accent-background : transparent;
                                TouchArea {
                                    // Click the already-selected (highlighted) row to
                                    // toggle play/pause; click any other row to merely
                                    // select it (Rust loads it paused). A "double click
                                    // to play" then falls out for free: the first click
                                    // selects, the second (now on the selected row)
                                    // toggles to play, so no real double-click is needed.
                                    clicked => {
                                        if (item.index == root.current-index) {
                                            root.toggle-play();
                                        } else {
                                            root.select-index(item.index);
                                        }
                                    }
                                    Text {
                                        text: item.name;
                                        x: 8px;
                                        width: parent.width - 16px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        // Active row uses the palette's on-accent ink so
                                        // it stays legible on the accent fill (it can be a
                                        // light tint under the dark scheme); inactive rows
                                        // use the palette foreground, which tracks the
                                        // system light/dark theme.
                                        color: item.index == root.current-index ? Palette.accent-foreground : Palette.foreground;
                                    }
                                }
                            }
                        }
                    }

                    // Narrow page-tab bar: the original vertical order, one tab
                    // grid followed by the selected page's rows.
                    if root.width < 900px && root.page-labels.length > 0: FlexboxLayout {
                        spacing: 4px;
                        flex-wrap: wrap;
                        alignment: start;
                        vertical-stretch: 0;
                        for label[p] in root.page-labels: Button {
                            text: label;
                            // The active page's tab is drawn with the accent style.
                            primary: p == root.selected-page;
                            clicked => {
                                root.select-page(p);
                            }
                        }
                    }

                    // 24px gap between the narrow page-tab bar and the track list.
                    // The wide layout uses HorizontalLayout spacing instead.
                    if root.width < 900px && root.page-labels.length > 0: Rectangle {
                        height: 24px;
                    }

                    // Narrow selected-page rows.
                    if root.width < 900px: VerticalLayout {
                        vertical-stretch: 0;
                        alignment: start;
                        for item in root.page-items: Rectangle {
                            height: 30px;
                            preferred-height: 30px;
                            // Active row painted with the system accent (matching
                            // the active page tab's primary Button); inactive rows
                            // stay transparent over the window background.
                            background: item.index == root.current-index ? Palette.accent-background : transparent;
                            TouchArea {
                                // Click the already-selected (highlighted) row to
                                // toggle play/pause; click any other row to merely
                                // select it (Rust loads it paused). A "double click
                                // to play" then falls out for free: the first click
                                // selects, the second (now on the selected row)
                                // toggles to play, so no real double-click is needed.
                                clicked => {
                                    if (item.index == root.current-index) {
                                        root.toggle-play();
                                    } else {
                                        root.select-index(item.index);
                                    }
                                }
                                Text {
                                    text: item.name;
                                    x: 8px;
                                    width: parent.width - 16px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    // Active row uses the palette's on-accent ink so
                                    // it stays legible on the accent fill (it can be a
                                    // light tint under the dark scheme); inactive rows
                                    // use the palette foreground, which tracks the
                                    // system light/dark theme.
                                    color: item.index == root.current-index ? Palette.accent-foreground : Palette.foreground;
                                }
                            }
                        }
                    }
                }
            }

            // Prominent scrollbar for the shared region. page-size is the
            // visible height; maximum is how far the content overflows it;
            // value drives (and follows) the Flickable's vertical offset.
            VScrollBar {
                x: parent.width - self.width;
                y: 0px;
                height: parent.height;
                page-size: flick.height;
                maximum: flick.viewport-height - flick.height;
                value <=> flick.viewport-y;
            }
        }
    }
}
