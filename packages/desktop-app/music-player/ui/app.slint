// The player window: a seek bar on top, a transport row (prev / play-pause /
// next, open), a volume slider, a shuffle/repeat control row (a three-state
// shuffle radio group and a "repeat track" checkbox, both drawn plain-HTML
// style), a page-tab bar, and a click-to-play queue list below. The queue is
// paginated on two axes (decided per track in Rust): a track in a subfolder gets
// a page per top-level folder under the loaded root (one level only; the tab is
// that folder); a track at the loaded root gets a first-letter page (A-Z, plus a
// `#` catch-all). The list shows only the selected page's tracks, each row
// showing its path relative to the loaded root (so deeper nesting stays visible).
// The shuffle mode also chooses what playback loops over (Off/Within page stay
// inside the current page; All spans the whole queue); that logic lives in Rust.
// The currently playing track is the highlighted row, so no separate now-playing
// title is drawn. All state comes IN from Rust via properties; all user actions
// go OUT to Rust via callbacks. No playback logic (including the pagination
// grouping) lives here.
//
// Numeric time values (position/duration) are kept as `float` seconds for the
// slider, while their human-readable "m:ss" forms arrive as separate string
// properties formatted in Rust (Slint's number formatting is awkward).

import { Button, Slider, ListView, HorizontalBox, VerticalBox } from "std-widgets.slint";

// One row on the selected page: the display path (relative to the loaded root)
// plus its index into the full queue. The index survives filtering, so clicking a
// filtered row still maps back to the right track. Rust fills these from the
// pagination module.
struct PageItem {
    name: string,
    index: int,
}

// A radio button drawn like a plain HTML <input type="radio">: a small ring that
// shows a filled centre dot when selected, with a label to its right. The whole
// row is clickable. The root is a Rectangle wrapping a HorizontalLayout (which
// gives the component its content-derived size) plus a TouchArea overlay that
// captures the click. Used for the three-state shuffle control.
component RadioButton inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked();
    horizontal-stretch: 0;

    HorizontalLayout {
        spacing: 6px;
        alignment: start;
        // the ring, centred vertically against the label
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 16px;
                height: 16px;
                border-radius: self.width / 2;
                border-width: 1px;
                border-color: #888888;
                background: white;
                // filled centre dot, shown only when selected
                Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 8px;
                    height: 8px;
                    border-radius: self.width / 2;
                    background: root.selected ? #303030 : transparent;
                }
            }
        }
        Text {
            text: root.text;
            vertical-alignment: center;
            color: #cccccc;
        }
    }
    TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// A checkbox drawn like a plain HTML <input type="checkbox">: a small square box
// that fills with the accent colour and shows a tick when checked, with a label
// to its right. The whole row toggles. Same Rectangle + HorizontalLayout +
// TouchArea structure as RadioButton. Used for "Repeat track".
component CheckBox inherits Rectangle {
    in property <string> text;
    in property <bool> checked;
    callback toggled();
    horizontal-stretch: 0;

    HorizontalLayout {
        spacing: 6px;
        alignment: start;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 16px;
                height: 16px;
                border-radius: 3px;
                border-width: 1px;
                border-color: #888888;
                background: root.checked ? #3060c0 : white;
                // the tick, drawn only when checked (the font has the glyph; the
                // image ships google-noto plus the default sans)
                Text {
                    width: parent.width;
                    height: parent.height;
                    text: root.checked ? "✓" : "";
                    color: white;
                    font-size: 12px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
        Text {
            text: root.text;
            vertical-alignment: center;
            color: #cccccc;
        }
    }
    TouchArea {
        clicked => {
            root.toggled();
        }
    }
}

export component AppWindow inherits Window {
    title: "Music Player";
    preferred-width: 480px;
    preferred-height: 600px;

    // Inputs from Rust (the engine pushes these via Update messages).
    in property <string> track-name: "";
    in property <float> position: 0;
    in property <float> duration: 0;
    in property <string> position-text: "0:00";
    in property <string> duration-text: "0:00";
    in property <bool> playing: false;
    in property <float> volume: 1.0;
    // Shuffle mode as an int the radio group compares against: 0 = off,
    // 1 = within page, 2 = all. Off/within-page confine playback to the current
    // page; all spans the whole queue (the scope logic lives in Rust).
    in property <int> shuffle-mode: 0;
    // Whether "repeat track" is on (replay the current track on its natural end).
    in property <bool> repeat-track: false;
    in property <int> current-index: -1;
    in property <[string]> queue: [];

    // Pagination view, derived in Rust from `queue`. `page-labels` are the tab
    // captions (a top-level folder, an A-Z letter, or `#`; folder pages first,
    // then letters, then `#`); `selected-page` is the index of the visible tab;
    // `page-items` are only the selected page's tracks.
    in property <[string]> page-labels: [];
    in property <int> selected-page: 0;
    in property <[PageItem]> page-items: [];

    // Outputs to Rust (each maps to one engine Command).
    callback toggle-play();
    callback prev();
    callback next();
    callback seek(float);
    callback set-volume(float);
    // The user picked a shuffle radio; the argument is the mode int (0/1/2).
    callback set-shuffle-mode(int);
    // The user toggled the repeat-track checkbox; the argument is the new state.
    callback set-repeat-track(bool);
    callback play-index(int);
    callback open-files();
    // The user clicked a page tab; the argument is the page index. Rust swaps the
    // visible page (refills `page-items` and updates `selected-page`).
    callback select-page(int);

    VerticalBox {
        padding: 12px;
        spacing: 8px;

        HorizontalBox {
            alignment: stretch;
            Text {
                text: root.position-text;
                vertical-alignment: center;
            }
            Slider {
                horizontal-stretch: 1;
                minimum: 0;
                maximum: root.duration > 0 ? root.duration : 1.0;
                value: root.position;
                changed(value) => {
                    root.seek(value);
                }
            }
            Text {
                text: root.duration-text;
                vertical-alignment: center;
            }
        }

        HorizontalBox {
            alignment: center;
            Button {
                text: "Prev";
                clicked => {
                    root.prev();
                }
            }
            Button {
                text: root.playing ? "Pause" : "Play";
                clicked => {
                    root.toggle-play();
                }
            }
            Button {
                text: "Next";
                clicked => {
                    root.next();
                }
            }
            Button {
                text: "Open";
                // Highlight (accent style) when the queue is empty, so a fresh
                // launch points the user at the only useful action.
                primary: root.queue.length == 0;
                clicked => {
                    root.open-files();
                }
            }
        }

        HorizontalBox {
            Text {
                text: "Volume";
                vertical-alignment: center;
            }
            Slider {
                horizontal-stretch: 1;
                minimum: 0;
                maximum: 1.0;
                value: root.volume;
                changed(value) => {
                    root.set-volume(value);
                }
            }
        }

        // Shuffle/repeat control row: a three-state shuffle radio group on the
        // left (Off / Within page / All) and a "repeat track" checkbox pushed to
        // the right. Both are plain-HTML-styled custom components. Selecting a
        // shuffle radio sends that mode; toggling the checkbox sends its inverse.
        // Default `stretch` alignment is kept (no `alignment:` override) so the
        // spacer Rectangle's `horizontal-stretch: 1` actually absorbs the slack;
        // setting any other alignment makes Slint ignore stretch factors.
        HorizontalBox {
            spacing: 12px;
            Text {
                text: "Shuffle";
                vertical-alignment: center;
                color: #cccccc;
            }
            RadioButton {
                text: "Off";
                selected: root.shuffle-mode == 0;
                clicked => {
                    root.set-shuffle-mode(0);
                }
            }
            RadioButton {
                text: "Within page";
                selected: root.shuffle-mode == 1;
                clicked => {
                    root.set-shuffle-mode(1);
                }
            }
            RadioButton {
                text: "All";
                selected: root.shuffle-mode == 2;
                clicked => {
                    root.set-shuffle-mode(2);
                }
            }
            // spacer: pushes the checkbox to the right edge
            Rectangle {
                horizontal-stretch: 1;
            }
            CheckBox {
                text: "Repeat track";
                checked: root.repeat-track;
                toggled => {
                    root.set-repeat-track(!root.repeat-track);
                }
            }
        }

        // Page-tab bar: one tab per page (top-level folder or letter), shown only
        // when the queue has at least one page. A FlexboxLayout lays the tabs out
        // left-to-right and wraps them onto multiple rows when they exceed the
        // window width (flex-wrap defaults to wrap), reflowing as the window
        // resizes instead of scrolling horizontally. Each tab keeps its natural
        // (variable) width. FlexboxLayout is a Slint experimental builtin, enabled
        // via SLINT_ENABLE_EXPERIMENTAL_FEATURES in the Containerfile. alignment:
        // start packs tabs from the left; vertical-stretch: 0 keeps the bar at its
        // wrapped height so the queue list below gets the remaining space.
        if root.page-labels.length > 0: FlexboxLayout {
            spacing: 4px;
            flex-wrap: wrap;
            alignment: start;
            vertical-stretch: 0;
            for label[p] in root.page-labels: Button {
                text: label;
                // The active page's tab is drawn with the accent style.
                primary: p == root.selected-page;
                clicked => {
                    root.select-page(p);
                }
            }
        }

        ListView {
            vertical-stretch: 1;
            // Only the selected page's tracks. `item.index` is the track's position
            // in the full queue, so highlight and play map to the real track.
            for item in root.page-items: Rectangle {
                height: 30px;
                background: item.index == root.current-index ? #3060c0 : transparent;
                TouchArea {
                    clicked => {
                        root.play-index(item.index);
                    }
                    Text {
                        text: item.name;
                        x: 8px;
                        width: parent.width - 16px;
                        vertical-alignment: center;
                        overflow: elide;
                        // Active row sits on the blue highlight, so white reads
                        // best; inactive rows sit on the theme background, which
                        // is dark under a dark system theme where black text
                        // vanished, so use light grey instead.
                        color: item.index == root.current-index ? white : #cccccc;
                    }
                }
            }
        }
    }
}
