# Build + run environment for the `music-player` app.
# The host is an immutable-style Fedora without dev headers, so all cargo
# work happens inside this container (see mise.toml tasks). The image also
# carries the GUI/audio runtime libraries so the `run` task can drive the
# Slint UI against the host's Wayland + PipeWire sockets (passed through).
FROM registry.fedoraproject.org/fedora:41

# Build toolchain:
#   rust, cargo            Rust compiler + package manager
#   clippy                 cargo-clippy linter (the lint:clippy task)
#   gcc                    cc for building C dependencies (audiopus_sys)
#   clang, clang-devel     libclang for bindgen used by pipewire's libspa-sys
#   pkgconf-pkg-config     pkg-config used to locate libpipewire / libopus
#   *-devel                headers for the native audio dependencies
# Runtime (for `run`):
#   mesa-*                 OpenGL/EGL for the femtovg renderer + DRI drivers
#   libxkbcommon, wayland  winit Wayland backend
#   fontconfig, freetype   Slint font loading
#   google-noto-sans-cjk-fonts  CJK glyph coverage. Slint 1.16's femtovg
#                          renderer lays text out with parley + fontique
#                          (system_fonts enabled), which falls back per script
#                          to a system font. Without a CJK font installed,
#                          Japanese/Chinese/Korean filenames render as blanks.
#   xdg-desktop-portal     rfd file picker over the portal (when D-Bus passed)
RUN dnf install -y \
      rust cargo clippy gcc \
      clang clang-devel \
      pkgconf-pkg-config \
      pipewire-devel \
      opus-devel \
      mesa-dri-drivers mesa-libgbm libglvnd-glx libglvnd-egl \
      libwayland-client libwayland-cursor libwayland-egl libxkbcommon \
      fontconfig fontconfig-devel freetype freetype-devel \
      google-noto-sans-cjk-fonts \
    && dnf clean all

ENV CARGO_HOME=/cargo
# Enable Slint's experimental builtins so `FlexboxLayout` (used for the wrapping,
# variable-width page-tab bar) is recognised. slint-build reads this env var at
# compile time (build.rs); without it the Slint compiler rejects `FlexboxLayout`
# with "Unknown element". It is baked here so every cargo task (build, check,
# clippy, test, run) compiles the UI consistently. The feature is experimental
# upstream and its API may change across Slint versions.
ENV SLINT_ENABLE_EXPERIMENTAL_FEATURES=1
WORKDIR /work
