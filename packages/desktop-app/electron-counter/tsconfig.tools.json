{
  "extends": "@monochromatic-dev/config-typescript/dom",
  "include": [
    "${configDir}/src/build-stage.ts",
    "${configDir}/src/distribute.ts",
    "${configDir}/src/wayland-boundary-test.ts"
  ],
  "compilerOptions": {
    "allowImportingTsExtensions": false,
    "composite": false,
    "declaration": false,
    "emitDeclarationOnly": false,
    "erasableSyntaxOnly": true,
    "isolatedDeclarations": false,
    "listEmittedFiles": false,
    "module": "node20",
    "moduleResolution": "node16",
    "noEmit": false,
    "noEmitOnError": true,
    "outDir": "${configDir}/dist/tools",
    "rootDir": "${configDir}/src",
    "sourceMap": true,
    "types": [
      "node",
      "electron"
    ],
    "verbatimModuleSyntax": true
  }
}
