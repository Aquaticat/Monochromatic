FROM docker.io/library/node@sha256:a5f4366e834695d5f363b920c104953a535d3a9864d1bdf74566a0ebe01daee5 AS node-runtime
FROM docker.io/library/rust@sha256:2775a09d208ff0d7c1f50490c45b62db929e87ba1dcbc3f2132ac71a704bcdd3 AS cache-base
COPY --from=node-runtime /usr/local/bin/node /usr/local/bin/node
WORKDIR /src
COPY crate/ /src/crate/
ARG BUILD_HARNESS_SHA
ARG CACHE_PHASE
ARG RUN_NONCE
ARG REGISTRY_CACHE_ID
ARG TARGET_CACHE_ID
ARG RUSTFLAGS
ENV BUILD_HARNESS_SHA=${BUILD_HARNESS_SHA} CACHE_PHASE=${CACHE_PHASE} RUN_NONCE=${RUN_NONCE} REGISTRY_CACHE_ID=${REGISTRY_CACHE_ID} TARGET_CACHE_ID=${TARGET_CACHE_ID} RUSTFLAGS=${RUSTFLAGS} CARGO_INCREMENTAL=0 CARGO_TARGET_DIR=/targetcache
FROM cache-base AS offline
RUN --network=none --mount=type=cache,id=${REGISTRY_CACHE_ID},target=/usr/local/cargo/registry,sharing=locked --mount=type=cache,id=${TARGET_CACHE_ID},target=/targetcache,sharing=locked ["node","--input-type=module-typescript","-e","import {readFileSync,writeFileSync,mkdirSync,existsSync,readdirSync} from 'node:fs';\nimport {spawnSync,execFileSync} from 'node:child_process';import {availableParallelism,totalmem} from 'node:os';\nimport {createHash} from 'node:crypto';import {strict as assert} from 'node:assert';\nconst hash=value=>createHash('sha256').update(value).digest('hex');\nconst phase=process.env.CACHE_PHASE;const nonce=process.env.RUN_NONCE;assert(phase&&nonce);\nassert.equal(process.arch,'x64');assert.equal(process.version,'v24.22.0');\nconst cpus=availableParallelism();const memory=totalmem();assert(cpus<=16&&memory<=32*1024**3);\nconst rustc=execFileSync('rustc',['--version','--verbose'],{encoding:'utf8'});\nconst cargo=execFileSync('cargo',['--version'],{encoding:'utf8'});assert(rustc.startsWith('rustc 1.97.1 '));\nconst paths={registry:'/usr/local/cargo/registry',target:'/targetcache'};\nconst markers=Object.fromEntries(Object.entries(paths).map(([name,path])=>[name,path+'/.mono-cache-probe-marker']));\nconst before=Object.fromEntries(Object.entries(markers).map(([name,path])=>[name,existsSync(path)?readFileSync(path,'utf8'):null]));\nconst lockPath='/src/crate/Cargo.lock';const lockBefore=hash(readFileSync(lockPath));\nconst args=['build','--manifest-path','/src/crate/Cargo.toml','--release','--no-default-features','--locked','--jobs','2',\n '--message-format=json'];if(phase!=='seed')args.push('--offline');\nconst startedAt=new Date().toISOString();const started=Date.now();\nconst command=spawnSync('cargo',args,{encoding:'utf8',maxBuffer:8*1024*1024,timeout:105000});\nif(command.error)throw command.error;\nconst lines=command.stdout.trim()?command.stdout.trim().split('\\n'):[];\nconst messages=lines.map(line=>JSON.parse(line));const artifacts=messages