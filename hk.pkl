amends "package://github.com/jdx/hk/releases/download/v1.44.3/hk@1.44.3#/Config.pkl"

local binPath = "packages/cli/forbidden-strings/target/release/forbidden-strings"

// The binary resolves rules in order: --rules flag, FORBIDDEN_STRINGS_RULES
// env var, then ./forbidden-strings.local.txt in cwd. hk inherits the env,
// so setting FORBIDDEN_STRINGS_RULES upstream (e.g. in CI) Just Works.
local forbiddenStrings = new Step {
  check = "\(binPath) {{files}}"
}

// Push the new commit to origin after every commit. --set-upstream origin HEAD
// makes it work on branches/worktrees that have no upstream yet (creates the
// remote branch and sets tracking); on branches already tracking origin it is a
// harmless re-set. Never force-pushes, so an amend of an already-pushed commit
// is safely rejected rather than overwriting the remote.
local autoPush = new Step {
  check = "git push --set-upstream origin HEAD"
}

hooks {
  ["pre-commit"] {
    steps {
      ["forbidden-strings"] = forbiddenStrings
    }
  }
  ["pre-push"] {
    steps {
      ["forbidden-strings"] = forbiddenStrings
    }
  }
  ["post-commit"] {
    steps {
      ["auto-push"] = autoPush
    }
  }
  ["check"] {
    steps {
      ["forbidden-strings"] = forbiddenStrings
    }
  }
}
