amends "package://github.com/jdx/hk/releases/download/v1.44.3/hk@1.44.3#/Config.pkl"

local rulesPath = read?("env:FORBIDDEN_STRINGS_RULES") ?? "forbidden-strings.local.txt"
local binPath = "packages/dev-script/forbidden-strings/target/release/forbidden-strings"

local forbiddenStrings = new Step {
  check = "\(binPath) --rules \(rulesPath) {{files}}"
}

hooks {
  ["pre-commit"] {
    steps {
      ["forbidden-strings"] = forbiddenStrings
    }
  }
  ["pre-push"] {
    steps {
      ["forbidden-strings"] = forbiddenStrings
    }
  }
  ["check"] {
    steps {
      ["forbidden-strings"] = forbiddenStrings
    }
  }
}
