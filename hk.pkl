amends "package://github.com/jdx/hk/releases/download/v1.50.0/hk@1.50.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.50.0/hk@1.50.0#/Builtins.pkl"

// Normalizes ordinary text while preserving exact-byte inputs and intentionally
// newline-free tsdown outputs. Batching keeps full-tree runs below argument limits.
local finalNewline = (Builtins.newlines) {
  batch = true
  exclude = List(
    "**/dist/final/node/**",
    "packages/fuzz/forbidden-strings/corpus/**",
    "packages/test-fixture/toml-edit/src/**",
  )
}

local binPath = "packages/cli/forbidden-strings/target/release/forbidden-strings"

// The binary resolves rules in order: --rules flag, FORBIDDEN_STRINGS_RULES
// env var, then ./forbidden-strings.local.txt in cwd. hk inherits the env,
// so setting FORBIDDEN_STRINGS_RULES upstream (e.g. in CI) Just Works.
// Temporarily disabled in hooks for refactoring. Re-enable by restoring the
// commented ["forbidden-strings"] step entries below.
local forbiddenStrings = new Step {
  check = "\(binPath) {{files}}"
  hide = true
  output_summary = "hide"
}

local forbiddenRootContext = new Step {
  check = "node -e \"const forbidden = process.argv.slice(1).filter((path) => path === 'CONTEXT.md' || path === './CONTEXT.md'); if (forbidden.length > 0) throw new Error('Root CONTEXT.md is forbidden; read source code directly and see docs/agents/domain.md.');\" {{files}}"
  hide = true
  output_summary = "hide"
}

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps {
      ["final-newline"] = finalNewline
      ["forbidden-root-context"] = forbiddenRootContext
      // Temporarily disabled for refactoring.
      // ["forbidden-strings"] = forbiddenStrings
    }
  }
  ["pre-push"] {
    steps {
      ["final-newline"] = finalNewline
      ["forbidden-root-context"] = forbiddenRootContext
      // Temporarily disabled for refactoring.
      // ["forbidden-strings"] = forbiddenStrings
    }
  }
  ["check"] {
    steps {
      ["final-newline"] = finalNewline
      ["forbidden-root-context"] = forbiddenRootContext
      // Temporarily disabled for refactoring.
      // ["forbidden-strings"] = forbiddenStrings
    }
  }
  ["fix"] {
    fix = true
    steps {
      ["final-newline"] = finalNewline
    }
  }
}
