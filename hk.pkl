amends "package://github.com/jdx/hk/releases/download/v1.44.3/hk@1.44.3#/Config.pkl"

local binPath = "packages/cli/forbidden-strings/target/release/forbidden-strings"

// The binary resolves rules in order: --rules flag, FORBIDDEN_STRINGS_RULES
// env var, then ./forbidden-strings.local.txt in cwd. hk inherits the env,
// so setting FORBIDDEN_STRINGS_RULES upstream (e.g. in CI) Just Works.
local forbiddenStrings = new Step {
  check = "\(binPath) {{files}}"
}

hooks {
  ["pre-commit"] {
    steps {
      ["forbidden-strings"] = forbiddenStrings
    }
  }
  ["pre-push"] {
    steps {
      ["forbidden-strings"] = forbiddenStrings
    }
  }
  ["check"] {
    steps {
      ["forbidden-strings"] = forbiddenStrings
    }
  }
}
