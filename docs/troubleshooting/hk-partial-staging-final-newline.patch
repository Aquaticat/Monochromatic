diff --git a/test/fix_preserves_unstaged_newline.bats b/test/fix_preserves_unstaged_newline.bats
index e3f7717..63e7f4d 100644
--- a/test/fix_preserves_unstaged_newline.bats
+++ b/test/fix_preserves_unstaged_newline.bats
@@ -252 +252,43 @@ PKL
 }
+
+@test "fix avoids duplicate separator when fixer adds missing final newline" {
+    cat <<PKL > hk.pkl
+amends "$PKL_PATH/Config.pkl"
+hooks {
+  ["fix"] {
+    fix = true
+    stash = "git"
+    steps = new Mapping<String, Step> {
+      ["formatter"] {
+        glob = "missing-newline.txt"
+        stage = "missing-newline.txt"
+        fix = "printf 'staged\\n' > missing-newline.txt"
+      }
+    }
+  }
+}
+PKL
+    git add hk.pkl
+    git -c commit.gpgsign=false commit -m "init hk"
+    hk install
+
+    printf 'base\n' > missing-newline.txt
+    git add missing-newline.txt
+    git -c commit.gpgsign=false commit -m "base"
+
+    printf 'staged' > missing-newline.txt
+    git add missing-newline.txt
+    printf 'staged\nunstaged\n' > missing-newline.txt
+
+    run hk fix -v
+    assert_success
+
+    run python3 - <<'PY'
+import pathlib
+import subprocess
+
+assert subprocess.check_output(["git", "show", ":missing-newline.txt"]) == b"staged\n"
+assert pathlib.Path("missing-newline.txt").read_bytes() == b"staged\nunstaged\n"
+PY
+    assert_success
+}
