@@ -2004,11 +2007,12 @@ impl RegexBuilder {
             return self.strip_lb(node_id.right(self));
         }
         let result = self.strip_lb_inner(true, node_id)?;
-        debug_assert!(
-            !self.contains_lookbehind(result),
