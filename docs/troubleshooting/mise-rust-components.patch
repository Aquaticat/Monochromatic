+    fn needs_reconcile(&self, _config: &Arc<Config>, tv: &ToolVersion) -> bool {
+        let (_, components, targets) = get_args(tv);
+        if components.is_none() && targets.is_none() {
+            return false;
+        }
+        // Only an already-present toolchain can be missing a declared piece; a
+        // toolchain mise has not installed yet goes through install_version_,
+        // which already passes --component/--target to rustup.
+        if !tv.install_path().exists() {
+            return false;
+        }
+        let installed_components =
+            rustup_installed(&["component", "list", "--installed"], &tv.version);
+        let installed_targets = rustup_installed(&["target", "list", "--installed"], &tv.version);
+        let host_suffix = format!("-{TARGET}");
+        let any_missing = |declared: Option<Vec<String>>, have: &[String]| -> bool {
+            declared.unwrap_or_default().into_iter().any(|d| {
+                !have.iter().any(|h| {
+                    // rustup lists components as either a bare name (`rust-src`)
+                    // or a name suffixed with the host triple
+                    // (`llvm-tools-x86_64-unknown-linux-gnu`); match both.
+                    h == &d || h.strip_suffix(host_suffix.as_str()).is_some_and(|s| s == d)
+                })
+            })
+        };
+        any_missing(components, &installed_components) || any_missing(targets, &installed_targets)
+    }
