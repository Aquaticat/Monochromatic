+fn rustup_installed(subcommand: &[&str], version: &str) -> Vec<String> {
+    let args: Vec<String> = subcommand
+        .iter()
+        .map(|s| (*s).to_string())
+        .chain(["--toolchain".to_string(), version.to_string()])
+        .collect();
+    let result = crate::cmd::cmd(RUSTUP_BIN, args)
+        .env("RUSTUP_HOME", rustup_home())
+        .env("CARGO_HOME", cargo_home())
+        .stdout_capture()
+        .stderr_capture()
+        .unchecked()
+        .run();
+    match result {
+        Ok(out) if out.status.success() => String::from_utf8_lossy(&out.stdout)
+            .lines()
+            .map(|l| l.trim().to_string())
+            .filter(|l| !l.is_empty())
+            .collect(),
+        _ => vec![],
+    }
+}
