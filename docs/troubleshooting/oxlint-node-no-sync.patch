+fn get_node_sync_function_identifier_name(
+    ident: &IdentifierReference<'_>,
+    ctx: &LintContext<'_>,
+    visited: &mut FxHashSet<SymbolId>,
+) -> Option<CompactStr> {
+    let reference = ctx.scoping().get_reference(ident.reference_id());
+    let symbol_id = reference.symbol_id()?;
+    if !visited.insert(symbol_id) {
+        return None;
+    }
+    get_node_sync_function_definition_name(symbol_id, ctx, visited)
+}
+
+fn is_node_builtin_module_expression(
+    expr: &Expression<'_>,
+    ctx: &LintContext<'_>,
+    visited: &mut FxHashSet<SymbolId>,
+) -> bool {
+    match expr.get_inner_expression() {
+        Expression::CallExpression(call_expr) => is_node_builtin_module_call(call_expr, ctx),
+        Expression::Identifier(ident) => {
+            let reference = ctx.scoping().get_reference(ident.reference_id());
+            let Some(symbol_id) = reference.symbol_id() else {
+                return false;
+            };
+            if !visited.insert(symbol_id) {
+                return false;
+            }
+            is_node_builtin_module_definition(symbol_id, ctx, visited)
+        }
+        Expression::AwaitExpression(await_expression) => {
+            is_node_builtin_module_expression(&await_expression.argument, ctx, visited)
+        }
+        Expression::ImportExpression(import_expression) => {
+            is_node_builtin_import_expression(import_expression)
+        }
+        _ => false,
+    }
+}
+
+fn get_node_sync_function_definition_name(
+    symbol_id: SymbolId,
+    ctx: &LintContext<'_>,
+    visited: &mut FxHashSet<SymbolId>,
+) -> Option<CompactStr> {
+    let declaration_id = ctx.scoping().symbol_declaration(symbol_id);
+    match ctx.nodes().kind(declaration_id) {
+        AstKind::ImportSpecifier(import_specifier) => {
+            if import_specifier.import_kind != ImportOrExportKind::Value {
+                return None;
+            }
+            if !import_declaration_source(declaration_id, ctx).is_some_and(is_node_builtin_module) {
+                return None;
+            }
+            let imported_name = import_specifier.imported.name();
+            imported_name.ends_with("Sync").then(|| CompactStr::from(imported_name))
+        }
+        AstKind::VariableDeclarator(variable_declarator) => {
+            get_node_sync_function_declarator_name(variable_declarator, symbol_id, ctx, visited)
+        }
+        _ => None,
+    }
+}
+
+fn is_node_builtin_module_definition(
+    symbol_id: SymbolId,
+    ctx: &LintContext<'_>,
+    visited: &mut FxHashSet<SymbolId>,
+) -> bool {
+    let declaration_id = ctx.scoping().symbol_declaration(symbol_id);
+    match ctx.nodes().kind(declaration_id) {
+        AstKind::ImportDefaultSpecifier(_) | AstKind::ImportNamespaceSpecifier(_) => {
+            import_declaration_source(declaration_id, ctx).is_some_and(is_node_builtin_module)
+        }
+        AstKind::VariableDeclarator(variable_declarator) => {
+            is_node_builtin_module_declarator(variable_declarator, symbol_id, ctx, visited)
+        }
+        _ => false,
+    }
+}
+
+fn get_node_sync_function_declarator_name(
+    variable_declarator: &VariableDeclarator<'_>,
+    symbol_id: SymbolId,
+    ctx: &LintContext<'_>,
+    visited: &mut FxHashSet<SymbolId>,
+) -> Option<CompactStr> {
+    let Some(init) = &variable_declarator.init else {
+        return None;
+    };
+    match &variable_declarator.id {
+        BindingPattern::BindingIdentifier(binding_identifier)
+            if binding_identifier.symbol_id() == symbol_id =>
+        {
+            get_node_sync_member_expression_name(init, ctx, visited)
+        }
+        BindingPattern::ObjectPattern(object_pattern) => {
+            for property in &object_pattern.properties {
+                if property.computed {
+                    continue;
+                }
+                let BindingPattern::BindingIdentifier(binding_identifier) = &property.value else {
+                    continue;
+                };
+                if binding_identifier.symbol_id() != symbol_id {
+                    continue;
+                }
+                let property_name = property.key.static_name()?;
+                if !property_name.as_ref().ends_with("Sync") {
+                    return None;
+                }
+                return is_node_builtin_module_expression(init, ctx, visited)
+                    .then(|| CompactStr::from(property_name.as_ref()));
+            }
+            None
+        }
+        _ => None,
+    }
+}
+
+fn is_node_builtin_module_declarator(
+    variable_declarator: &VariableDeclarator<'_>,
+    symbol_id: SymbolId,
+    ctx: &LintContext<'_>,
+    visited: &mut FxHashSet<SymbolId>,
+) -> bool {
+    let BindingPattern::BindingIdentifier(binding_identifier) = &variable_declarator.id else {
+        return false;
+    };
+    if binding_identifier.symbol_id() != symbol_id {
+        return false;
+    }
+    let Some(init) = &variable_declarator.init else {
+        return false;
+    };
+    is_node_builtin_module_expression(init, ctx, visited)
+}
