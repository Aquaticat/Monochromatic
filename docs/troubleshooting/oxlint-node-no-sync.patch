+fn is_node_builtin_function_identifier(
+    ident: &IdentifierReference<'_>,
+    property_name: &str,
+    ctx: &LintContext<'_>,
+    visited: &mut FxHashSet<SymbolId>,
+) -> bool {
+    let reference = ctx.scoping().get_reference(ident.reference_id());
+    let Some(symbol_id) = reference.symbol_id() else {
+        return false;
+    };
+    if !visited.insert(symbol_id) {
+        return false;
+    }
+    is_node_builtin_function_definition(symbol_id, property_name, ctx, visited)
+}
+
+fn is_node_builtin_module_expression(
+    expr: &Expression<'_>,
+    ctx: &LintContext<'_>,
+    visited: &mut FxHashSet<SymbolId>,
+) -> bool {
+    match expr.get_inner_expression() {
+        Expression::CallExpression(call_expr) => is_node_builtin_module_call(call_expr),
+        Expression::Identifier(ident) => {
+            let reference = ctx.scoping().get_reference(ident.reference_id());
+            let Some(symbol_id) = reference.symbol_id() else {
+                return false;
+            };
+            if !visited.insert(symbol_id) {
+                return false;
+            }
+            is_node_builtin_module_definition(symbol_id, ctx, visited)
+        }
+        _ => false,
+    }
+}
+
+fn is_node_builtin_function_definition(
+    symbol_id: SymbolId,
+    property_name: &str,
+    ctx: &LintContext<'_>,
+    visited: &mut FxHashSet<SymbolId>,
+) -> bool {
+    let declaration_id = ctx.scoping().symbol_declaration(symbol_id);
+    match ctx.nodes().kind(declaration_id) {
+        AstKind::ImportSpecifier(import_specifier) => {
+            import_declaration_source(declaration_id, ctx).is_some_and(is_node_builtin_module)
+                && import_specifier.imported.name() == property_name
+        }
+        AstKind::VariableDeclarator(variable_declarator) => is_node_builtin_function_declarator(
+            variable_declarator,
+            symbol_id,
+            property_name,
+            ctx,
+            visited,
+        ),
+        _ => false,
+    }
+}
+
+fn is_node_builtin_module_definition(
+    symbol_id: SymbolId,
+    ctx: &LintContext<'_>,
+    visited: &mut FxHashSet<SymbolId>,
+) -> bool {
+    let declaration_id = ctx.scoping().symbol_declaration(symbol_id);
+    match ctx.nodes().kind(declaration_id) {
+        AstKind::ImportDefaultSpecifier(_) | AstKind::ImportNamespaceSpecifier(_) => {
+            import_declaration_source(declaration_id, ctx).is_some_and(is_node_builtin_module)
+        }
+        AstKind::VariableDeclarator(variable_declarator) => is_node_builtin_module_declarator(
+            variable_declarator,
+            symbol_id,
+            ctx,
+            visited,
+        ),
+        _ => false,
+    }
+}
+
+fn is_node_builtin_function_declarator(
+    variable_declarator: &VariableDeclarator<'_>,
+    symbol_id: SymbolId,
+    property_name: &str,
+    ctx: &LintContext<'_>,
+    visited: &mut FxHashSet<SymbolId>,
+) -> bool {
+    if !variable_declarator.kind.is_const() {
+        return false;
+    }
+    let Some(init) = &variable_declarator.init else {
+        return false;
+    };
+    match &variable_declarator.id {
+        BindingPattern::BindingIdentifier(binding_identifier)
+            if binding_identifier.symbol_id() == symbol_id =>
+        {
+            is_node_builtin_member_expression(init, property_name, ctx, visited)
+        }
+        BindingPattern::ObjectPattern(object_pattern) => {
+            for property in &object_pattern.properties {
+                if property.computed {
+                    continue;
+                }
+                let BindingPattern::BindingIdentifier(binding_identifier) = &property.value else {
+                    continue;
+                };
+                if binding_identifier.symbol_id() != symbol_id {
+                    continue;
+                }
+                let Some(static_name) = property.key.static_name() else {
+                    return false;
+                };
+                if static_name != property_name {
+                    return false;
+                }
+                return is_node_builtin_module_expression(init, ctx, visited);
+            }
+            false
+        }
+        _ => false,
+    }
+}
+
+fn is_node_builtin_module_declarator(
+    variable_declarator: &VariableDeclarator<'_>,
+    symbol_id: SymbolId,
+    ctx: &LintContext<'_>,
+    visited: &mut FxHashSet<SymbolId>,
+) -> bool {
+    if !variable_declarator.kind.is_const() {
+        return false;
+    }
+    let BindingPattern::BindingIdentifier(binding_identifier) = &variable_declarator.id else {
+        return false;
+    };
+    if binding_identifier.symbol_id() != symbol_id {
+        return false;
+    }
+    let Some(init) = &variable_declarator.init else {
+        return false;
+    };
+    is_node_builtin_module_expression(init, ctx, visited)
+}
+
+fn is_node_builtin_member_expression(
+    expr: &Expression<'_>,
+    property_name: &str,
+    ctx: &LintContext<'_>,
+    visited: &mut FxHashSet<SymbolId>,
+) -> bool {
+    match expr.get_inner_expression() {
+        Expression::StaticMemberExpression(member) => {
+            member.property.name == property_name
+                && is_node_builtin_module_expression(&member.object, ctx, visited)
+        }
+        Expression::ComputedMemberExpression(member) => {
+            member.static_property_name().is_some_and(|name| name == property_name)
+                && is_node_builtin_module_expression(&member.object, ctx, visited)
+        }
+        _ => false,
+    }
+}
+
+fn is_node_builtin_module_call(call_expr: &CallExpression<'_>) -> bool {
+    if call_expr.optional || call_expr.arguments.len() != 1 || call_expr.arguments[0].is_spread() {
+        return false;
+    }
+    if call_expr.common_js_require().is_some_and(|source| is_node_builtin_module(source.value.as_str())) {
+        return true;
+    }
+    is_process_get_builtin_module_call(call_expr)
+}
+
+fn is_process_get_builtin_module_call(call_expr: &CallExpression<'_>) -> bool {
+    let Expression::StaticMemberExpression(callee) = &call_expr.callee else {
+        return false;
+    };
+    let Expression::Identifier(process_ident) = &callee.object else {
+        return false;
+    };
+    if process_ident.name != "process" || callee.property.name != "getBuiltinModule" {
+        return false;
+    }
+    matches!(
+        &call_expr.arguments[0],
+        oxc_ast::ast::Argument::StringLiteral(source) if is_node_builtin_module(source.value.as_str())
+    )
+}
+
+fn import_declaration_source<'a>(
+    declaration_id: NodeId,
+    ctx: &'a LintContext<'_>,
+) -> Option<&'a str> {
+    let AstKind::ImportDeclaration(import_declaration) = ctx.nodes().parent_kind(declaration_id)
+    else {
+        return None;
+    };
+    Some(import_declaration.source.value.as_str())
+}
+
+fn is_node_builtin_module(source: &str) -> bool {
+    let source = source.strip_prefix("node:").unwrap_or(source);
+    let module_name = if let Some((prefix, postfix)) = source.split_once('/') {
+        if postfix.is_empty() { source } else { prefix }
+    } else {
+        source
+    };
+    is_nodejs_builtin_module(module_name)
+}
