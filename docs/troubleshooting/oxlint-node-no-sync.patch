+                .then(|| CompactStr::from(property_name))
+        }
+        Expression::ComputedMemberExpression(member) => {
+            let property_name = member.static_property_name()?;
+            if !property_name.as_ref().ends_with("Sync") {
+                return None;
+            }
+            is_node_builtin_module_expression(&member.object, ctx, visited)
+                .then(|| CompactStr::from(property_name.as_ref()))
         }
         _ => None,
     }
 }
 
+fn is_node_builtin_module_call(call_expr: &CallExpression<'_>, ctx: &LintContext<'_>) -> bool {
+    if call_expr.optional || call_expr.arguments.len() != 1 || call_expr.arguments[0].is_spread() {
+        return false;
+    }
+    if is_global_require_call(call_expr, ctx) {
+        return call_expr
+            .common_js_require()
+            .is_some_and(|source| is_node_builtin_module(source.value.as_str()));
+    }
+    is_process_get_builtin_module_call(call_expr, ctx)
+}
+
+fn is_global_require_call(call_expr: &CallExpression<'_>, ctx: &LintContext<'_>) -> bool {
+    let Expression::Identifier(require_ident) = &call_expr.callee else {
+        return false;
+    };
+    require_ident.is_global_reference_name(static_ident!("require"), ctx.scoping())
+}
+
+fn is_process_get_builtin_module_call(
+    call_expr: &CallExpression<'_>,
+    ctx: &LintContext<'_>,
+) -> bool {
+    let Expression::StaticMemberExpression(callee) = &call_expr.callee else {
+        return false;
+    };
+    if callee.optional || callee.property.name != "getBuiltinModule" {
+        return false;
+    }
+    let Expression::Identifier(process_ident) = &callee.object else {
+        return false;
+    };
+    if !process_ident.is_global_reference_name(static_ident!("process"), ctx.scoping()) {
+        return false;
+    }
+    matches!(
+        &call_expr.arguments[0],
+        oxc_ast::ast::Argument::StringLiteral(source) if is_node_builtin_module(source.value.as_str())
+    )
+}
+
+fn is_node_builtin_import_expression(
+    import_expression: &oxc_ast::ast::ImportExpression<'_>,
+) -> bool {
+    if import_expression.options.is_some() || import_expression.phase.is_some() {
+        return false;
+    }
+    matches!(
+        &import_expression.source,
+        Expression::StringLiteral(source) if is_node_builtin_module(source.value.as_str())
+    )
+}
+
+fn import_declaration_source<'a>(
+    declaration_id: NodeId,
+    ctx: &'a LintContext<'_>,
+) -> Option<&'a str> {
+    let AstKind::ImportDeclaration(import_declaration) = ctx.nodes().parent_kind(declaration_id)
+    else {
+        return None;
+    };
+    if import_declaration.import_kind != ImportOrExportKind::Value {
+        return None;
+    }
+    Some(import_declaration.source.value.as_str())
+}
+
+fn is_node_builtin_module(source: &str) -> bool {
+    let source = source.strip_prefix("node:").unwrap_or(source);
+    let module_name = if let Some((prefix, postfix)) = source.split_once('/') {
+        if postfix.is_empty() { source } else { prefix }
+    } else {
+        source
+    };
+    is_nodejs_builtin_module(module_name)
+}
