# Fuzzing artifacts
/packages/fuzz/forbidden-strings/artifacts/
/packages/fuzz/forbidden-strings/corpus/*/*
!/packages/fuzz/forbidden-strings/corpus/.keep
!/packages/fuzz/forbidden-strings/corpus/*/seed-*

# Claude Code plugin bundles. Marketplace distribution requires committed built files.
!/packages/claude-code-plugins/*/dist/
!/packages/claude-code-plugins/*/dist/final/
!/packages/claude-code-plugins/*/dist/final/*.js
!/packages/claude-code-plugins/*/dist/final/node/
!/packages/claude-code-plugins/*/dist/final/node/*.mjs
!/packages/claude-code-plugins/*/dist/final/node/*.d.mts

# Re-include files hidden by broader local or generated-output patterns.
!/forbidden-strings.local.example.txt
!/packages/cli/forbidden-strings/Cargo.lock
!/packages/cli/forbidden-strings/fuzz/Cargo.lock
