packages/dev-script/vm-builder/output/

# webapp-forge dev SQLite databases (default `./data/forge.db` from
# `data/db.ts`, picked up when running the server or seed CLI without
# `--db=` or `DB_PATH` overrides). Includes the WAL/SHM sidecars.
/data/
packages/webapp-forge/*/data/

